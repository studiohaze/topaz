import std.io

let limit = 100000
let mut composite: Array<bool> = [for i in 0..limit => false]
let mut candidate = 2
while candidate * candidate <= limit {
    if !composite[candidate] {
        let mut multiple = candidate * candidate
        while multiple <= limit {
            composite[multiple] = true
            multiple += candidate
        }
    }
    candidate += 1
}
let mut count = 0
let mut total = 0
for value in 2..limit {
    if !composite[value] {
        count += 1
        total += value
    }
}
io.writeLine("bench-v1:{count}:{total}")
