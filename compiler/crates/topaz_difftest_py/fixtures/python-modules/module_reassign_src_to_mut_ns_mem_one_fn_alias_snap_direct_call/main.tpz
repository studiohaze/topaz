
import util
function main() -> int {
    let mut first = util.plus
    let mut second = first
    let mut reserved = util.add
    let mut mutableReserved = reserved
    first = util.bump
    reserved = util.grow
    second(a: 5) + second(10, b: 3) + mutableReserved(a: 7) + mutableReserved(8, b: 4)
}
main()
