
import util
let mut first = util.spin
let mut second = first
let mut reserved = util.sortedBy
let mut mutableReserved = reserved
first = util.fast
reserved = util.otherSorted
concurrent {
    valueChain: {
        let xs = [1]
        xs.map(second)
    }
    reservedChain: {
        let ys = [1]
        ys.map(mutableReserved)
    }
    boom: {
        let zs = [1]
        zs[2]
    }
}
0
