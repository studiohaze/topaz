
import util
function main() -> int {
    let seeds = [1, 0]
    let f = if seeds[0] == 1 {
        util.sum
    } else {
        util.pack
    }
    let g = if seeds[1] == 1 {
        util.sum
    } else {
        util.pack
    }
    let a = 5 |> f(_, ...[1, 2])
    let b = 5 |> g(_, ...[1, 2])
    a * 1000 + b
}
main()
