
import util
function main() -> int {
    let seeds = [1, 0]
    let f = match seeds[0] {
        case n if n == 1 => util.add
        case _ => util.sub
    }
    let g = match seeds[1] {
        case n if n == 1 => util.add
        case _ => util.sub
    }
    let a = 5 |> f(a: _)
    let b = 5 |> g(a: _)
    a * 1000 + (b + 100)
}
main()
