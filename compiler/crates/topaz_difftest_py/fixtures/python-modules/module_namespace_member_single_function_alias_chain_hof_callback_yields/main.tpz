
import util
let first = util.spin
let second = first
let reserved = util.sortedBy
let chainedReserved = reserved
concurrent {
    valueChain: {
        let xs = [1]
        xs.map(second)
    }
    reservedChain: {
        let ys = [1]
        ys.map(chainedReserved)
    }
    boom: {
        let zs = [1]
        zs[2]
    }
}
0
