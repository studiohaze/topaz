
import util
function main() -> int {
    let mut first = util.plus
    let second = first
    let mut reserved = util.add
    let chainedReserved = reserved
    first = util.bump
    reserved = util.grow
    second(a: 5) + second(10, b: 3) + chainedReserved(a: 7) + chainedReserved(8, b: 4)
}
main()
