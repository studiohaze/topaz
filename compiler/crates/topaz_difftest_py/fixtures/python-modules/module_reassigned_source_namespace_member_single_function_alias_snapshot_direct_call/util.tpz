
function plusImpl(a: int, b: int = 2) -> int {
    a + b
}
function bumpImpl(a: int, b: int = 9) -> int {
    a * 10 + b
}
export let plus = plusImpl
export let bump = bumpImpl
export function add(a: int, b: int = 2) -> int {
    a + b
}
export function grow(a: int, b: int = 9) -> int {
    a * 10 + b
}
