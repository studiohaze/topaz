
function rank(x: int) -> int {
    let mut i = 0
    while i < 200 {
        i = i + 1
    }
    10 - x
}

let callbacks = map { "rank": rank }

let r = concurrent {
    slow: {
        let mut xs = [1, 3, 2]
        match callbacks.get("rank") {
            case Some(cb) => xs.sortBy(cb)
            case None => ()
        }
        xs[0] * 100 + xs[1] * 10 + xs[2]
    }
    fast: 0
}
r.slow + r.fast
