
function keep(key: string, value: int) -> bool {
    value > 1
}

function drop(key: string, value: int) -> bool {
    false
}

function choose(i: int) -> int {
    let r = concurrent {
        slow: {
            let mut cbs = [drop, drop]
            cbs[i] = keep
            let values = map { "a": 1, "b": 2, "c": 3 }
            let kept = values.filter(cbs[i])
            kept.getOr("a", 0) + kept.getOr("b", 0) + kept.getOr("c", 0)
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(1)
