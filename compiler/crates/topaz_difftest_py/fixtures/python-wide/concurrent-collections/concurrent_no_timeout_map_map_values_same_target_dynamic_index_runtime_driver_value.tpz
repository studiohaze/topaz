
function spin(x: int) -> int {
    x * 2
}

let seeds = [0, 1]
let i = seeds[1]
let callbacks = [spin, spin]

let r = concurrent {
    slow: {
        let values = map { "a": 1, "b": 2 }
        let mapped = values.mapValues(callbacks[i])
        mapped.getOr("a", 0) + mapped.getOr("b", 0)
    }
    fast: 0
}
r.slow + r.fast
