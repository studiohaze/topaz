
function quick(x: int) -> int {
    x
}

function spin(x: int) -> int {
    let mut i = 0
    while i < 200 {
        i = i + 1
    }
    1 / 0
}

let mut inner = { primary: spin }
let callbacks = { nested: inner }
inner.primary = quick

concurrent {
    slow: {
        let xs = [1]
        xs.map(callbacks.nested.primary)
    }
    boom: {
