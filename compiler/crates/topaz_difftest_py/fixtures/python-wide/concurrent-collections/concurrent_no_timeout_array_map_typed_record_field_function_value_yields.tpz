
function spin(x: int) -> int {
    let mut i = 0
    while i < 200 {
        i = i + 1
    }
    1 / 0
}

function drive(cb: { primary: (int) -> int }) -> int {
    concurrent {
        slow: {
            let xs = [1]
            xs.map(cb.primary)
        }
        boom: {
            let ys = [1]
            ys[2]
        }
    }
    0
}

drive({ primary: spin })
