
function keep(key: string, value: int) -> bool {
    value > 1
}

function small(key: string, value: int) -> bool {
    value < 3
}

function drop(key: string, value: int) -> bool {
    false
}

function choose(i: int) -> int {
    let r = concurrent {
        slow: {
            let mut cbs = [drop, small]
            let mut out = -9
            let mut n = 0
            while n < 1 {
                cbs[i] = keep
                let values = map { "a": 1, "b": 2, "c": 3 }
                let kept = values.filter(cbs[i])
                out = kept.getOr("a", 0) + kept.getOr("b", 0) + kept.getOr("c", 0)
                n = n + 1
            }
            out
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(1)
