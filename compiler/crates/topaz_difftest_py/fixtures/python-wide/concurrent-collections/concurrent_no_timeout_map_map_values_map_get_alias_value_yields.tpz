
function spin(x: int) -> int {
    let mut i = 0
    while i < 200 {
        i = i + 1
    }
    1 / 0
}

let aliasSpin = spin
let callbacks = map { "alias": aliasSpin }

concurrent {
    slow: {
        let values = map { "a": 1 }
        match callbacks.get("alias") {
            case Some(cb) => values.mapValues(cb)
            case None => values
        }
    }
    boom: {
        let ys = [1]
        ys[2]
    }
}
