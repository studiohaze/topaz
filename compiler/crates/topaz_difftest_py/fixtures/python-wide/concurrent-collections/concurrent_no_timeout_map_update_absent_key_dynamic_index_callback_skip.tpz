
function spin(x: int) -> int {
    x / 0
}

let seeds = [0, 1]
let i = seeds[1]
let callbacks = [spin, spin]

let r = concurrent {
    slow: {
        let mut values = map { "a": 1 }
        values.update("z", 7, callbacks[i])
        values.getOr("z", 0) + values.getOr("a", 0)
    }
    fast: 0
}
r.slow + r.fast
