
function rank(x: int) -> int {
    let mut i = 0
    while i < 200 {
        i = i + 1
    }
    10 - x
}

let aliasRank = rank
let callbacks = map { "alias": aliasRank }

let r = concurrent {
    slow: {
        let mut xs = [1, 3, 2]
        match callbacks.get("alias") {
            case Some(cb) => xs.sortBy(cb)
            case None => ()
        }
        xs[0] * 100 + xs[1] * 10 + xs[2]
    }
    fast: 0
}
r.slow + r.fast
