
function main() -> int {
    let a = match 5 {
        case n: int => n
        case _ => 0
    }
    let b = match "x" {
        case value: int | string => 6
        case _ => 0
    }
    let c = match true {
        case n: int => 100
        case flag: bool => 7
        case _ => 0
    }
    a + b + c
}
main()
