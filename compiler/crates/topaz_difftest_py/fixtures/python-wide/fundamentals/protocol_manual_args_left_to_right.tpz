protocol Sum { function sum(value: Self, a: int, b: int) -> int }
record P { x: int }
impl Sum<P> { function sum(value: P, a: int, b: int) -> int { value.x + a + b } }
function receiver() -> P { print("R")
P { x: 1 } }
function arg(label: string, value: int) -> int { print(label)
value }
print("{Sum.sum(receiver(), arg("A", 2), arg("B", 3))}")
0