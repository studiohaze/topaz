
function mark(label: string, xs: Array<int>) -> Array<int> {
    print(label)
    xs
}
function maybeInc(x: int) -> Option<int> { Some(x + 1) }
function main() -> string {
    let res: Option<Result<int, string>> = Some(Ok(1))
    maybeInc |> res?.flatMap(...mark("pipe-result-flat", [0]))
    "unreachable"
}
main()
