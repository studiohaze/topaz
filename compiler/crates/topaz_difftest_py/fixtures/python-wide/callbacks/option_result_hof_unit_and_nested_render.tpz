
function side(label: string) {
    print(label)
}
function main() -> string {
    let base: Result<int, string> = Ok(3)
    let a = Some(1).map((x) => side("option-map-unit"))
    let b = Some(2).flatMap((x) => None)
    let c = base.map((x) => side("result-map-unit"))
    let d = base.flatMap((x) => Err("bad"))
    "{a}|{b}|{c}|{d}"
}
main()
