
function sum(seed: int, ...xs: int) -> int {
    let mut total = seed
    for x in xs {
        total = total + x
    }
    total
}
function sumDefault(seed: int = 0, ...xs: int) -> int {
    let mut total = seed
    for x in xs {
        total = total + x
    }
    total
}
function main() -> int {
    let callbacks = [sum]
    let handlers = { total: sumDefault, strict: sum }
    callbacks[0](10, ...[1, 2], 3) + handlers.total(...[4, 5], seed: 6) + handlers.strict(7, 8, 9)
}
main()
