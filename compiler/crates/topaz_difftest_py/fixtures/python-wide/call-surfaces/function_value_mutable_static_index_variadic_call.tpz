
function sum(seed: int, ...xs: int) -> int {
    let mut total = seed
    for x in xs {
        total = total + x
    }
    total
}
function scale(seed: int, ...xs: int) -> int {
    let mut total = seed * 2
    for x in xs {
        total = total + x * 2
    }
    total
}
function main() -> int {
    let mut callbacks = [sum]
    let before = callbacks[0](1, 2, 3)
    callbacks[0] = scale
    let after = callbacks[0](1, 2, 3)
    before * 10 + after
}
main()
