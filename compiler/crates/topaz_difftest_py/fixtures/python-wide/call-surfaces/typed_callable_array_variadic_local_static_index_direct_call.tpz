
type CallbackArray = Array<(int, ...int) -> int>

function sum(seed: int = 0, ...xs: int) -> int {
    let mut total = seed
    for x in xs {
        total = total + x
    }
    total
}
function call(source: CallbackArray) -> int {
    let callbacks: CallbackArray = source
    callbacks[0](20, ...[5, 6])
}
function main() -> int {
    call([sum])
}
main()
