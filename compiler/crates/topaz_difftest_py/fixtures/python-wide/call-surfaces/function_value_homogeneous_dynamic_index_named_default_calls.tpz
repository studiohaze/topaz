
function add(a: int, b: int = 2, c: int = 4) -> int {
    a + b + c
}
function sub(a: int, b: int = 10, c: int = 20) -> int {
    a - b - c
}
function main() -> int {
    let seeds = [0, 1]
    let i = seeds[1]
    let j = seeds[0]
    let callbacks = [sub, add]
    callbacks[i](c: 5, a: 1) + callbacks[i](2) + callbacks[j](c: 5, a: 1) + callbacks[j](2)
}
main()
