
function addDefault(a: int, b: int = 2) -> int {
    a + b
}
function subDefault(a: int, b: int = 2) -> int {
    a - b
}
function main() -> int {
    let mut callbacks = [addDefault]
    let before = callbacks[0](a: 5)
    callbacks[0] = subDefault
    let after = callbacks[0](a: 5)
    before * 10 + after
}
main()
