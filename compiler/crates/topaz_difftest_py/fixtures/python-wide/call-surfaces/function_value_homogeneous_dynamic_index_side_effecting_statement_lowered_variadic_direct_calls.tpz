
function main() -> int {
    let mut order = 0

    function tick(label: int, value: int) -> int {
        order = order * 10 + label
        value
    }

    function pack(label: int, a: int, b: int) -> Array<int> {
        order = order * 10 + label
        [a, b]
    }

    function sum(seed: int = 0, ...xs: int) -> int {
        order = order * 10 + 3
        let mut total = seed
        for x in xs {
            total = total + x
        }
        total
    }

    let callbacks = [sum, sum]
    let value = callbacks[tick(1, 1)](...loop {
        break pack(2, 5, 6)
    }, seed: 7)
    print("{order}")
    order * 100 + value
}
main()
