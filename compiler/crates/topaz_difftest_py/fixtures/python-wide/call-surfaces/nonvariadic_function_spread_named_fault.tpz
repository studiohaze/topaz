
function f(a: int, b: int = 0) -> int {
    a + b
}
function markArray(label: string, xs: Array<int>) -> Array<int> {
    print(label)
    xs
}
function markInt(label: string, value: int) -> int {
    print(label)
    value
}
function main() -> int {
    f(...markArray("spread", [1]), b: markInt("named", 2))
}
main()
