
function main() -> int {
    let mut order = 0

    function tick(label: int, value: int) -> int {
        order = order * 10 + label
        value
    }

    function pack(label: int, a: int, b: int) -> Array<int> {
        order = order * 10 + label
        [a, b]
    }

    function sum(seed: int = 0, ...xs: int) -> int {
        order = order * 10 + 4
        let mut total = seed
        for x in xs {
            total = total + x
        }
        total
    }

    let callbacks = [sum, sum]
    let value = loop {
        break tick(1, 1)
    } |> callbacks[tick(2, 1)](...pack(3, 5, 6), seed: _)
    order * 100 + value
}
main()
