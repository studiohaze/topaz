
function keep(x: int) -> bool {
    x > 2
}

function all(x: int) -> bool {
    x > 0
}

let seeds = [0, 1]
let i = seeds[1]
let callbacks = [all, keep]

let r = concurrent {
    slow: {
        let xs = [1, 2, 3, 4]
        let out = xs.filter(callbacks[i])
        out.length * 10 + out[0]
    }
    fast: 0
}
r.slow + r.fast
