
function dbl(x: int) -> int {
    x * 2
}

function inc(x: int) -> int {
    x + 1
}

function zero(x: int) -> int {
    0
}

function choose(i: int) -> int {
    let r = concurrent {
        slow: {
            let mut cbs = [zero, inc]
            let mut total = 0
            let mut n = 0
            while n < 1 {
                cbs[i] = dbl
                let xs = [1, 2, 3]
                let out = xs.map(cbs[i])
                total = out[0] + out[1] + out[2]
                n = n + 1
            }
            total
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(1)
