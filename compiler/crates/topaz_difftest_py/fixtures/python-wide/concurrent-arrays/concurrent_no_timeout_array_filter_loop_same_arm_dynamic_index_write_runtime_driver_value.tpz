
function keep(x: int) -> bool {
    x > 2
}

function moreThanOne(x: int) -> bool {
    x > 1
}

function all(x: int) -> bool {
    x > 0
}

function choose(i: int) -> int {
    let r = concurrent {
        slow: {
            let mut cbs = [all, moreThanOne]
            loop {
                cbs[i] = keep
                let xs = [1, 2, 3, 4]
                let out = xs.filter(cbs[i])
                break out.length * 100 + out[0]
            }
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(1)
