
function spin(x: int) -> int {
    1 / 0
}

function quick(x: int) -> int {
    x * 10
}

let mut callbacks = [spin]
let mut i = 0
while i < 1 {
    callbacks[0] = quick
    i = i + 1
}

let result = concurrent {
    value: {
        let xs = [1, 2, 3]
        let ys = xs.map(callbacks[0])
        ys[0] + ys[1] + ys[2]
    }
    idle: 0
}
result.value + result.idle
