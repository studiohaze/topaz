
function boom(x: int) -> Result<int, int> {
    let n = 0
    Ok(x / n)
}

function okSame(x: int) -> Result<int, int> {
    Ok(x)
}

function makeHolder(value: Result<int, int>) {
    { res: value }
}

function main() -> int {
    let mut order = 0

    function tick(label: int, value: int) -> int {
        order = order * 10 + label
        value
    }

    let r = concurrent {
        slow: {
            let mut cbs = [okSame, okSame]
            let i = 1
            cbs[i] = boom
            let values: Array<Result<int, int>> = [Ok(1), Err(7)]
            let out = makeHolder(values[tick(1, i)]).res.flatMap(cbs[tick(2, i)])
            let payload = match out {
                case Ok(_) => -1
                case Err(code) => code
            }
            order * 100 + payload
        }
        fast: 0
    }
    r.slow + r.fast
}

main()
