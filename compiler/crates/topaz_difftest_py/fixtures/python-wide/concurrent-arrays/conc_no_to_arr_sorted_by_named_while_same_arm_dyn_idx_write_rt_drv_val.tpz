
function midKey(x: int) -> int {
    3 * x * x - 13 * x + 16
}

function negKey(x: int) -> int {
    0 - x
}

function idKey(x: int) -> int {
    x
}

function choose(i: int) -> int {
    let r = concurrent {
        slow: {
            let mut cbs = [idKey, negKey]
            let mut out = -9
            let mut n = 0
            while n < 1 {
                cbs[i] = midKey
                let xs = [3, 1, 2]
                let sorted = xs.sortedBy(f: cbs[i])
                out = sorted[0] * 10 + sorted[1]
                n = n + 1
            }
            out
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(1)
