// Public type-checking facade for the embedded self compiler.
// Checker leaves own formation and inference; this file wires their services,
// runs the phases in order, and exposes only check to the package entry.

import types {
  CheckResult,
  PreviewTypedCall,
  PreviewTypedCapture,
  PreviewTypedNode,
  ResolveResult,
  SyntaxNode,
}
import checker.model {
  CheckerRequest,
  CheckerResponse,
  CheckerService,
  CheckerState,
  ModuleSyntax,
  emptyType,
}
import checker.type_algebra {
  flattenedHasHole,
  resolvedFlatType,
  stringJoin,
}
import checker.syntax_index {
  addDiagnostic,
  child,
  children,
  moduleSyntax,
  text,
}
import checker.nominals {
  collectProtocols,
  fillNominals,
  predeclareNominals,
}
import checker.protocols_methods {
  collectProtocolImpls,
  collectReceiverImpls,
  predeclareFunctions,
}
import checker.members_capabilities { gateCollectionKey }
import checker.diagnostics_derives { checkDerives }
import checker.call_facts {
  builtinNamespaceObject,
  diagnoseUnboundReferences,
}
import checker.expression_control { inferExpression }
import checker.statements {
  checkBlock,
  checkBlockExpected,
}
import checker.bodies_captures {
  checkFunctionBodies,
  checkerIndexes,
  deriveCaptures,
  diagnoseLispexRuleFactoryEscapes,
  initialCheckerState,
}

function dispatchCheckerService(
  state: CheckerState,
  request: CheckerRequest,
) -> CheckerResponse {
  match request.kind {
    case "infer-expression" => CheckerResponse {
      typeValue: inferExpression(
        dispatchCheckerService,
        state,
        request.moduleIndex,
        request.source,
        request.node,
      ),
      boolValue: false,
    }
    case "builtin-namespace-object" => CheckerResponse {
      typeValue: emptyType("unknown"),
      boolValue: builtinNamespaceObject(
        dispatchCheckerService,
        state,
        request.moduleIndex,
        request.source,
        request.node,
      ),
    }
    case "check-block" => CheckerResponse {
      typeValue: checkBlock(
        dispatchCheckerService,
        state,
        request.moduleIndex,
        request.source,
        request.node,
      ),
      boolValue: false,
    }
    case "check-block-expected" => CheckerResponse {
      typeValue: checkBlockExpected(
        dispatchCheckerService,
        state,
        request.moduleIndex,
        request.source,
        request.node,
        request.typeValue,
      ),
      boolValue: false,
    }
    case "gate-collection-key" => {
      gateCollectionKey(
        dispatchCheckerService,
        state,
        request.moduleIndex,
        request.node,
        request.typeValue,
      )
      CheckerResponse { typeValue: emptyType("unknown"), boolValue: false }
    }
    case _ => CheckerResponse { typeValue: emptyType("unknown"), boolValue: false }
  }
}

function checkerService() -> CheckerService {
  dispatchCheckerService
}

function runCheckerPhases(service: CheckerService, state: CheckerState) -> () {
  predeclareNominals(state)
  fillNominals(service, state)
  collectProtocols(service, state)
  collectReceiverImpls(service, state)
  collectProtocolImpls(service, state)
  checkDerives(state)
  predeclareFunctions(service, state)
  diagnoseUnboundReferences(state)
  checkFunctionBodies(service, state)
  diagnoseLispexRuleFactoryEscapes(state)
  deriveCaptures(state)
  ()
}

function checkerResult(state: CheckerState) -> CheckResult {
  let mut nodes: Array<PreviewTypedNode> = []
  for node in state.nodes {
    let resolved = resolvedFlatType(node.typeValue, state.inferenceSolutions)
    nodes.push(PreviewTypedNode {
      ...node,
      typeValue: resolved,
      ambient: flattenedHasHole(resolved),
    })
  }
  let mut calls: Array<PreviewTypedCall> = []
  for call in state.calls {
    let calleeType = resolvedFlatType(call.calleeType, state.inferenceSolutions)
    let resultType = resolvedFlatType(call.resultType, state.inferenceSolutions)
    calls.push(PreviewTypedCall {
      ...call,
      calleeType: calleeType,
      resultType: resultType,
      ambient: flattenedHasHole(calleeType) || flattenedHasHole(resultType),
    })
  }
  let mut captures: Array<PreviewTypedCapture> = []
  for capture in state.captures {
    let resolved = resolvedFlatType(capture.typeValue, state.inferenceSolutions)
    captures.push(PreviewTypedCapture {
      ...capture,
      typeValue: resolved,
      ambient: flattenedHasHole(resolved),
    })
  }
  CheckResult {
    nodes: nodes,
    calls: calls,
    captures: captures,
    diagnostics: state.diagnostics,
  }
}

function externReplayError(
  modules: Array<string>,
  errors: Array<string>,
  target: string,
) -> Option<string> {
  let mut index = 0
  for module in modules {
    if module == target {
      return errors.get(index)
    }
    index += 1
  }
  None
}

function diagnoseExternReplayImport(
  state: CheckerState,
  module: ModuleSyntax,
  statement: SyntaxNode,
  externReplayModules: Array<string>,
  externReplayErrors: Array<string>,
) -> () {
  let item = match child(statement, "import") {
    case Some(value) => value
    case None => return ()
  }
  let path = match child(item, "path") {
    case Some(value) => value
    case None => return ()
  }
  let mut segments: Array<string> = []
  for segment in children(path, "segments") {
    segments.push(text(module.source, segment))
  }
  let target = stringJoin(segments, ".")
  match externReplayError(
    externReplayModules,
    externReplayErrors,
    target,
  ) {
    case Some(error) => addDiagnostic(
      state,
      module.moduleIndex,
      "TPZ5032",
      "extern module `{target}` has an invalid deterministic replay binding: {error}",
      "",
      path,
    )
    case None => ()
  }
}

function diagnoseExternReplayErrors(
  state: CheckerState,
  externReplayModules: Array<string>,
  externReplayErrors: Array<string>,
) -> Result<(), string> {
  if externReplayModules.length != externReplayErrors.length {
    return Err("checker extern replay fact columns differ in length")
  }
  for module in state.modules {
    for statement in module.root.children {
      if statement.kind == "statement/import" {
        diagnoseExternReplayImport(
          state,
          module,
          statement,
          externReplayModules,
          externReplayErrors,
        )
      }
    }
  }
  Ok(())
}

// Runs formation and body phases, preserving diagnostic and observation order.
export function check(
  resolved: ResolveResult,
  externReplayModules: Array<string>,
  externReplayErrors: Array<string>,
  maxAstNodes: int,
  maxAstDepth: int,
) -> Result<CheckResult, string> {
  let service = checkerService()
  let modules = moduleSyntax(resolved, maxAstNodes, maxAstDepth)?
  let state = initialCheckerState(resolved, modules, checkerIndexes(resolved))
  diagnoseExternReplayErrors(state, externReplayModules, externReplayErrors)?
  runCheckerPhases(service, state)
  Ok(checkerResult(state))
}
