import checker { check }
import emitter { emitStep }
import layout { normalize }
import lowering { lowerStep }
import parser { parse }
import profile { checkProfile }
import raw { lex }
import resolver { resolvePreview }
import stage1_types { STAGE1_EXCHANGE_SCHEMA }
import types {
  CheckResult,
  LowerBridgeRequest,
  encodeLowerBridgeRequest,
  LayoutResult,
  ParseResult,
  PreviewAstNode,
  PreviewCallArgument,
  PreviewCallEvaluation,
  PreviewCheckLabel,
  PreviewDiagnostic,
  PreviewDirectoryEntry,
  PreviewGeneratedStdModule,
  PreviewHostFact,
  PreviewHostQuery,
  PreviewImportEdge,
  PreviewModuleResult,
  PreviewResolvedDeclaration,
  PreviewResolvedDiagnostic,
  PreviewResolvedExport,
  PreviewResolvedReference,
  PreviewResolvedScope,
  PreviewToken,
  PreviewTypeAtom,
  PreviewTypedCall,
  PreviewTypedCapture,
  PreviewTypedNode,
  PreviewCheckDiagnostic,
  RawResult,
  ResolveResult,
}

const EXCHANGE_SCHEMA = "topaz.compiler.frontend-preview-exchange/v1"

record RequestPackageFacts derives JSON {
  buildRole: string,
  externModules: Array<string>,
  externReplayModules: Array<string>,
  externReplayErrors: Array<string>,
  generatedStdModules: Array<PreviewGeneratedStdModule>,
}

record PreviewRequest derives JSON {
  schema: string,
  terminal: string,
  entry: string,
  root: string,
  source: string,
  sourceId: string,
  facts: Array<PreviewHostFact>,
  package: RequestPackageFacts,
  maxAstNodes: int,
  maxAstDepth: int,
}

record PreviewResponse derives JSON {
  schema: string,
  status: string,
  sourceId: string,
  raw: Array<PreviewToken>,
  layout: Array<PreviewToken>,
  ast: Array<PreviewAstNode>,
  diagnostics: Array<PreviewDiagnostic>,
  queries: Array<PreviewHostQuery>,
  modules: Array<PreviewModuleResult>,
  edges: Array<PreviewImportEdge>,
  scopes: Array<PreviewResolvedScope>,
  declarations: Array<PreviewResolvedDeclaration>,
  references: Array<PreviewResolvedReference>,
  exports: Array<PreviewResolvedExport>,
  resolverDiagnostics: Array<PreviewResolvedDiagnostic>,
  typedNodes: Array<PreviewTypedNode>,
  typedCalls: Array<PreviewTypedCall>,
  typedCaptures: Array<PreviewTypedCapture>,
  checkerDiagnostics: Array<PreviewCheckDiagnostic>,
}

record Stage1Request derives JSON {
  schema: string,
  producer: string,
  compilerSourceSetId: string,
  terminal: string,
  entry: string,
  root: string,
  source: string,
  sourceId: string,
  languageMode: string,
  profile: string,
  facts: Array<PreviewHostFact>,
  package: RequestPackageFacts,
  maxSourceFacts: int,
  maxTotalSourceBytes: int,
  maxAstNodes: int,
  maxAstDepth: int,
  maxRawTokens: int,
  maxLayoutTokens: int,
  maxHirNodes: int,
  maxLoweredNodes: int,
  maxDiagnostics: int,
  maxGeneratedRustBytes: int,
  maxFactRounds: int,
}

record SyntaxPreview {
  ast: Array<PreviewAstNode>,
  diagnostics: Array<PreviewDiagnostic>,
}

function emptyCheckResult() -> CheckResult {
  CheckResult { nodes: [], calls: [], captures: [], diagnostics: [] }
}

function resolveRequest(request: PreviewRequest) -> Result<ResolveResult, string> {
  resolvePreview(
    request.entry,
    request.root,
    request.facts,
    request.package.externModules,
    request.package.generatedStdModules,
    request.maxAstNodes,
    request.maxAstDepth,
  )
}

function checkResolvedRequest(
  request: PreviewRequest,
  resolved: ResolveResult,
) -> Result<CheckResult, string> {
  if request.terminal == "typed" &&
    resolved.queries.length == 0 && resolved.diagnostics.length == 0 {
    check(
      resolved,
      request.package.externReplayModules,
      request.package.externReplayErrors,
      request.maxAstNodes,
      request.maxAstDepth,
    )
  } else {
    Ok(emptyCheckResult())
  }
}

function resolvedStatus(resolved: ResolveResult, checked: CheckResult) -> string {
  if resolved.queries.length > 0 {
    "need-facts"
  } else if resolved.diagnostics.length > 0 || checked.diagnostics.length > 0 {
    "rejected"
  } else {
    "completed"
  }
}

function resolvedResponse(
  request: PreviewRequest,
  resolved: ResolveResult,
  checked: CheckResult,
) -> PreviewResponse {
  PreviewResponse {
    schema: EXCHANGE_SCHEMA,
    status: resolvedStatus(resolved, checked),
    sourceId: request.sourceId,
    raw: [],
    layout: [],
    ast: [],
    diagnostics: [],
    queries: resolved.queries,
    modules: resolved.modules,
    edges: resolved.edges,
    scopes: resolved.scopes,
    declarations: resolved.declarations,
    references: resolved.references,
    exports: resolved.exports,
    resolverDiagnostics: resolved.diagnostics,
    typedNodes: checked.nodes,
    typedCalls: checked.calls,
    typedCaptures: checked.captures,
    checkerDiagnostics: checked.diagnostics,
  }
}

function processResolvedRequest(request: PreviewRequest) -> Result<PreviewResponse, string> {
  let resolved = resolveRequest(request)?
  let checked = checkResolvedRequest(request, resolved)?
  Ok(resolvedResponse(request, resolved, checked))
}

function parseSyntax(
  request: PreviewRequest,
  raw: RawResult,
  layout: LayoutResult,
) -> Result<SyntaxPreview, string> {
  let mut diagnostics = raw.diagnostics
  for found in layout.diagnostics {
    diagnostics.push(found)
  }
  let mut ast: Array<PreviewAstNode> = []
  if diagnostics.length == 0 {
    let parsed = parse(
      layout.tokens,
      request.source,
      request.maxAstNodes,
      request.maxAstDepth,
    )?
    ast = parsed.nodes
    for found in parsed.diagnostics {
      diagnostics.push(found)
    }
  }
  Ok(SyntaxPreview { ast: ast, diagnostics: diagnostics })
}

function syntaxResponse(
  request: PreviewRequest,
  raw: RawResult,
  layout: LayoutResult,
  syntax: SyntaxPreview,
) -> PreviewResponse {
  PreviewResponse {
    schema: EXCHANGE_SCHEMA,
    status: if syntax.diagnostics.length == 0 { "completed" } else { "rejected" },
    sourceId: request.sourceId,
    raw: raw.tokens,
    layout: layout.tokens,
    ast: syntax.ast,
    diagnostics: syntax.diagnostics,
    queries: [],
    modules: [],
    edges: [],
    scopes: [],
    declarations: [],
    references: [],
    exports: [],
    resolverDiagnostics: [],
    typedNodes: [],
    typedCalls: [],
    typedCaptures: [],
    checkerDiagnostics: [],
  }
}

function processSyntaxRequest(request: PreviewRequest) -> Result<PreviewResponse, string> {
  let raw = lex(request.source)
  let layout = normalize(raw.tokens, request.source)
  let syntax = parseSyntax(request, raw, layout)?
  Ok(syntaxResponse(request, raw, layout, syntax))
}

function process(request: PreviewRequest) -> Result<PreviewResponse, string> {
  if request.schema != EXCHANGE_SCHEMA {
    return Err("unsupported front-end preview exchange schema")
  }
  if request.terminal == "resolved" || request.terminal == "typed" {
    processResolvedRequest(request)
  } else if request.terminal == "ast" {
    processSyntaxRequest(request)
  } else {
    Err("unsupported front-end preview terminal `{request.terminal}`")
  }
}

export function frontEndStep(request: Bytes) -> Result<Bytes, string> {
  let text = request.decodeUtf8()?
  let decoded = JSON.parseAs<PreviewRequest>(text)?
  let response = process(decoded)?
  let encoded = JSON.stringify(response)?
  Ok(Bytes.encodeUtf8(encoded))
}

function supportsSelfHostedLanguage(mode: string) -> bool {
  mode == "topaz-5.16" ||
    mode == "topaz-5.17" ||
    mode == "topaz-5.18" ||
    mode == "topaz-5.19" ||
    mode == "topaz-5.20"
}

function validateStage1Request(request: Stage1Request) -> Result<int, string> {
  if request.schema != STAGE1_EXCHANGE_SCHEMA {
    return Err("unsupported Stage 1 exchange schema")
  }
  let producerStage = if request.producer == "topaz-stage1" {
    1
  } else if request.producer == "topaz-stage2" {
    2
  } else {
    return Err("unsupported compiler producer")
  }
  if request.terminal != "lowered" && request.terminal != "rust-source" {
    return Err("Stage 1 supports only lowered and rust-source terminals")
  }
  if !supportsSelfHostedLanguage(request.languageMode) {
    return Err("unsupported self-hosted language mode `{request.languageMode}`")
  }
  if request.maxFactRounds < 1 {
    return Err("Stage 1 fact-round budget must be positive")
  }
  Ok(producerStage)
}

function stage1PreviewRequest(request: Stage1Request) -> PreviewRequest {
  PreviewRequest {
    schema: EXCHANGE_SCHEMA,
    terminal: "typed",
    entry: request.entry,
    root: request.root,
    source: "",
    sourceId: "",
    facts: request.facts,
    package: request.package,
    maxAstNodes: request.maxAstNodes,
    maxAstDepth: request.maxAstDepth,
  }
}

function applyCompilerProfile(
  profile: string,
  base: PreviewResponse,
) -> Result<PreviewResponse, string> {
  let mut checkerDiagnostics = base.checkerDiagnostics
  if base.queries.length == 0 {
    for diagnostic in checkProfile(
      profile,
      base.modules,
      base.references,
      base.typedNodes,
      base.typedCalls,
      base.typedCaptures,
    )? {
      checkerDiagnostics.push(diagnostic)
    }
  }
  Ok(PreviewResponse {
    ...base,
    status: if base.status == "completed" && checkerDiagnostics.length > 0 {
      "rejected"
    } else {
      base.status
    },
    checkerDiagnostics: checkerDiagnostics,
  })
}

function lowerBridgeRequest(
  request: Stage1Request,
  producerStage: int,
  frontEnd: PreviewResponse,
) -> Result<Bytes, string> {
  encodeLowerBridgeRequest(LowerBridgeRequest {
    producer: request.producer,
    producerStage: producerStage,
    frontEnd: JSON.stringify(frontEnd)?,
    frontEndStatus: frontEnd.status,
    modules: frontEnd.modules,
    references: frontEnd.references,
    typedNodes: frontEnd.typedNodes,
    typedCalls: frontEnd.typedCalls,
    typedCaptures: frontEnd.typedCaptures,
    sourceSetId: request.compilerSourceSetId,
    maxLoweredNodes: request.maxLoweredNodes,
  })
}

function finishCompilerRequest(
  request: Stage1Request,
  lowered: Bytes,
) -> Result<Bytes, string> {
  if request.terminal == "rust-source" {
    emitStep(lowered, request.maxGeneratedRustBytes)
  } else {
    Ok(lowered)
  }
}

export function compilerStep(input: Bytes) -> Result<Bytes, string> {
  let text = input.decodeUtf8()?
  let decoded = JSON.parseAs<Stage1Request>(text)?
  let producerStage = validateStage1Request(decoded)?
  let baseFrontEnd = process(stage1PreviewRequest(decoded))?
  let frontEnd = applyCompilerProfile(decoded.profile, baseFrontEnd)?
  let bridge = lowerBridgeRequest(decoded, producerStage, frontEnd)?
  let lowered = lowerStep(bridge)?
  finishCompilerRequest(decoded, lowered)
}
