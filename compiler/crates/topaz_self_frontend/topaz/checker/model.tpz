  }
}

export function rigid(name: string, origin: string) -> TypeValue {
  TypeValue {
    kind: "rigid",
    name: name,
    value: "",
    identity: "",
    origin: origin,
    arguments: [],
    members: [],
    fieldNames: [],
    fields: [],
    parameters: [],
    variadic: [],
    result: [],
  }
}

export function structural(fieldNames: Array<string>, fields: Array<TypeValue>) -> TypeValue {
  let mut orderedNames: Array<string> = []
  let mut orderedFields: Array<TypeValue> = []
  let mut sourceIndex = 0
  for name in fieldNames {
    let field = match fields.get(sourceIndex) {
      case Some(found) => found
      case None => emptyType("unknown")
    }
    let mut inserted = false
    let mut index = 0
    while index < orderedNames.length {
      let existing = match orderedNames.get(index) {
        case Some(found) => found
        case None => name
      }
      if name < existing {
        orderedNames.insert(index, name)
        orderedFields.insert(index, field)
        inserted = true
        break
      }
      index += 1
    }
    if !inserted {
      orderedNames.push(name)
      orderedFields.push(field)
    }
    sourceIndex += 1
  }
  TypeValue {
    kind: "record",
    name: "",
    value: "",
    identity: "",
    origin: "",
    arguments: [],
    members: [],
    fieldNames: orderedNames,
    fields: orderedFields,
    parameters: [],
    variadic: [],
    result: [],
  }
}
