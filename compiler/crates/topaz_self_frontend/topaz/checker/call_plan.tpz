import checker.builtin_signatures { builtinNamespaceFamily, defaultedCallSignature, requiredCallSignature, positionalOnlyCallSignature, staticBuiltinDataCallSignature, builtinReceiverCallSignature }
// Call-target selection and named, default, variadic, and spread planning.
// Plans describe slot ownership only; call_complete performs inference and the
// checker facade records the resulting typed call.

import types { SyntaxNode }
import checker_types { TypeValue }
import checker.model {
  CallArgumentPlan,
  CallSignature,
  CheckerService,
  CheckerState,
  FunctionDefinition,
  TypeBinding,
  UserProtocolCallTarget,
  constructor,
  emptyType,
  literal,
  primitive,
  lengthUnit,
  rigid,
  serviceInferExpression,
}
import checker.syntax_index {
  addDiagnostic,
  addNode,
  child,
  children,
  protocolMethodDefinition,
  text,
}
import checker.nominals { formType }
import checker.type_algebra { flattenType }
import checker.protocols_methods {
  builtinProtocolDefinition,
  enumDefinitionForType,
  nominalTypeHead,
  receiverMethodCallSignature,
  referenceTargetType,
}
import checker.members_capabilities {
  bindTypeVariable,
  builtinNamespaceMemberType,
  typeArgument,
}
import checker.call_facts {
  builtinCallTypeParameters,
  boundBuiltinForCallee,
  canonicalBoundaryTarget,
  builtinFunction,
  builtinNamespaceObject,
  recordInferredExpression,
  userProtocolObject,
}
import checker.expression_core {
  contextualMemberObjectType,
  inferIdentifierExpression,
  inferOptionalMemberAccess,
  inferPlainMemberAccess,
  optionalReceiver,
}

export function nominalConstructorCallResult(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
) -> Option<TypeValue> {
  if callee.kind == "expression/identifier" {
    match referenceTargetType(state, moduleIndex, callee) {
      case Some(found) => if found.kind == "newtype" {
        return Some(found)
      }
      case None => ()
    }
  }
  if callee.kind == "expression/member" {
    let object = match child(callee, "object") {
      case Some(found) => found
      case None => return None
    }
    let field = match child(callee, "field") {
      case Some(found) => text(source, found)
      case None => return None
    }
    if !nominalTypeHead(state, moduleIndex, object) { return None }
    let enumType = match referenceTargetType(
      state,
      moduleIndex,
      object,
    ) {
      case Some(found) => found
      case None => return None
    }
    match enumDefinitionForType(state, moduleIndex, enumType) {
      case Some(definition) => for variant in definition.variants {
        if variant.name == field && variant.payloads.length > 0 {
          return Some(enumType)
        }
      }
      case None => ()
    }
  }
  None
}

export function declaredCallSignature(
  definition: FunctionDefinition,
) -> CallSignature {
  CallSignature {
    parameterNames: definition.parameterNames,
    parameterDefaults: definition.parameterDefaults,
    parameterCount: definition.parameterTypes.length,
    variadic: definition.variadic.length > 0,
    positionalOnlyIdentity: "",
  }
}

function staticBuiltinCallSignature(namespace: string, name: string) -> Option<CallSignature> {
  if builtinNamespaceFamily(namespace) != "protocol" { return staticBuiltinDataCallSignature(namespace, name) }
  match builtinProtocolDefinition(namespace) {
    case Some(definition) => match protocolMethodDefinition(definition, name) {
      case Some(method) => {
        let signature = requiredCallSignature(method.parameterNames, false)
        Some(CallSignature { ...signature, positionalOnlyIdentity: "{namespace}.{name}" })
      }
      case None => None
    }
    case None => None
  }
}

export function userProtocolCallTarget(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
) -> Option<UserProtocolCallTarget> {
  if callee.kind != "expression/member" {
    return None
  }
  let object = match child(callee, "object") {
    case Some(found) => found
    case None => return None
  }
  let field = match child(callee, "field") {
    case Some(found) => text(source, found)
    case None => return None
  }
  let definition = match userProtocolObject(state, moduleIndex, source, object) {
    case Some(found) => Some(found)
    case None => if builtinNamespaceObject(service, state, moduleIndex, source, object) {
      builtinProtocolDefinition(text(source, object))
    } else {
      None
    }
  }
  match definition {
    case Some(definition) => match protocolMethodDefinition(definition, field) {
      case Some(method) => Some(UserProtocolCallTarget {
        protocolName: definition.name,
        method: method,
      })
      case None => None
    }
    case None => None
  }
}

export function userProtocolCallSignature(
  target: UserProtocolCallTarget,
) -> CallSignature {
  positionalOnlyCallSignature(
    "{target.protocolName}.{target.method.name}",
    target.method.parameterNames,
  )
}

export function builtinMemberCallSignature(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  call: SyntaxNode,
  callee: SyntaxNode,
) -> Option<CallSignature> {
  if callee.kind != "expression/member" &&
    callee.kind != "expression/optional-access" {
    return None
  }
  let object = match child(callee, "object") {
    case Some(found) => found
    case None => return None
  }
  let field = match child(callee, "field") {
    case Some(found) => found
    case None => return None
  }
  match userProtocolObject(state, moduleIndex, source, object) {
    case Some(_) => return None
    case None => ()
  }
  if builtinNamespaceObject(service, state, moduleIndex, source, object) {
    return staticBuiltinCallSignature(
      text(source, object),
      text(source, field),
    )
  }
  let objectType = serviceInferExpression(service, state, moduleIndex, source, object)
  let receiverType = if callee.kind == "expression/optional-access" {
    match optionalReceiver(contextualMemberObjectType(
      state,
      call,
      objectType,
    )) {
      case Some(receiver) => receiver.innerType
      case None => emptyType("unknown")
    }
  } else {
    objectType
  }
  match receiverMethodCallSignature(
    state,
    moduleIndex,
    receiverType,
    text(source, field),
  ) {
    case Some(signature) => Some(signature)
    case None => builtinReceiverCallSignature(receiverType, text(source, field), state.languageMode)
  }
}

function callParameterIndex(
  signature: CallSignature,
  name: string,
) -> int {
  let mut index = 0
  while index < signature.parameterCount {
    match signature.parameterNames.get(index) {
      case Some(parameterName) => if parameterName == name {
        return index
      }
      case None => ()
    }
    index += 1
  }
  -1
}

function reportNamedCallArity(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  signature: CallSignature,
  filled: Array<bool>,
  leadingSlot: int,
  supplied: int,
  overflow: int,
) -> () {
  let mut required = 0
  let mut missing = false
  let mut index = 0
  while index < signature.parameterCount {
    let defaulted = match signature.parameterDefaults.get(index) {
      case Some(value) => value
      case None => false
    }
    let present = match filled.get(index) {
      case Some(value) => value
      case None => false
    }
    if !defaulted {
      required += 1
      if !present {
        missing = true
      }
    }
    index += 1
  }
  if overflow > 0 || missing {
    if signature.positionalOnlyIdentity != "" {
      let noun = if required == 1 { "argument" } else { "arguments" }
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "`{signature.positionalOnlyIdentity}` takes {required} {noun}, found {supplied}",
        "",
        node,
      )
    } else if leadingSlot == -2 {
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "the pipeline inserts the piped value, but this function takes no parameters",
        "",
        node,
      )
    } else {
      let optional = signature.variadic || signature.parameterCount > required
      let suffix = if optional { "+" } else { "" }
      let noun = if required == 1 { "argument" } else { "arguments" }
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "this call needs {required}{suffix} {noun}, found {supplied}",
        "",
        node,
      )
    }
  }
  ()
}

record NamedCallPlan {
  slots: Array<int>,
  filled: Array<bool>,
  positional: int,
  sawNamed: bool,
  sawSpread: bool,
  overflow: int,
  leadingSlot: int,
  invalid: bool,
}

function emptyNamedCallPlan(
  signature: CallSignature,
  hasLeading: bool,
) -> NamedCallPlan {
  let mut filled: Array<bool> = []
  let mut index = 0
  while index < signature.parameterCount {
    filled.push(false)
    index += 1
  }
  let mut positional = 0
  let mut overflow = 0
  let mut leadingSlot = -3
  if hasLeading {
    if signature.parameterCount > 0 {
      filled[0] = true
      positional = 1
      leadingSlot = 0
    } else if signature.variadic {
      leadingSlot = -1
    } else {
      overflow = 1
      leadingSlot = -2
    }
  }
  NamedCallPlan {
    slots: [],
    filled: filled,
    positional: positional,
    sawNamed: false,
    sawSpread: false,
    overflow: overflow,
    leadingSlot: leadingSlot,
    invalid: overflow > 0,
  }
}

function planNamedSignatureArgument(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  signature: CallSignature,
  plan: NamedCallPlan,
  argument: SyntaxNode,
) -> NamedCallPlan {
  let nameNode = match child(argument, "name") {
    case Some(found) => found
    case None => argument
  }
  let parameterIndex = callParameterIndex(signature, text(source, nameNode))
  let available = parameterIndex >= 0 && match plan.filled.get(parameterIndex) {
    case Some(value) => !value
    case None => false
  }
  let mut slots = plan.slots
  if available {
    let mut filled = plan.filled
    filled[parameterIndex] = true
    slots.push(parameterIndex)
  } else {
    let message = if parameterIndex == 0 && plan.leadingSlot == 0 {
      "`{text(source, nameNode)}` is already supplied by the pipeline (§11)"
    } else {
      "no parameter named `{text(source, nameNode)}`"
    }
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5004",
      message,
      "",
      nameNode,
    )
    slots.push(-2)
    return NamedCallPlan {
      ...plan,
      sawNamed: true,
      invalid: true,
    }
  }
  NamedCallPlan { ...plan, sawNamed: true }
}

function hasUnsatisfiedFixedParameter(
  signature: CallSignature,
  plan: NamedCallPlan,
) -> bool {
  let mut index = plan.positional
  while index < signature.parameterCount {
    let filled = match plan.filled.get(index) {
      case Some(value) => value
      case None => false
    }
    let defaulted = match signature.parameterDefaults.get(index) {
      case Some(value) => value
      case None => false
    }
    if !filled && !defaulted {
      return true
    }
    index += 1
  }
  false
}

function planSpreadSignatureArgument(
  state: CheckerState,
  moduleIndex: int,
  signature: CallSignature,
  plan: NamedCallPlan,
  argument: SyntaxNode,
) -> NamedCallPlan {
  let mut slots = plan.slots
  let mut invalid = plan.invalid
  if plan.sawNamed {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5004",
      "named arguments must follow spread arguments",
      "",
      argument,
    )
    invalid = true
  }
  if !plan.sawSpread && hasUnsatisfiedFixedParameter(signature, plan) {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5004",
      "a spread argument cannot skip an unsatisfied fixed parameter",
      "",
      argument,
    )
    invalid = true
  }
  slots.push(-1)
  NamedCallPlan {
    ...plan,
    sawSpread: true,
    invalid: invalid,
  }
}

function stageEarlierCallArgumentForSlot(
  slots: Array<int>,
  target: int,
) -> Array<int> {
  let mut staged = slots
  let mut index = 0
  while index < staged.length {
    match staged.get(index) {
      case Some(slot) => if slot == target {
        staged[index] = -2
        return staged
      }
      case None => ()
    }
    index += 1
  }
  staged
}

function planPositionalSignatureArgument(
  state: CheckerState,
  moduleIndex: int,
  signature: CallSignature,
  plan: NamedCallPlan,
  argument: SyntaxNode,
) -> NamedCallPlan {
  let mut invalid = plan.invalid
  if plan.sawNamed {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5004",
      "positional arguments may not follow named arguments",
      "",
      argument,
    )
    invalid = true
  }
  if plan.sawSpread {
    let mut slots = plan.slots
    slots.push(-1)
    return NamedCallPlan {
      ...plan,
      slots: slots,
      invalid: invalid,
    }
  }
  let mut positional = plan.positional
  if !plan.sawNamed {
    while positional < signature.parameterCount {
      let alreadyFilled = match plan.filled.get(positional) {
        case Some(value) => value
        case None => false
      }
      if !alreadyFilled { break }
      positional += 1
    }
  }
  let mut slots = plan.slots
  if positional < signature.parameterCount {
    if plan.sawNamed {
      slots = stageEarlierCallArgumentForSlot(slots, positional)
    }
    let mut filled = plan.filled
    filled[positional] = true
    slots.push(positional)
    positional += 1
    NamedCallPlan {
      ...plan,
      positional: positional,
      invalid: invalid,
    }
  } else if signature.variadic {
    slots.push(-1)
    NamedCallPlan {
      ...plan,
      positional: positional,
      invalid: invalid,
    }
  } else {
    slots.push(-2)
    NamedCallPlan {
      ...plan,
      positional: positional,
      overflow: plan.overflow + 1,
      invalid: true,
    }
  }
}

function namedCallPlanMissingRequired(
  signature: CallSignature,
  plan: NamedCallPlan,
) -> bool {
  let mut index = 0
  while index < signature.parameterCount {
    let defaulted = match signature.parameterDefaults.get(index) {
      case Some(value) => value
      case None => false
    }
    let present = match plan.filled.get(index) {
      case Some(value) => value
      case None => false
    }
    if !defaulted && !present {
      return true
    }
    index += 1
  }
  false
}

function planSignatureArgument(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  signature: CallSignature,
  plan: NamedCallPlan,
  argument: SyntaxNode,
) -> NamedCallPlan {
  match argument.kind {
    case "call-argument/named" => planNamedSignatureArgument(
      state,
      moduleIndex,
      source,
      signature,
      plan,
      argument,
    )
    case "call-argument/spread" => planSpreadSignatureArgument(
      state,
      moduleIndex,
      signature,
      plan,
      argument,
    )
    case _ => planPositionalSignatureArgument(
      state,
      moduleIndex,
      signature,
      plan,
      argument,
    )
  }
}

function callHasSpreadArgument(node: SyntaxNode) -> bool {
  for argument in children(node, "arguments") {
    if argument.kind == "call-argument/spread" {
      return true
    }
  }
  false
}

export function unknownCallArgumentPlan(node: SyntaxNode) -> CallArgumentPlan {
  let mut slots: Array<int> = []
  for _ in children(node, "arguments") {
    slots.push(-2)
  }
  CallArgumentPlan {
    slots: slots,
    leadingSlot: -3,
    resultUnknown: true,
  }
}

export function planSignatureArguments(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  diagnosticNode: SyntaxNode,
  signature: CallSignature,
  hasLeading: bool,
  deferArity: bool,
) -> CallArgumentPlan {
  if signature.positionalOnlyIdentity != "" {
    let mut invalid = false
    for argument in children(node, "arguments") {
      if argument.kind == "call-argument/named" ||
        argument.kind == "call-argument/spread" {
        invalid = true
      }
    }
    if invalid {
      if !deferArity { addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "a protocol call `{signature.positionalOnlyIdentity}(…)` takes positional arguments only",
        "",
        diagnosticNode,
      ) }
      return unknownCallArgumentPlan(node)
    }
  }
  if !signature.variadic && callHasSpreadArgument(node) {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5004",
      "spread arguments require a variadic parameter",
      "",
      diagnosticNode,
    )
    return unknownCallArgumentPlan(node)
  }
  let mut plan = emptyNamedCallPlan(signature, hasLeading)
  for argument in children(node, "arguments") {
    plan = planSignatureArgument(
      state,
      moduleIndex,
      source,
      signature,
      plan,
      argument,
    )
  }
  if !deferArity {
    reportNamedCallArity(
      state,
      moduleIndex,
      diagnosticNode,
      signature,
      plan.filled,
      plan.leadingSlot,
      children(node, "arguments").length + if hasLeading { 1 } else { 0 },
      plan.overflow,
    )
  }
  let missingRequired = namedCallPlanMissingRequired(signature, plan)
  CallArgumentPlan {
    slots: plan.slots,
    leadingSlot: plan.leadingSlot,
    resultUnknown: if deferArity {
      false
    } else {
      plan.invalid || missingRequired
    },
  }
}

record TypedCallPlan {
  slots: Array<int>,
  nextFixed: int,
  supplied: int,
  overflow: bool,
  leadingSlot: int,
  sawNamed: bool,
  sawSpread: bool,
  invalid: bool,
  staged: bool,
}

function emptyTypedCallPlan(
  calleeType: TypeValue,
  hasLeading: bool,
) -> TypedCallPlan {
  if !hasLeading {
    return TypedCallPlan {
      slots: [],
      nextFixed: 0,
      supplied: 0,
      overflow: false,
      leadingSlot: -3,
      sawNamed: false,
      sawSpread: false,
      invalid: false,
      staged: false,
    }
  }
  if calleeType.parameters.length > 0 {
    return TypedCallPlan {
      slots: [],
      nextFixed: 1,
      supplied: 1,
      overflow: false,
      leadingSlot: 0,
      sawNamed: false,
      sawSpread: false,
      invalid: false,
      staged: false,
    }
  }
  if calleeType.variadic.length > 0 {
    return TypedCallPlan {
      slots: [],
      nextFixed: 0,
      supplied: 1,
      overflow: false,
      leadingSlot: -1,
      sawNamed: false,
      sawSpread: false,
      invalid: false,
      staged: false,
    }
  }
  TypedCallPlan {
    slots: [],
    nextFixed: 0,
    supplied: 1,
    overflow: true,
    leadingSlot: -2,
    sawNamed: false,
    sawSpread: false,
    invalid: true,
    staged: false,
  }
}

function planTypedCallArgument(
  state: CheckerState,
  moduleIndex: int,
  calleeType: TypeValue,
  plan: TypedCallPlan,
  argument: SyntaxNode,
) -> TypedCallPlan {
  let mut slots = plan.slots
  if argument.kind == "call-argument/named" {
    slots.push(-2)
    return TypedCallPlan {
      ...plan,
      slots: slots,
      sawNamed: true,
      staged: true,
    }
  }
  if argument.kind == "call-argument/spread" {
    let mut invalid = plan.invalid
    if plan.sawNamed {
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "named arguments must follow spread arguments",
        "",
        argument,
      )
      invalid = true
    }
    if !plan.sawSpread && plan.nextFixed < calleeType.parameters.length {
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "a spread argument cannot skip an unsatisfied fixed parameter",
        "",
        argument,
      )
      invalid = true
    }
    slots.push(-1)
    return TypedCallPlan {
      ...plan,
      slots: slots,
      sawSpread: true,
      invalid: invalid,
    }
  }
  let mut invalid = plan.invalid
  if plan.sawNamed {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5004",
      "positional arguments may not follow named arguments",
      "",
      argument,
    )
    invalid = true
  }
  if plan.sawSpread {
    slots.push(-1)
    return TypedCallPlan {
      ...plan,
      slots: slots,
      supplied: plan.supplied + 1,
      invalid: invalid,
    }
  }
  if plan.nextFixed < calleeType.parameters.length {
    slots.push(plan.nextFixed)
    return TypedCallPlan {
      ...plan,
      nextFixed: plan.nextFixed + 1,
      supplied: plan.supplied + 1,
      invalid: invalid,
    }
  }
  if calleeType.variadic.length > 0 {
    slots.push(-1)
    return TypedCallPlan {
      ...plan,
      slots: slots,
      supplied: plan.supplied + 1,
      invalid: invalid,
    }
  }
  slots.push(-2)
  TypedCallPlan {
    ...plan,
    nextFixed: plan.nextFixed + 1,
    supplied: plan.supplied + 1,
    overflow: true,
    invalid: true,
  }
}

function reportTypedCallArity(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  calleeType: TypeValue,
  required: int,
  plan: TypedCallPlan,
) -> () {
  if calleeType.kind == "function" &&
    (plan.supplied < required || plan.overflow) {
    if plan.leadingSlot == -2 {
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "the pipeline inserts the piped value, but this function takes no parameters",
        "",
        node,
      )
    } else {
      let noun = if required == 1 { "argument" } else { "arguments" }
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "this call needs {required} {noun}, found {plan.supplied}",
        "",
        node,
      )
    }
  }
}

export function planTypedCallArguments(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  diagnosticNode: SyntaxNode,
  calleeType: TypeValue,
  hasLeading: bool,
) -> CallArgumentPlan {
  if calleeType.kind == "function" &&
    calleeType.variadic.length == 0 &&
    callHasSpreadArgument(node) {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5004",
      "spread arguments require a variadic parameter",
      "",
      diagnosticNode,
    )
    return unknownCallArgumentPlan(node)
  }
  let mut plan = emptyTypedCallPlan(calleeType, hasLeading)
  for argument in children(node, "arguments") {
    plan = planTypedCallArgument(
      state,
      moduleIndex,
      calleeType,
      plan,
      argument,
    )
  }
  if plan.staged {
    return unknownCallArgumentPlan(node)
  }
  reportTypedCallArity(
    state,
    moduleIndex,
    diagnosticNode,
    calleeType,
    calleeType.parameters.length,
    plan,
  )
  CallArgumentPlan {
    slots: plan.slots,
    leadingSlot: plan.leadingSlot,
    resultUnknown: plan.invalid || plan.supplied < calleeType.parameters.length,
  }
}

export function callSlotExpectedType(
  calleeType: TypeValue,
  slot: int,
  spread: bool,
) -> Option<TypeValue> {
  if slot >= 0 {
    return calleeType.parameters.get(slot)
  }
  if slot == -1 {
    return match calleeType.variadic.get(0) {
      case Some(found) => if spread {
        Some(constructor("Array", [found]))
      } else {
        Some(found)
      }
      case None => None
    }
  }
  None
}

export function callArgumentExpectedType(
  calleeType: TypeValue,
  argument: SyntaxNode,
  slot: int,
) -> Option<TypeValue> {
  callSlotExpectedType(
    calleeType,
    slot,
    argument.kind == "call-argument/spread",
  )
}

export record InferredCallCallee {
  declaredType: TypeValue,
  receiverType: TypeValue,
  optionalContainer: string,
  builtinSignature: Option<CallSignature>,
}

// A builtin namespace has no receiver value, so its static member carries its
// parameter names and defaults here, as a canonical boundary target does.
function staticNamespaceCallSignature(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
  memberType: TypeValue,
) -> Option<CallSignature> {
  if memberType.kind != "function" {
    return None
  }
  let object = match child(callee, "object") {
    case Some(found) => found
    case None => return None
  }
  let field = match child(callee, "field") {
    case Some(found) => found
    case None => return None
  }
  if !builtinNamespaceObject(service, state, moduleIndex, source, object) {
    return None
  }
  staticBuiltinCallSignature(text(source, object), text(source, field))
}

export function inferCallCallee(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  callee: SyntaxNode,
) -> InferredCallCallee {
  match boundBuiltinForCallee(state, moduleIndex, callee) {
    case Some(bound) => return InferredCallCallee { declaredType: bound.typeValue, receiverType: bound.receiverType, optionalContainer: "", builtinSignature: bound.signature }
    case None => ()
  }
  let boundary = canonicalBoundaryTarget(state, moduleIndex, source, callee)
  if boundary.length == 2 {
    if boundary[0] == "" {
      match builtinFunction(boundary[1], "topaz-5.20") {
        case Some(found) => return InferredCallCallee { declaredType: found.typeValue, receiverType: emptyType("unknown"), optionalContainer: "", builtinSignature: Some(found.callSignature) }
        case None => ()
      }
    } else {
      match builtinNamespaceMemberType(boundary[0], boundary[1], "topaz-5.20") {
        case Some(found) => return InferredCallCallee { declaredType: found, receiverType: emptyType("unknown"), optionalContainer: "", builtinSignature: staticBuiltinCallSignature(boundary[0], boundary[1]) }
        case None => ()
      }
    }
  }
  if callee.kind == "expression/identifier" &&
    match referenceTargetType(state, moduleIndex, callee) {
      case Some(_) => false
      case None => true
    } {
    match builtinFunction(text(source, callee), state.languageMode) {
      case Some(found) => {
        recordInferredExpression(
          state,
          moduleIndex,
          source,
          callee,
          found.typeValue,
        )
        return InferredCallCallee {
          declaredType: found.typeValue,
          receiverType: emptyType("unknown"),
          optionalContainer: "",
          builtinSignature: Some(found.callSignature),
        }
      }
      case None => ()
    }
  }
  if callee.kind == "expression/optional-access" {
    let optional = inferOptionalMemberAccess(
      service,
      state,
      moduleIndex,
      source,
      callee,
      node,
    )
    recordInferredExpression(
      state,
      moduleIndex,
      source,
      callee,
      optional.wrappedType,
    )
    return InferredCallCallee {
      declaredType: optional.rawType,
      receiverType: optional.receiverType,
      optionalContainer: optional.container,
      builtinSignature: None,
    }
  }
  if callee.kind == "expression/member" {
    let member = inferPlainMemberAccess(
      service,
      state,
      moduleIndex,
      source,
      callee,
      node,
      true,
    )
    recordInferredExpression(
      state,
      moduleIndex,
      source,
      callee,
      member.memberType,
    )
    return InferredCallCallee {
      declaredType: member.memberType,
      receiverType: member.receiverType,
      optionalContainer: "",
      builtinSignature: staticNamespaceCallSignature(
        service,
        state,
        moduleIndex,
        source,
        callee,
        member.memberType,
      ),
    }
  }
  let calleeType = if callee.kind == "expression/identifier" {
    let inferred = inferIdentifierExpression(
      state,
      moduleIndex,
      source,
      callee,
      true,
    )
    recordInferredExpression(state, moduleIndex, source, callee, inferred)
    inferred
  } else {
    serviceInferExpression(service, state, moduleIndex, source, callee)
  }
  InferredCallCallee {
    declaredType: calleeType,
    receiverType: emptyType("unknown"),
    optionalContainer: "",
    builtinSignature: None,
  }
}

export function explicitCallBindings(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  diagnosticNode: SyntaxNode,
  callee: SyntaxNode,
  referencedDefinition: Option<FunctionDefinition>,
  allowTypeArguments: bool,
  receiverType: TypeValue,
  parameters: Array<TypeValue>,
) -> Array<TypeBinding> {
  let mut bindings: Array<TypeBinding> = []
  let mut parameterNames: Array<string> = []
  if allowTypeArguments {
    for parameter in parameters { parameterNames.push(parameter.name) }
  }
  let expectedCount = parameterNames.length
  let suppliedCount = children(node, "typeArguments").length
  if suppliedCount > 0 && expectedCount == 0 {
    let argumentSuffix = if suppliedCount == 1 { "" } else { "s" }
    let suppliedVerb = if suppliedCount == 1 { "was" } else { "were" }
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5512",
      "this call is not generic, but {suppliedCount} type argument{argumentSuffix} {suppliedVerb} supplied",
      "",
      diagnosticNode,
    )
  } else if suppliedCount > 0 && suppliedCount != expectedCount {
    let expectedSuffix = if expectedCount == 1 { "" } else { "s" }
    let suppliedVerb = if suppliedCount == 1 { "was" } else { "were" }
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5510",
      "this call expects {expectedCount} type argument{expectedSuffix}, but {suppliedCount} {suppliedVerb} supplied",
      "",
      diagnosticNode,
    )
  }
  if suppliedCount > 0 && suppliedCount == expectedCount {
    let mut index = 0
    for typeArgument in children(node, "typeArguments") {
      match parameterNames.get(index) {
        case Some(parameterName) => {
          let value = formType(service, state, moduleIndex, source, typeArgument, [], "call")
          addNode(state, moduleIndex, "type", typeArgument, value)
          match parameters.get(index) {
            case Some(parameter) => bindTypeVariable(bindings, parameter, value, false)
            case None => ()
          }
        }
        case None => ()
      }
      index += 1
    }
  }
  bindings
}

export function callTypeParameters(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
  receiverType: TypeValue,
  definition: Option<FunctionDefinition>,
  protocol: Option<UserProtocolCallTarget>,
  declaredType: TypeValue,
) -> Array<TypeValue> {
  let mut parameters: Array<TypeValue> = []
  match definition {
    case Some(found) => {
      let mut index = 0
      for name in found.typeParameters {
        match found.typeParameterOrigins.get(index) {
          case Some(origin) => parameters.push(rigid(name, origin))
          case None => ()
        }
        index += 1
      }
      return parameters
    }
    case None => ()
  }
  match protocol {
    case Some(target) => {
      match target.method.typeValue.parameters.get(0) {
        case Some(parameter) => parameters.push(parameter)
        case None => ()
      }
      return parameters
    }
    case None => ()
  }
  let atoms = flattenType(declaredType)
  for name in builtinCallTypeParameters(service, state, moduleIndex, source, callee, receiverType) {
    for atom in atoms {
      if atom.kind == "rigid" && atom.name == name && atom.origin.startsWith("builtin::") {
        parameters.push(rigid(name, atom.origin))
        break
      }
    }
    ()
  }
  parameters
}
