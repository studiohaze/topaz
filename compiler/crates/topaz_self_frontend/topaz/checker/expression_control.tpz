import literal { signedIntegerInput, decodeIntegerLiteral, decodeDecimalFloatLiteral, decodeDurationMilliseconds }
// Inference for operators, branches, loops, matches, and concurrent forms.
// Core literals and member access stay in expression_core; recursive descent is
// routed through the service boundary owned by the checker facade.

