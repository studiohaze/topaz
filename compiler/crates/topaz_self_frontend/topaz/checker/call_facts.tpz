export function argumentValue(argument: SyntaxNode) -> SyntaxNode {
  if argument.kind == "call-argument/named" || argument.kind == "call-argument/spread" {
    match child(argument, "value") {
      case Some(found) => found
      case None => argument
    }
  } else {
    argument
  }
}

// A declaration signature belongs to the callable itself. References used
// while evaluating a receiver or producing a callable are different calls.
export function calleeReference(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
) -> Option<PreviewResolvedReference> {
  if node.kind == "expression/identifier" {
    return referenceFor(state, moduleIndex, node.lo, node.hi)
  }
  if node.kind == "expression/member" {
    match child(node, "field") {
      case Some(field) => return referenceFor(state, moduleIndex, field.lo, field.hi)
      case None => ()
    }
  }
  None
}

function callableReferenceInNode(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
) -> Option<PreviewResolvedReference> {
  if node.kind == "expression/identifier" {
    return referenceFor(state, moduleIndex, node.lo, node.hi)
  }
  if node.kind == "expression/parenthesized" {
    return match child(node, "operand") {
      case Some(operand) => callableReferenceInNode(state, moduleIndex, operand)
      case None => None
    }
  }
  if node.kind == "expression/member" ||
    node.kind == "expression/optional-access" {
    return match child(node, "field") {
      case Some(field) => referenceFor(state, moduleIndex, field.lo, field.hi)
      case None => None
    }
  }
  None
}

function referenceTargetIdentity(
  state: CheckerState,
  reference: PreviewResolvedReference,
) -> string {
  match declarationFor(
    state,
    reference.targetModuleIndex,
    reference.targetLo,
    reference.targetHi,
  ) {
    case Some(declaration) => if declaration.targetModule != "" &&
      declaration.targetName != "" {
      "{declaration.targetModule}::{declaration.targetName}"
    } else if reference.targetModule != "" && reference.targetName != "" {
      "{reference.targetModule}::{reference.targetName}"
    } else {
      ""
    }
    case None => if reference.targetModule != "" && reference.targetName != "" {
      "{reference.targetModule}::{reference.targetName}"
    } else {
      ""
    }
  }
}

function callMethodClass(name: string) -> string {
  match name {
    case "map" | "filter" | "reduce" | "flatMap" | "mapErr" => "higher-order"
    case "okOrElse" => "lazy-callback"
    case "push" | "insert" | "set" | "remove" | "update" | "clear" |
      "extend" | "add" => "mutator"
    case "read" | "write" | "close" | "open" => "resource"
    case _ => "other"
  }
}

export function builtinMutator(receiver: TypeValue, name: string) -> bool {
  if receiver.kind == "union" {
    for member in receiver.members {
      if builtinMutator(member, name) {
        return true
      }
    }
    return false
  }
  if receiver.kind == "constructor" && receiver.name == "Array" {
    return name == "push" || name == "pop" || name == "clear" ||
      name == "reverse" || name == "insert" || name == "removeAt" ||
      name == "sort" || name == "sortBy" || name == "retain"
  }
  if receiver.kind == "constructor" && receiver.name == "Map" {
    return name == "insert" || name == "remove" || name == "clear" ||
      name == "update"
  }
  if receiver.kind == "constructor" && receiver.name == "Set" {
    return name == "add" || name == "remove" || name == "clear"
  }
  receiver.kind == "byte-buffer" &&
    (name == "set" || name == "fill" || name == "copy")
}

function requiredBuiltinFunction(
  parameters: Array<TypeValue>,
  result: TypeValue,
  parameterNames: Array<string>,
) -> BuiltinFunction {
  BuiltinFunction {
    typeValue: functionType(parameters, [], result),
    callSignature: requiredCallSignature(parameterNames, false),
  }
}

function defaultedBuiltinFunction(
  parameters: Array<TypeValue>,
  result: TypeValue,
  parameterNames: Array<string>,
  parameterDefaults: Array<bool>,
) -> BuiltinFunction {
  BuiltinFunction {
    typeValue: functionType(parameters, [], result),
    callSignature: defaultedCallSignature(
      parameterNames,
      parameterDefaults,
    ),
  }
}

export function builtinFunction(name: string, languageMode: string = "topaz-5.20") -> Option<BuiltinFunction> {
  if languageMode == "topaz-5.21" && (name == "toFloat" || name == "toInt" || name == "toIntRadix" || name == "fromCodePoint" || name == "map" || name == "filter" || name == "reduce" || name == "print" || name == "input" || name == "open" || name == "assert") { return None }
  match name {
    case "print" => Some(requiredBuiltinFunction(
      [primitive("string")],
      primitive("unit"),
      ["value"],
    ))
    case "toInt" => Some(requiredBuiltinFunction(
      [primitive("string")],
      constructor("Option", [primitive("int")]),
      ["text"],
    ))
    case "toIntRadix" => Some(requiredBuiltinFunction(
      [primitive("string"), primitive("int")],
      constructor("Option", [primitive("int")]),
      ["text", "radix"],
    ))
    case "fromCodePoint" => Some(requiredBuiltinFunction(
      [primitive("int")],
      constructor("Option", [primitive("string")]),
      ["n"],
    ))
    case "toFloat" => Some(requiredBuiltinFunction(
      [primitive("int")],
      primitive("float"),
      ["n"],
    ))
    case "map" => {
      let input = rigid("T", "builtin::map")
      let output = rigid("U", "builtin::map")
      Some(requiredBuiltinFunction(
        [
          emptyType("unknown"),
          functionType([input], [], output),
        ],
        constructor("Array", [output]),
        ["xs", "f"],
      ))
    }
    case "filter" => {
      let input = rigid("T", "builtin::filter")
      Some(requiredBuiltinFunction(
        [
          emptyType("unknown"),
          functionType([input], [], primitive("bool")),
        ],
        constructor("Array", [input]),
        ["xs", "f"],
      ))
    }
    case "reduce" => {
      let input = rigid("T", "builtin::reduce")
      let output = rigid("U", "builtin::reduce")
      Some(requiredBuiltinFunction(
        [
          emptyType("unknown"),
          output,
          functionType([output, input], [], output),
        ],
        output,
        ["xs", "initial", "f"],
      ))
    }
    case "input" => Some(requiredBuiltinFunction(
      [],
      primitive("string"),
      [],
    ))
    case "open" => Some(requiredBuiltinFunction(
      [primitive("string")],
      constructor("Result", [emptyType("file"), primitive("string")]),
      ["path"],
    ))
    case "assert" => Some(defaultedBuiltinFunction(
      [primitive("bool"), primitive("string")],
      primitive("unit"),
      ["condition", "message"],
      [false, true],
    ))
    case "Some" => {
      let value = rigid("T", "builtin::Some")
      Some(requiredBuiltinFunction(
        [value],
        constructor("Option", [value]),
        ["value"],
      ))
    }
    case "Ok" => {
      let value = rigid("T", "builtin::Ok")
      let error = rigid("E", "builtin::Ok")
      Some(requiredBuiltinFunction(
        [value],
        constructor("Result", [value, error]),
        ["value"],
      ))
    }
    case "Err" => {
      let value = rigid("T", "builtin::Err")
      let error = rigid("E", "builtin::Err")
      Some(requiredBuiltinFunction(
        [error],
        constructor("Result", [value, error]),
        ["error"],
      ))
    }
    case _ => None
  }
}

function builtinFunctionType(name: string, languageMode: string = "topaz-5.20") -> Option<TypeValue> {
  match builtinFunction(name, languageMode) {
    case Some(found) => Some(found.typeValue)
    case None => None
  }
}

export function builtinIdentifierType(name: string, languageMode: string = "topaz-5.20") -> Option<TypeValue> {
  match builtinFunctionType(name, languageMode) {
    case Some(found) => if name == "Some" || name == "Ok" ||
      name == "Err" || name == "map" || name == "filter" ||
      name == "reduce" {
      Some(emptyType("unknown"))
    } else {
      Some(found)
    }
    case None => None
  }
}

export function isBuiltinNamespace(name: string) -> bool {
  builtinNamespaceFamily(name) != ""
}

function unboundFunctionSuggestionNames() -> Array<string> {
  [
    "print",
    "toInt",
    "toIntRadix",
    "fromCodePoint",
    "toFloat",
    "map",
    "filter",
    "reduce",
    "input",
    "open",
    "assert",
    "Some",
    "Ok",
    "Err",
  ]
}

export function numericMigrationHint(state: CheckerState, name: string) -> string {
  if state.languageMode != "topaz-5.21" { return "" }
  match name {
    case "Math" => "; use float receiver methods and string.parseFloat() in 5.21"
    case "toFloat" => "; use int.toFloat() in 5.21"
    case "toInt" => "; use string.toInt() in 5.21"
    case "toIntRadix" => "; use string.toIntRadix(radix) in 5.21"
    case "fromCodePoint" => "; use int.toCodePoint() in 5.21"
    case "map" => "; use xs.map(f) in 5.21"
    case "filter" => "; use xs.filter(f) in 5.21"
    case "reduce" => "; use xs.reduce(initial, f) in 5.21"
    case "print" => "; import std.io and use io.writeLine(value) in 5.21"
    case "input" => "; import std.io and use io.readStdin() in 5.21"
    case "open" => "; import std.io and use io.open(...) in 5.21"
    case "assert" => "; import std.test and use test.assert(...) in 5.21"
    case _ => ""
  }
}

export function unboundSuggestion(
  state: CheckerState,
  reference: PreviewResolvedReference,
) -> string {
  let migration = numericMigrationHint(state, reference.name)
  if migration != "" { return migration }
  let mut candidates: Array<string> = []
  match state.valueDeclarationIndexesByModule.get("{reference.moduleIndex}") {
    case Some(indexes) => for index in indexes {
      match state.resolved.declarations.get(index) {
        case Some(declaration) => if scopeIsWithin(
          state,
          reference.moduleIndex,
          reference.scopeOrdinal,
          declaration.scopeOrdinal,
        ) {
          candidates.push(declaration.name)
        }
        case None => ()
      }
    }
    case None => ()
  }
  for candidate in unboundFunctionSuggestionNames() {
    match builtinIdentifierType(candidate, state.languageMode) { case Some(_) => candidates.push(candidate); case None => () }
  }
  candidates.push("None")
  didYouMean(reference.name, candidates)
}

export function unboundCalleeSuggestion(
  state: CheckerState,
  reference: PreviewResolvedReference,
) -> string {
  let migration = numericMigrationHint(state, reference.name)
  if migration != "" { return migration }
  let mut candidates: Array<string> = []
  let mut seen: Set<string> = set {}
  let mut scopeOrdinal = reference.scopeOrdinal
  while scopeOrdinal >= 0 {
    match state.valueDeclarationIndexesByModule.get("{reference.moduleIndex}") {
      case Some(indexes) => for index in indexes {
        match state.resolved.declarations.get(index) {
          case Some(declaration) => if declaration.scopeOrdinal == scopeOrdinal {
            match symbolTypeAt(
              state,
              reference.moduleIndex,
              declaration.lo,
              declaration.hi,
            ) {
              case Some(typeValue) => if !seen.contains(declaration.name) {
                seen.add(declaration.name)
                if typeValue.kind == "function" {
                  candidates.push(declaration.name)
                }
              }
              case None => ()
            }
          }
          case None => ()
        }
      }
      case None => ()
    }
    scopeOrdinal = match scopeFor(state, reference.moduleIndex, scopeOrdinal) {
      case Some(scope) => scope.parentOrdinal
      case None => -1
    }
  }
  for candidate in unboundFunctionSuggestionNames() {
    if !seen.contains(candidate) {
      match builtinIdentifierType(candidate, state.languageMode) { case Some(_) => candidates.push(candidate); case None => () }
    }
  }
  didYouMean(reference.name, candidates)
}

export function diagnoseUnboundReferences(state: CheckerState) -> () {
  for reference in state.resolved.references {
    if reference.targetModuleIndex >= 0 ||
      reference.namespace != "value" ||
      reference.role == "read" ||
      generatedLispexIntrinsic(state, reference.moduleIndex, reference.name) ||
      reference.name == "None" ||
      isBuiltinNamespace(reference.name) ||
      match builtinIdentifierType(reference.name, state.languageMode) {
        case Some(_) => true
        case None => false
      } {
      continue
    }
    addDiagnostic(
      state,
      reference.moduleIndex,
      "TPZ5002",
      "`{reference.name}` is not bound{unboundSuggestion(state, reference)}",
      "",
      SyntaxNode {
        kind: "identifier",
        lo: reference.lo,
        hi: reference.hi,
        field: "",
        index: 0,
        attributes: [],
        children: [],
      },
    )
  }
  ()
}

export function currentFunctionReturn(state: CheckerState) -> Option<TypeValue> {
  if state.expectedReturns.length == 0 {
    return None
  }
  match state.expectedReturns.get(state.expectedReturns.length - 1) {
    case Some(context) => Some(context.typeValue)
    case None => None
  }
}

export function isBareBindingExpression(state: CheckerState, node: SyntaxNode) -> bool {
  match state.bareBindingExpressions.get(state.bareBindingExpressions.length - 1) {
    case Some(value) => value.kind == node.kind && value.lo == node.lo && value.hi == node.hi
    case None => false
  }
}

export function currentExpectedExpression(
  state: CheckerState,
  expression: SyntaxNode,
) -> Option<TypeValue> {
  if state.expectedExpressions.length == 0 {
    return None
  }
  match state.expectedExpressions.get(state.expectedExpressions.length - 1) {
    case Some(context) => if context.kind == expression.kind &&
      context.lo == expression.lo && context.hi == expression.hi {
      Some(context.typeValue)
    } else {
      None
    }
    case None => None
  }
}

export function inferExpressionWithExpected(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  expression: SyntaxNode,
  expected: TypeValue,
  contextual: bool,
) -> TypeValue {
  inferExpressionWithResultContext(service, state, moduleIndex, source,
    expression, expected, contextual, true)
}

// The enclosing callable can own the result comparison while its body still
// needs the expected type to infer parameters and polymorphic constructions.
export function inferExpressionWithResultContext(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  expression: SyntaxNode,
  expected: TypeValue,
  contextual: bool,
  checkResult: bool,
) -> TypeValue {
  let mut expectedExpressions = state.expectedExpressions
  expectedExpressions.push(ExpectedExpressionContext {
    kind: expression.kind,
    lo: expression.lo,
    hi: expression.hi,
    typeValue: expected,
    checkResult: checkResult,
  })
  let inferred = if contextual {
    inferExpressionContext(service, state, moduleIndex, source, expression)
  } else {
    serviceInferExpression(service, state, moduleIndex, source, expression)
  }
  expectedExpressions.pop()
  inferred
}

export function currentExpressionChecksResult(
  state: CheckerState,
  expression: SyntaxNode,
) -> bool {
  match state.expectedExpressions.get(state.expectedExpressions.length - 1) {
    case Some(context) => if context.kind == expression.kind &&
      context.lo == expression.lo && context.hi == expression.hi {
      context.checkResult
    } else {
      true
    }
    case None => true
  }
}

function appendReturnType(state: CheckerState, value: TypeValue) -> () {
  if state.returnJoins.length == 0 {
    return ()
  }
  let index = state.returnJoins.length - 1
  match state.returnJoins.get(index) {
    case Some(found) => {
      let mut values = found
      values.push(value)
      let mut joins = state.returnJoins
      joins[index] = values
    }
    case None => ()
  }
  ()
}

export function checkReturn(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
) -> () {
  let value = child(node, "value")
  match state.expectedReturns.get(state.expectedReturns.length - 1) {
    case None => {
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5001",
        "`return` outside a function",
        "",
        node,
      )
      match value {
        case Some(found) => {
          let _ = serviceInferExpression(service, state, moduleIndex, source, found)
        }
        case None => ()
      }
    }
    case Some(context) => {
      let expected = context.typeValue
      let inferred = match value {
        case Some(found) => if expected.kind == "unknown" {
          serviceInferExpression(service, state, moduleIndex, source, found)
        } else {
          inferExpressionWithResultContext(service, state, moduleIndex, source,
            found, expected, false, context.checkResult)
        }
        case None => primitive("unit")
      }
      // Both contextual and inferred callables retain every actual return type.
      appendReturnType(state, inferred)
      if context.checkResult && expected.kind != "unknown" {
        let valueNode = match value {
          case Some(found) => found
          case None => node
        }
        let refined = refineExpressionToExpected(state, moduleIndex, valueNode,
          inferred, expected)
        reportExpectedType(state, moduleIndex, valueNode, expected, refined)
      }
    }
  }
  ()
}

export function builtinCallTypeParameters(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
  receiverType: TypeValue,
) -> Array<string> {
  let empty: Array<string> = []
  match boundBuiltinForCallee(state, moduleIndex, callee) { case Some(bound) => return bound.typeParameters; case None => () }
  let boundary = canonicalBoundaryTarget(state, moduleIndex, source, callee)
  if boundary.length == 2 && boundary[0] == "JSON" && (boundary[1] == "parseAs" || boundary[1] == "stringify") { return ["T"] }
  if boundary.length == 2 && boundary[0] == "Test" {
    if boundary[1] == "assertEq" || boundary[1] == "assertNe" || boundary[1] == "assertSome" || boundary[1] == "assertNone" { return ["T"] }
    if boundary[1] == "assertOk" || boundary[1] == "assertErr" { return ["T", "E"] }
  }
  if callee.kind == "expression/identifier" {
    if !unshadowedIdentifier(state, moduleIndex, callee) {
      return empty
    }
    return match text(source, callee) {
      case "Some" => ["T"]
      case "Ok" | "Err" => ["T", "E"]
      case "map" | "reduce" => ["T", "U"]
      case "filter" => ["T"]
      case _ => empty
    }
  }
  if callee.kind != "expression/member" {
    return empty
  }
  let object = match child(callee, "object") {
    case Some(found) => found
    case None => return empty
  }
  let field = match child(callee, "field") {
    case Some(found) => text(source, found)
    case None => return empty
  }
  if !builtinNamespaceObject(service, state, moduleIndex, source, object) {
    if state.languageMode == "topaz-5.21" && receiverType.kind == "json-value" && field == "decode" { return ["T"] }
    if receiverType.kind != "constructor" {
      return empty
    }
    return match receiverType.name {
      case "Option" => match field {
        case "okOr" | "okOrElse" | "map" | "flatMap" => ["U"]
        case _ => empty
      }
      case "Result" => match field {
        case "mapErr" => ["F"]
        case "map" | "flatMap" => ["U"]
        case _ => empty
      }
      case "Set" | "Range" => if state.languageMode == "topaz-5.21" && (field == "map" || field == "reduce") { ["U"] } else { empty }
      case "Array" => match field {
        case "map" | "reduce" => ["U"]
        case "sortedBy" | "sortBy" => ["K"]
        case _ => empty
      }
      case "Map" => if field == "mapValues" { ["W"] } else { empty }
      case _ => empty
    }
  }
  match text(source, object) {
    case "Array" | "Set" => if field == "of" { ["T"] } else { empty }
    case "Map" => if field == "new" || field == "ofEntries" {
      ["K", "V"]
    } else {
      empty
    }
    case "JSON" => if field == "parseAs" || field == "decode" ||
      field == "stringify" {
      ["T"]
    } else {
      empty
    }
    case "Test" => match field {
      case "assertEq" | "assertNe" | "assertSome" | "assertNone" => ["T"]
      case "assertOk" | "assertErr" => ["T", "E"]
      case _ => empty
    }
    case _ => empty
  }
}

export function contextualBuiltinCall(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  expression: SyntaxNode,
  callee: SyntaxNode,
  calleeType: TypeValue,
) -> Option<TypeValue> {
  if !unshadowedIdentifier(state, moduleIndex, callee) {
    return None
  }
  let name = text(source, callee)
  if name != "Ok" && name != "Err" {
    return None
  }
  let expected = match currentExpectedExpression(state, expression) {
    case Some(found) => found
    case None => return None
  }
  if expected.kind != "constructor" ||
    expected.name != "Result" ||
    expected.arguments.length != 2 || hasHole(expected) {
    return None
  }
  let parameter = if name == "Ok" {
    expected.arguments.get(0)
  } else {
    expected.arguments.get(1)
  }
  match parameter {
    case Some(found) => Some(functionType([found], [], expected))
    case None => Some(calleeType)
  }
}

export function contextualBuiltinArgumentType(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
  argumentIndex: int,
  actuals: Array<TypeValue>,
  fallback: Option<TypeValue>,
) -> Option<TypeValue> {
  if !unshadowedIdentifier(state, moduleIndex, callee) {
    return fallback
  }
  let name = text(source, callee)
  if argumentIndex == 1 && (name == "map" || name == "filter") {
    match actuals.get(0) {
      case Some(collection) => {
        let input = iterableElement(collection)
        match fallback {
          case Some(callback) => match callback.result.get(0) {
            case Some(output) => return Some(functionType(
              [input], callback.variadic, output))
            case None => ()
          }
          case None => ()
        }
      }
      case None => ()
    }
  }
  if argumentIndex == 2 && name == "reduce" {
    let input = match actuals.get(0) {
      case Some(collection) => iterableElement(collection)
      case None => emptyType("unknown")
    }
    let output = match actuals.get(1) {
      case Some(initial) => widen(initial)
      case None => emptyType("unknown")
    }
    return Some(functionType(
      [output, input],
      [],
      output,
    ))
  }
  fallback
}

export function contextualStandardWrapperCall(
  state: CheckerState,
  moduleIndex: int,
  expression: SyntaxNode,
  callee: SyntaxNode,
  calleeType: TypeValue,
  actuals: Array<TypeValue>,
) -> Option<TypeValue> {
  if callee.kind != "expression/member" &&
    callee.kind != "expression/optional-access" {
    return None
  }
  if calleeType.kind != "unknown" {
    return None
  }
  match moduleAt(state, moduleIndex) {
    case Some(module) => if !module.identity.startsWith("std.") {
      return None
    }
    case None => return None
  }
  let expected = match currentExpectedExpression(state, expression) {
    case Some(found) => found
    case None => return None
  }
  let mut parameters: Array<TypeValue> = []
  for actual in actuals {
    parameters.push(widen(actual))
  }
  match moduleAt(state, moduleIndex) {
    case Some(module) => {
      let field = match child(callee, "field") {
        case Some(found) => text(module.source, found)
        case None => ""
      }
      if module.identity == "std.decimal" &&
        ((field == "round" && parameters.length == 1) ||
        (field == "div" && parameters.length == 2)) {
        parameters.push(emptyType("rounding-mode"))
      }
    }
    case None => ()
  }
  Some(functionType(parameters, [], expected))
}

export function boundBuiltinForCallee(state: CheckerState, moduleIndex: int, callee: SyntaxNode) -> Option<BoundBuiltin> {
  let reference = match calleeReference(state, moduleIndex, callee) { case Some(value) => value; case None => return None }
  let declaration = match declarationOriginForReference(state, reference) { case Some(value) => value; case None => return None }
  state.boundBuiltins.get(spanKey(declaration.moduleIndex, declaration.lo, declaration.hi))
}

export function recordBoundBuiltin(
  service: CheckerService, state: CheckerState, moduleIndex: int, source: Bytes,
  declaration: SyntaxNode, value: SyntaxNode, valueType: TypeValue,
) -> () {
  if valueType.kind != "function" { return () }
  let key = spanKey(moduleIndex, declaration.lo, declaration.hi)
  match boundBuiltinForCallee(state, moduleIndex, value) {
    case Some(found) => { let mut bindings = state.boundBuiltins; bindings.insert(key, found); return () }
    case None => ()
  }
  let mut receiver = emptyType("unknown")
  let mut member = ""
  let mut boundary = canonicalBoundaryTarget(state, moduleIndex, source, value)
  let mut signature: Option<CallSignature> = None
  if boundary.length == 2 {
    member = boundary[1]
    if boundary[0] == "" { match builtinFunction(member, "topaz-5.20") { case Some(found) => { signature = Some(found.callSignature) }; case None => () } }
    else { signature = staticBuiltinDataCallSignature(boundary[0], member) }
  } else if value.kind == "expression/member" {
    let object = match child(value, "object") { case Some(found) => found; case None => return () }
    let field = match child(value, "field") { case Some(found) => found; case None => return () }
    member = text(source, field)
    if builtinNamespaceObject(service, state, moduleIndex, source, object) {
      boundary = [text(source, object), member]
      signature = staticBuiltinDataCallSignature(boundary[0], member)
    } else {
      receiver = serviceInferExpression(service, state, moduleIndex, source, object)
      signature = builtinReceiverCallSignature(receiver, member, state.languageMode)
    }
  } else { return () }
  match signature { case None => return (); case Some(_) => () }
  let target = if boundary.length == 2 && boundary[0] == "JSON" && member == "parseAs" { "builtin::JsonParseAs" }
    else if receiver.kind == "json-value" && member == "decode" { "builtin::JsonDecode" } else { "" }
  let metadata = BoundBuiltin { typeValue: valueType, receiverType: receiver, member: member, boundary: boundary,
    typeParameters: builtinCallTypeParameters(service, state, moduleIndex, source, value, receiver), signature: signature, target: target }
  let mut bindings = state.boundBuiltins
  bindings.insert(key, metadata)
  ()
}

export function canonicalBoundaryTarget(state: CheckerState, moduleIndex: int, source: Bytes, callee: SyntaxNode) -> Array<string> {
  if state.languageMode != "topaz-5.21" { return [] }
  if callee.kind == "expression/identifier" {
    match moduleAt(state, moduleIndex) {
      case Some(module) => if module.generatedStd {
        let binding = standardBoundary(module.identity, text(source, callee))
        if binding.length == 2 { return binding }
      }
      case None => ()
    }
  }
  match calleeReference(state, moduleIndex, callee) {
    case Some(reference) => {
      match moduleAt(state, reference.targetModuleIndex) {
        case Some(module) => if !module.generatedStd { return [] }
        case None => return []
      }
      return match referenceTargetIdentity(state, reference) {
        case "std.fs::readText" => ["FS", "readText"]
        case "std.fs::writeText" => ["FS", "writeText"]
        case "std.fs::readBytes" => ["FS", "readBytes"]
        case "std.fs::writeBytes" => ["FS", "writeBytes"]
        case "std.fs::list" => ["FS", "list"]
        case "std.io::readStdin" => ["", "input"]
        case "std.io::open" => ["", "open"]
        case "std.json::parse" => ["JSON", "parse"]
        case "std.json::stringify" => ["JSON", "stringify"]
        case "std.json::parseAs" => ["JSON", "parseAs"]
        case "std.csv::parse" => ["CSV", "parse"]
        case "std.csv::parseWithHeader" => ["CSV", "parseWithHeader"]
        case "std.csv::stringify" => ["CSV", "stringify"]
        case "std.csv::stringifyWithHeader" => ["CSV", "stringifyWithHeader"]
        case "std.toml::parse" => ["TOML", "parse"]
        case "std.toml::stringify" => ["TOML", "stringify"]
        case "std.toml::fromJson" => ["TOML", "fromJson"]
        case "std.test::assert" => ["Test", "assert"]
        case "std.test::assertEq" => ["Test", "assertEq"]
        case "std.test::assertNe" => ["Test", "assertNe"]
        case "std.test::assertContains" => ["Test", "assertContains"]
        case "std.test::assertOk" => ["Test", "assertOk"]
        case "std.test::assertErr" => ["Test", "assertErr"]
        case "std.test::assertSome" => ["Test", "assertSome"]
        case "std.test::assertNone" => ["Test", "assertNone"]
        case "std.test::assertGolden" => ["Test", "assertGolden"]
        case _ => []
      }
    }
    case None => []
  }
}

export function generatedStandardFunctionType(state: CheckerState, moduleIndex: int, name: string) -> Option<TypeValue> {
  let module = match moduleAt(state, moduleIndex) { case Some(found) => found; case None => return None }
  if !module.generatedStd { return None }
  let binding = standardBoundary(module.identity, name)
  let namespace = match binding.get(0) { case Some(found) => found; case None => return None }
  let member = match binding.get(1) { case Some(found) => found; case None => return None }
  if namespace == "" { return builtinFunctionType(member, "topaz-5.20") }
  builtinNamespaceMemberType(namespace, member, "topaz-5.20")
}

export function generatedLispexIntrinsic(
  state: CheckerState,
  moduleIndex: int,
  name: string,
) -> bool {
  match moduleAt(state, moduleIndex) {
    case Some(module) => if !module.generatedStd {
      false
    } else if standardBoundary(module.identity, name).length == 2 {
      true
    } else if module.identity == "std.typeset" && state.languageMode == "topaz-5.21" {
      name == "__lengthFromScaledPoints" || name == "__lengthFromMilliPoints"
    } else if module.identity == "std.lispex.rules" {
      name == "__lispexRule"
    } else if module.identity == "std.lispex" {
      name == "__lispexValueFromCanonical" ||
        name == "__lispexCanonicalBytes" ||
        name == "__lispexDefaultLimits" ||
        name == "__lispexInspectRule" ||
        name == "__lispexEvaluate" ||
        name == "__lispexEvaluateWithEvidence" ||
        name == "__lispexConsumerArtifactFromBytes" ||
        name == "__lispexConsumerArtifactBytes" ||
        name == "__lispexPortableCoreBytes" ||
        name == "__lispexInspectConsumerArtifact" ||
        name == "__lispexVerifyConsumerArtifact" ||
        name == "__lispexFreshReplay"
    } else {
      false
    }
    case None => false
  }
}

export function contextualGeneratedLispexCall(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  expression: SyntaxNode,
  callee: SyntaxNode,
  actuals: Array<TypeValue>,
) -> Option<TypeValue> {
  if callee.kind != "expression/identifier" ||
    !generatedLispexIntrinsic(state, moduleIndex, text(source, callee)) {
    return None
  }
  if text(source,callee) == "__lengthFromScaledPoints" || text(source,callee) == "__lengthFromMilliPoints" {
    return Some(functionType([primitive("int")],[],lengthType("Pt")))
  }
  let expected = match currentExpectedExpression(state, expression) {
    case Some(found) => found
    case None => return None
  }
  let mut parameters: Array<TypeValue> = []
  for actual in actuals {
    parameters.push(widen(actual))
  }
  Some(functionType(parameters, [], expected))
}

function builtinCallIdentity(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
) -> string {
  match boundBuiltinForCallee(state, moduleIndex, callee) { case Some(bound) => if bound.target != "" { return bound.target }; case None => () }
  let boundary = canonicalBoundaryTarget(state, moduleIndex, source, callee)
  if boundary.length == 2 && boundary[0] == "JSON" && boundary[1] == "parseAs" { return "builtin::JsonParseAs" }
  if state.languageMode == "topaz-5.21" && callee.kind == "expression/member" {
    match child(callee, "field") {
      case Some(field) => if text(source, field) == "decode" {
        match child(callee, "object") { case Some(object) => if serviceInferExpression(service, state, moduleIndex, source, object).kind == "json-value" { return "builtin::JsonDecode" }; case None => () }
      }
      case None => ()
    }
  }
  if callee.kind == "expression/identifier" {
    let name = text(source, callee)
    if generatedLispexIntrinsic(state, moduleIndex, name) {
      return "builtin::{name}"
    }
    if unshadowedIdentifier(state, moduleIndex, callee) {
      match builtinFunctionType(name, state.languageMode) {
        case Some(_) => return "builtin::{name}"
        case None => ()
      }
    }
  }
  if callee.kind == "expression/member" {
    match child(callee, "object") {
      case Some(object) => {
        match userProtocolObject(state, moduleIndex, source, object) {
          case Some(definition) => return "builtin::{definition.name}"
          case None => ()
        }
        if builtinNamespaceObject(
          service,
          state,
          moduleIndex,
          source,
          object,
        ) {
          let name = text(source, object)
          // JSON static operations have no resolved callable declaration.
          // Their member plan and checked types carry the invocation.
          if name == "JSON" { return "" }
          return "builtin::{name}"
        }
      }
      case None => ()
    }
  }
  ""
}

function previewSourceCallArgument(
  source: Bytes,
  argument: SyntaxNode,
  sourceIndex: int,
) -> PreviewCallArgument {
  let value = argumentValue(argument)
  PreviewCallArgument {
    bindingKind: if argument.kind == "call-argument/named" {
      "named"
    } else if argument.kind == "call-argument/spread" {
      "spread"
    } else {
      "positional"
    },
    bindingName: if argument.kind == "call-argument/named" {
      match child(argument, "name") {
        case Some(found) => text(source, found)
        case None => ""
      }
    } else {
      ""
    },
    sourceIndex: Some(sourceIndex),
    lo: value.lo,
    hi: value.hi,
  }
}

function projectedCallIdentity(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
  reference: Option<PreviewResolvedReference>,
) -> string {
  match reference {
    case Some(found) => if found.targetModule == "std.lispex.rules" &&
      found.targetName != "" {
      return "topaz.lispex-rule-handle/v1:{found.targetName}"
    }
    case None => ()
  }
  // A bound JSON boundary keeps its builtin target through module aliases,
  // selected imports and value aliases; the std declaration is only the route.
  match boundBuiltinForCallee(state, moduleIndex, callee) { case Some(bound) => if bound.target != "" { return bound.target }; case None => () }
  let identity = match reference {
    case Some(found) => referenceTargetIdentity(state, found)
    case None => ""
  }
  if identity != "" {
    return identity
  }
  builtinCallIdentity(service, state, moduleIndex, source, callee)
}

record CallFactContext {
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  callee: SyntaxNode,
  calleeType: TypeValue,
  receiverType: TypeValue,
  resultType: TypeValue,
}

record CallArgumentObservation {
  arguments: Array<PreviewCallArgument>,
  evaluations: Array<PreviewCallEvaluation>,
}

record DirectCallProjection {
  field: string,
  calleeType: TypeValue,
  identity: string,
  observation: CallArgumentObservation,
}

function callField(source: Bytes, callee: SyntaxNode) -> string {
  match child(callee, "field") {
    case Some(found) => text(source, found)
    case None => ""
  }
}

function projectedDirectCalleeType(
  context: CallFactContext,
  reference: Option<PreviewResolvedReference>,
) -> TypeValue {
  if context.calleeType.kind != "unknown" {
    return context.calleeType
  }
  match reference {
    case Some(foundReference) => match resolvedTypeFromFact(
      context.state,
      foundReference,
    ) {
      case Some(found) => if found.kind == "unknown" {
        context.calleeType
      } else {
        found
      }
      case None => context.calleeType
    }
    case None => context.calleeType
  }
}

function directCallArguments(
  context: CallFactContext,
  field: string,
) -> CallArgumentObservation {
  let mut arguments: Array<PreviewCallArgument> = []
  let mut evaluations: Array<PreviewCallEvaluation> = [
    PreviewCallEvaluation {
      kind: if field == "" { "callee" } else { "receiver" },
      argumentIndex: -1,
    },
  ]
  if context.callee.kind == "expression/optional-access" {
    evaluations.push(PreviewCallEvaluation {
      kind: "optional-guard",
      argumentIndex: -1,
    })
  }
  let mut sourceIndex = 0
  for argument in children(context.node, "arguments") {
    arguments.push(previewSourceCallArgument(context.source, argument, sourceIndex))
    evaluations.push(PreviewCallEvaluation {
      kind: "argument",
      argumentIndex: sourceIndex,
    })
    sourceIndex += 1
  }
  CallArgumentObservation { arguments: arguments, evaluations: evaluations }
}

function directCallProjection(service: CheckerService, context: CallFactContext) -> DirectCallProjection {
  let field = callField(context.source, context.callee)
  let reference = callableReferenceInNode(
    context.state,
    context.moduleIndex,
    context.callee,
  )
  let receiverIdentity = if field == "" {
    ""
  } else {
    receiverMethodTargetIdentity(
      context.state,
      context.moduleIndex,
      context.receiverType,
      field,
    )
  }
  DirectCallProjection {
    field: field,
    calleeType: projectedDirectCalleeType(context, reference),
    identity: if receiverIdentity != "" {
      receiverIdentity
    } else {
      projectedCallIdentity(
        service,
        context.state,
        context.moduleIndex,
        context.source,
        context.callee,
        reference,
      )
    },
    observation: directCallArguments(context, field),
  }
}

function appendCall(state: CheckerState, value: PreviewTypedCall) -> () {
  let key = spanKey(value.moduleIndex, value.lo, value.hi)
  let mut indexes = state.callIndexes
  match indexes.get(key) {
    case Some(_) => ()
    case None => indexes.insert(key, state.calls.length)
  }
  let mut target = state.calls
  target.push(value)
}

export function addCall(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  callee: SyntaxNode,
  calleeType: TypeValue,
  receiverType: TypeValue,
  resultType: TypeValue,
) -> () {
  let context = CallFactContext {
    state: state,
    moduleIndex: moduleIndex,
    source: source,
    node: node,
    callee: callee,
    calleeType: calleeType,
    receiverType: receiverType,
    resultType: resultType,
  }
  let projected = directCallProjection(service, context)
  appendCall(state, PreviewTypedCall {
    moduleIndex: moduleIndex,
    lo: node.lo,
    hi: node.hi,
    calleeLo: callee.lo,
    calleeHi: callee.hi,
    calleeType: flattenType(projected.calleeType),
    resultType: flattenType(context.resultType),
    targetIdentity: projected.identity,
    ambient: hasHole(projected.calleeType) || hasHole(context.resultType),
    calleeKind: if projected.field == "" { "value" } else { "member" },
    method: projected.field,
    methodClass: if projected.field == "" {
      ""
    } else {
      callMethodClass(projected.field)
    },
    optional: callee.kind == "expression/optional-access",
    shadowFirst: projected.field == "mapErr" || projected.field == "map" || projected.field == "filter" ||
      projected.field == "reduce" || projected.field == "flatMap" ||
      projected.field == "okOrElse",
    stageMethod: "",
    arguments: projected.observation.arguments,
    evaluations: projected.observation.evaluations,
  })
}

export function containsPlaceholder(node: SyntaxNode) -> bool {
  if node.kind == "expression/placeholder" {
    return true
  }
  if node.kind == "expression/pipe" {
    return match child(node, "left") {
      case Some(left) => containsPlaceholder(left)
      case None => false
    }
  }
  for nested in node.children {
    if containsPlaceholder(nested) {
      return true
    }
  }
  false
}

export function currentPipeValue(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
) -> TypeValue {
  match state.pipeValues.get(state.pipeValues.length - 1) {
    case Some(found) => match found.values.get(0) {
      case Some(value) => value
      case None => {
        // A callee can demand the saved input before argument inference. Infer
        // it once, with the enclosing pipe exposed for placeholders in its lhs.
        // A placeholder inside a callback must not lend its callable context
        // to the input. Slice the stacks at the pipe's lexical boundary; keep
        // the enclosing return-join arrays shared so its returns reach their owner.
        let inputState = CheckerState {
          ...state,
          activeFunctions: state.activeFunctions.slice(0, found.activeFunctionDepth),
          expectedReturns: state.expectedReturns.slice(0, found.returnDepth),
          returnJoins: state.returnJoins.slice(0, found.returnDepth),
          expectedExpressions: state.expectedExpressions.slice(0, found.expectedExpressionDepth),
          diagnostics: [],
        }
        let mut pipeValues = state.pipeValues
        pipeValues.pop()
        let value = match currentExpectedExpression(state, node) {
          case Some(expected) => inferExpressionWithResultContext(
            service, inputState, found.moduleIndex, source, found.node,
            expected, true, false)
          case None => serviceInferExpression(
            service, inputState, found.moduleIndex, source, found.node)
        }
        let mut values = found.values
        values.push(value)
        pipeValues.push(found)
        // Saved input diagnostics precede any stage diagnostics already queued.
        let mut diagnostics = found.diagnostics
        let mut index = 0
        for diagnostic in inputState.diagnostics {
          diagnostics.insert(index, diagnostic)
          index += 1
        }
        value
      }
    }
    case None => {
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5001",
        "a placeholder `_` is valid only inside a pipeline stage (§11)",
        "",
        node,
      )
      emptyType("unknown")
    }
  }
}

record PipeCallContext {
  call: CallFactContext,
  left: SyntaxNode,
  stage: SyntaxNode,
  hasPlaceholder: bool,
}

record PipeCallProjection {
  identity: string,
  stageMethod: string,
  observation: CallArgumentObservation,
}

function pipeCallArguments(context: PipeCallContext) -> CallArgumentObservation {
  let call = context.call
  let mut arguments: Array<PreviewCallArgument> = []
  let mut sourceIndex = 0
  let missingSourceIndex: Option<int> = None
  if context.stage.kind == "expression/call" {
    for argument in children(context.stage, "arguments") {
      arguments.push(previewSourceCallArgument(
        call.source,
        argument,
        sourceIndex,
      ))
      sourceIndex += 1
    }
    if !context.hasPlaceholder {
      arguments.insert(0, PreviewCallArgument {
        bindingKind: "inserted-lead",
        bindingName: "",
        sourceIndex: missingSourceIndex,
        lo: context.left.lo,
        hi: context.left.hi,
      })
    }
  } else {
    arguments.push(PreviewCallArgument {
      bindingKind: "inserted-lead",
      bindingName: "",
      sourceIndex: missingSourceIndex,
      lo: context.left.lo,
      hi: context.left.hi,
    })
  }
  let mut evaluations: Array<PreviewCallEvaluation> = [
    PreviewCallEvaluation {
      kind: if context.hasPlaceholder { "pipe-lead" } else { "argument" },
      argumentIndex: if context.hasPlaceholder { -1 } else { 0 },
    },
    PreviewCallEvaluation {
      kind: "receiver",
      argumentIndex: -1,
    },
  ]
  if call.callee.kind == "expression/optional-access" {
    evaluations.push(PreviewCallEvaluation {
      kind: "optional-guard",
      argumentIndex: -1,
    })
  }
  let mut argumentIndex = 0
  while argumentIndex < arguments.length {
    if context.hasPlaceholder || argumentIndex != 0 {
      evaluations.push(PreviewCallEvaluation {
        kind: "argument",
        argumentIndex: argumentIndex,
      })
    }
    argumentIndex += 1
  }
  CallArgumentObservation { arguments: arguments, evaluations: evaluations }
}

function pipeCallProjection(service: CheckerService, context: PipeCallContext) -> PipeCallProjection {
  let call = context.call
  let reference = callableReferenceInNode(
    call.state,
    call.moduleIndex,
    call.callee,
  )
  let stageMethod = match child(call.callee, "field") {
    case Some(found) => text(call.source, found)
    case None => ""
  }
  let receiverIdentity = if stageMethod == "" {
    ""
  } else {
    receiverMethodTargetIdentity(
      call.state,
      call.moduleIndex,
      call.receiverType,
      stageMethod,
    )
  }
  PipeCallProjection {
    identity: if receiverIdentity != "" {
      receiverIdentity
    } else {
      projectedCallIdentity(
        service,
        call.state,
        call.moduleIndex,
        call.source,
        call.callee,
        reference,
      )
    },
    stageMethod: stageMethod,
    observation: pipeCallArguments(context),
  }
}

export function addPipeCall(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  left: SyntaxNode,
  stage: SyntaxNode,
  callee: SyntaxNode,
  calleeType: TypeValue,
  receiverType: TypeValue,
  resultType: TypeValue,
  hasPlaceholder: bool,
) -> () {
  let context = PipeCallContext {
    call: CallFactContext {
      state: state,
      moduleIndex: moduleIndex,
      source: source,
      node: node,
      callee: callee,
      calleeType: calleeType,
      receiverType: receiverType,
      resultType: resultType,
    },
    left: left,
    stage: stage,
    hasPlaceholder: hasPlaceholder,
  }
  let projected = pipeCallProjection(service, context)
  appendCall(state, PreviewTypedCall {
    moduleIndex: moduleIndex,
    lo: node.lo,
    hi: node.hi,
    calleeLo: stage.lo,
    calleeHi: stage.hi,
    calleeType: flattenType(calleeType),
    resultType: flattenType(resultType),
    targetIdentity: projected.identity,
    ambient: hasHole(calleeType) || hasHole(resultType),
    calleeKind: "pipe",
    method: "",
    methodClass: "",
    optional: context.call.callee.kind == "expression/optional-access",
    shadowFirst: false,
    stageMethod: projected.stageMethod,
    arguments: projected.observation.arguments,
    evaluations: projected.observation.evaluations,
  })
}

function replaceCallResultType(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  resultType: TypeValue,
) -> () {
  let mut calls = state.calls
  match state.callIndexes.get(spanKey(moduleIndex, node.lo, node.hi)) {
    case Some(index) => match calls.get(index) {
      case Some(call) => {
        let nextCalleeType = if call.targetIdentity == "builtin::Map" &&
          call.method == "new" {
          flattenType(functionType([], [], resultType))
        } else {
          call.calleeType
        }
        calls[index] = PreviewTypedCall {
          moduleIndex: call.moduleIndex,
          lo: call.lo,
          hi: call.hi,
          calleeLo: call.calleeLo,
          calleeHi: call.calleeHi,
          calleeType: nextCalleeType,
          resultType: flattenType(resultType),
          targetIdentity: call.targetIdentity,
          ambient: flattenedHasHole(nextCalleeType) || hasHole(resultType),
          calleeKind: call.calleeKind,
          method: call.method,
          methodClass: call.methodClass,
          optional: call.optional,
          shadowFirst: call.shadowFirst,
          stageMethod: call.stageMethod,
          arguments: call.arguments,
          evaluations: call.evaluations,
        }
      }
      case None => ()
    }
    case None => ()
  }
  ()
}

function isBuiltinMapNewCall(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
) -> bool {
  match state.callIndexes.get(spanKey(moduleIndex, node.lo, node.hi)) {
    case Some(index) => match state.calls.get(index) {
      case Some(call) => call.targetIdentity == "builtin::Map" &&
        call.method == "new"
      case None => false
    }
    case None => false
  }
}

export function inferExpressionContext(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  expression: SyntaxNode,
) -> TypeValue {
  let mut contexts = state.literalJoinContexts
  contexts.push(expression.lo)
  let result = serviceInferExpression(service, state, moduleIndex, source, expression)
  contexts.pop()
  result
}

export function reportExpectedType(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  expected: TypeValue,
  actual: TypeValue,
) -> () {
  if !hasHole(expected) && !hasHole(actual) &&
    !assignable(expected, actual) {
    let shown = if expected.kind == "primitive" {
      widen(actual)
    } else {
      actual
    }
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5001",
      "expected `{typeText(expected)}`, found `{typeText(shown)}`",
      "",
      node,
    )
  }
}

export function checkExpressionExpected(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  expected: TypeValue,
) -> TypeValue {
  checkExpressionExpectedResult(service, state, moduleIndex, source,
    node, expected, false, true)
}

// Parentheses carry a type but the enclosed value owns a mismatch's source span.
export function expressionResultNode(node: SyntaxNode) -> SyntaxNode {
  if node.kind == "expression/parenthesized" {
    match child(node, "operand") { case Some(inner) => return expressionResultNode(inner); case None => () }
  }
  node
}

// A block's tail already owns its comparison. Branch joins retain their own result.
export function expressionResultIsDelegated(node: SyntaxNode) -> bool {
  let value = expressionResultNode(node)
  if value.kind != "expression/block" { return false }
  match child(value, "block") {
    case Some(block) => match child(block, "tail") { case Some(_) => true; case None => false }
    case None => false
  }
}

export function checkExpressionExpectedResult(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  expected: TypeValue,
  contextual: bool,
  checkResult: bool,
) -> TypeValue {
  let inferred = inferExpressionWithResultContext(
    service,
    state,
    moduleIndex,
    source,
    node,
    expected,
    contextual,
    checkResult,
  )
  if !checkResult { return inferred }
  let refined = refineExpressionToExpected(
    state,
    moduleIndex,
    node,
    inferred,
    expected,
  )
  if !expressionResultIsDelegated(node) {
    reportExpectedType(state, moduleIndex, expressionResultNode(node), expected, refined)
  }
  refined
}

export function isImportNamespace(state: CheckerState, moduleIndex: int, name: string) -> bool {
  match state.namespaceImportIndexes.get(definitionNameKey(moduleIndex, name)) {
    case Some(_) => true
    case None => false
  }
}

function removedStaticValueIsVisible(
  state: CheckerState, reference: PreviewResolvedReference,
) -> bool {
  if reference.targetModuleIndex < 0 || reference.targetNamespace != "value" {
    return false
  }
  let declaration = match declarationFor(state, reference.targetModuleIndex,
    reference.targetLo, reference.targetHi) {
    case Some(found) => found
    case None => return false
  }
  // Local lets/consts resolve after their initializer; parameters and pattern
  // bindings resolve inside their scope. Functions hoist in every scope, and
  // selected imports are bound before checking the importing module's items.
  if declaration.scopeOrdinal != 0 || declaration.moduleIndex != reference.moduleIndex ||
    (declaration.declarationKind != "let" && declaration.declarationKind != "const") {
    return true
  }
  let module = match moduleAt(state, reference.moduleIndex) {
    case Some(found) => found
    case None => return false
  }
  let mut bindingEnd = -1
  let mut inConst = false
  for statement in module.root.children {
    let item = unwrapExport(statement)
    if item.lo <= declaration.lo && declaration.hi <= item.hi {
      bindingEnd = item.hi
    }
    if item.lo <= reference.lo && reference.hi <= item.hi {
      inConst = item.kind == "statement/const"
    }
  }
  // Rust checks module constants first, in textual order: they see earlier
  // constants but no module lets. Ordinary items see every module constant.
  if declaration.declarationKind == "const" && !inConst { return true }
  if declaration.declarationKind == "let" && inConst { return false }
  // Use the whole declaration, not its name: a let is absent in its own
  // initializer, including a lambda or block nested inside that initializer.
  bindingEnd >= 0 && bindingEnd <= reference.lo
}

// Removed calls stop before generic solving, so one migration diagnostic owns the refusal.
export function reportRemovedStaticMember(
  state: CheckerState, moduleIndex: int, source: Bytes, node: SyntaxNode,
) -> bool {
  if state.languageMode != "topaz-5.21" || node.kind != "expression/member" { return false }
  let object = match child(node, "object") { case Some(found) => found; case None => return false }
  if object.kind != "expression/identifier" { return false }
  let field = match child(node, "field") { case Some(found) => found; case None => return false }
  let namespace = text(source, object)
  let member = text(source, field)
  let hint = removedStaticHint(namespace, member)
  if hint == "" { return false }
  // Namespace member resolution records the field, not the head identifier.
  // The import index covers std and user modules even without a head reference.
  if isImportNamespace(state, moduleIndex, namespace) { return false }
  match referenceFor(state, moduleIndex, object.lo, object.hi) {
    case Some(reference) => {
      if removedStaticValueIsVisible(state, reference) { return false }
      // Selected imports retain the target nominal's identity under their alias.
      // A future value binding with a nominal type is still not in scope.
      if reference.targetNamespace == "type" {
        match referenceTargetType(state, moduleIndex, object) {
          case Some(found) => if found.kind == "nominal-record" ||
            found.kind == "enum" || found.kind == "newtype" { return false }
          case None => ()
        }
      }
    }
    case None => ()
  }
  if namespace != "JSON" {
    match userProtocolObject(state, moduleIndex, source, object) {
      case Some(_) => return false
      case None => ()
    }
  }
  addDiagnostic(state, moduleIndex, "TPZ5002",
    "`{namespace}.{member}` was removed in 5.21; {hint}", "", field)
  true
}

export function builtinNamespaceObject(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  object: SyntaxNode,
) -> bool {
  if object.kind != "expression/identifier" ||
    !isBuiltinNamespace(text(source, object)) ||
    state.languageMode == "topaz-5.21" && text(source, object) == "Math" {
    return false
  }
  match referenceFor(state, moduleIndex, object.lo, object.hi) {
    case Some(reference) => reference.targetModuleIndex < 0 ||
      reference.targetNamespace == "type" &&
      match referenceTargetType(state, moduleIndex, object) {
        case Some(_) => false
        case None => true
      }
    case None => true
  }
}

export function userProtocolObject(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  object: SyntaxNode,
) -> Option<ProtocolDefinition> {
  if object.kind != "expression/identifier" {
    return None
  }
  match referenceFor(state, moduleIndex, object.lo, object.hi) {
    case Some(reference) => {
      let name = if reference.targetName == "" {
        text(source, object)
      } else {
        reference.targetName
      }
      if reference.targetNamespace == "type" {
        return protocolDefinition(state, reference.targetModuleIndex, name)
      }
      if reference.targetModuleIndex < 0 && reference.namespace == "value" {
        return protocolDefinition(state, moduleIndex, name)
      }
      None
    }
    case None => protocolDefinition(state, moduleIndex, text(source, object))
  }
}

export function unshadowedIdentifier(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
) -> bool {
  if node.kind != "expression/identifier" {
    return false
  }
  match referenceFor(state, moduleIndex, node.lo, node.hi) {
    case Some(reference) => reference.targetModuleIndex < 0
    case None => true
  }
}

function suppressExpressionObservation(
  state: CheckerState,
  source: Bytes,
  node: SyntaxNode,
) -> bool {
  let suppressStatementFor = if node.kind == "expression/for" &&
    state.statementExpressionContexts.length > 0 {
    match state.statementExpressionContexts.get(
      state.statementExpressionContexts.length - 1,
    ) {
      case Some(lo) => lo == node.lo
      case None => false
    }
  } else {
    false
  }
  let suppressBuiltinNamespace = node.kind == "expression/identifier" &&
    (text(source, node) == "Bytes" || text(source, node) == "JSON")
  suppressStatementFor || suppressBuiltinNamespace
}

export function recordInferredExpression(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  result: TypeValue,
) -> () {
  if result.kind != "unknown" &&
    !suppressExpressionObservation(state, source, node) {
    addNode(state, moduleIndex, "expression", node, result)
  }
}

export function refineExpressionToExpected(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  inferred: TypeValue,
  expected: TypeValue,
) -> TypeValue {
  if node.kind == "expression/record-literal" &&
    inferred.kind == "record" &&
    expected.kind == "record" &&
    assignable(expected, inferred) {
    replaceNodeType(state, moduleIndex, "expression", node, expected)
    return expected
  }
  let contextualBuiltinConstructor = node.kind == "expression/call" &&
    isBuiltinMapNewCall(state, moduleIndex, node)
  if (hasHole(inferred) || contextualBuiltinConstructor) &&
    !hasHole(expected) &&
    (inferred.kind == "unknown" ||
    (inferred.kind == expected.kind && inferred.name == expected.name)) {
    replaceNodeType(state, moduleIndex, "expression", node, expected)
    if node.kind == "expression/call" {
      replaceCallResultType(state, moduleIndex, node, expected)
      if contextualBuiltinConstructor {
        match child(node, "callee") {
          case Some(callee) => replaceNodeType(
            state,
            moduleIndex,
            "expression",
            callee,
            functionType([], [], expected),
          )
          case None => ()
        }
      }
    }
    expected
  } else {
    inferred
  }
}
