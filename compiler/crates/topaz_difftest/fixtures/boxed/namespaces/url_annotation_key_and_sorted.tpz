let same = match URL.parse("https://example.com/b") { case Ok(k) => m.getOr(k, 0)
case Err(_) => 0 }
let first = [x, a].sorted().get(0)
match first { case Some(u0) => "{same}/{u0.toString()}"
case None => "none" } }
case Err(e) => e }
case Err(e) => e }