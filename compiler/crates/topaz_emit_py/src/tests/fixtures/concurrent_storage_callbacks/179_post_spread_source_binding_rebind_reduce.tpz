
function add(acc: int, x: int) -> int {
    acc + x
}

function sub(acc: int, x: int) -> int {
    acc - x
}

function mul(acc: int, x: int) -> int {
    acc * x
}

let mut base = [add, sub]
let callbacks = [...base, mul]
base = [mul, add]

let r = concurrent {
    slow: {
        let xs = [1, 2, 3]
        xs.reduce(10, callbacks[1])
    }
    fast: 0
}
r.slow + r.fast
