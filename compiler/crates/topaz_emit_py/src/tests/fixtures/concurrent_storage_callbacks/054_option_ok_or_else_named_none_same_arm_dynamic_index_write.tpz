
function codeSix() -> int {
    6
}

function codeFour() -> int {
    4
}

function codeZero() -> int {
    0
}

let seeds = [0, 1]
let i = seeds[1]

concurrent {
    slow: {
        let mut cbs = [codeZero, codeFour]
        cbs[i] = codeSix
        let value: Option<int> = None
        let out = value.okOrElse(f: cbs[i])
        match out {
            case Ok(_) => -1
            case Err(code) => code
        }
    }
    fast: 0
}
0
