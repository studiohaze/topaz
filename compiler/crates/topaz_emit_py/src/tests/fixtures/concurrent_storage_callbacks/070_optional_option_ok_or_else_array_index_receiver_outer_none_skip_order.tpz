
function codeSix() -> int {
    6
}

function codeFour() -> int {
    4
}

function codeZero() -> int {
    0
}

function main() -> int {
    let mut order = 0

    function tick(label: int, value: int) -> int {
        order = order * 10 + label
        value
    }

    let r = concurrent {
        slow: {
            let mut cbs = [codeZero, codeFour]
            let i = 1
            cbs[i] = codeSix
            let values: Array<Option<Option<int>>> = [Some(None), None]
            let out = values[tick(1, i)]?.okOrElse(cbs[tick(2, i)])
            order * 100 + 7
        }
        fast: 0
    }
    r.slow + r.fast
}

main()
