
function someDbl(x: int) -> Option<int> {
    Some(x * 2)
}

function someInc(x: int) -> Option<int> {
    Some(x + 1)
}

function someZero(x: int) -> Option<int> {
    Some(0)
}

function choose(i: int) -> int {
    let r = concurrent {
        slow: {
            let mut cbs = [someZero, someInc]
            let mut out = -9
            let mut n = 0
            while n < 1 {
                cbs[i] = someDbl
                let mapped = Some(3).flatMap(f: cbs[i])
                out = match mapped {
                    case Some(value) => value
                    case None => -3
                }
                n = n + 1
            }
            out
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(1)
