
function dbl(x: int) -> int {
    x * 2
}

function inc(x: int) -> int {
    x + 1
}

function zero(x: int) -> int {
    0
}

function choose(i: int) -> int {
    let r = concurrent {
        slow: {
            let mut cbs = [zero, inc]
            match i {
                case 0 => -1
                case 1 => {
                    cbs[i] = dbl
                    let out = Ok(3).map(cbs[i])
                    match out {
                        case Ok(n) => n
                        case Err(_) => -3
                    }
                }
                case _ => -2
            }
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(1)
