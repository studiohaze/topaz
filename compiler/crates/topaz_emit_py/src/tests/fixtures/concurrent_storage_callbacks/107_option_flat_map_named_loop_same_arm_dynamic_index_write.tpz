
function someDbl(x: int) -> Option<int> {
    Some(x * 2)
}

function someInc(x: int) -> Option<int> {
    Some(x + 1)
}

function someZero(x: int) -> Option<int> {
    Some(0)
}

function choose(i: int) -> int {
    let r = concurrent {
        slow: {
            let mut cbs = [someZero, someInc]
            loop {
                cbs[i] = someDbl
                let out = Some(3).flatMap(f: cbs[i])
                break match out {
                    case Some(n) => n
                    case None => -3
                }
            }
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(1)
