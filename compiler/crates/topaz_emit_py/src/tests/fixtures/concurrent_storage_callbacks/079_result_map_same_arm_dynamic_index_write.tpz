
function dbl(x: int) -> int {
    x * 2
}

function inc(x: int) -> int {
    x + 1
}

function zero(x: int) -> int {
    0
}

function choose(x: int) -> int {
    let i = x - 2
    concurrent {
        slow: {
            let mut cbs = [zero, inc]
            cbs[i] = dbl
            let out = Ok(x).map(cbs[i])
            match out {
                case Ok(n) => n
                case Err(_) => -1
            }
        }
        fast: 0
    }
    0
}

choose(3)
