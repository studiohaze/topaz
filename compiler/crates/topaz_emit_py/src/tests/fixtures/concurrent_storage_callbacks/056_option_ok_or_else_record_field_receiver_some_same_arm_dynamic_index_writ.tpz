
function boom() -> int {
    let n = 0
    1 / n
}

function six() -> int {
    6
}

function choose(x: int) -> int {
    let i = x - 2
    let r = concurrent {
        slow: {
            let mut cbs = [six, six]
            cbs[i] = boom
            let value: Option<int> = Some(9)
            let holder = { opt: value }
            let out = holder.opt.okOrElse(cbs[i])
            match out {
                case Ok(v) => v
                case Err(code) => code
            }
        }
        fast: 0
    }
    r.slow + r.fast
}

choose(3)
