
function dbl(x: int) -> int {
    x * 2
}

function inc(x: int) -> int {
    x + 1
}

function zero(x: int) -> int {
    0
}

function choose(i: int) -> int {
    concurrent {
        slow: {
            let mut cbs = [zero, inc]
            let mut out = [0]
            let mut n = 0
            while n < 1 {
                cbs[i] = dbl
                let xs = [1, 2, 3]
                out = xs.map(cbs[i])
                n = n + 1
            }
            out
        }
        fast: 0
    }
    0
}

choose(1)
