// ATLAS break-opportunity classifier (kinsoku / 금칙) — Topaz port (PoC).
// Pure, deterministic: clusters (one per line) -> break opportunities ("<unit_end> <kind>").
// Mirrors /root/atlas/core/typesetting/src/vnext_paragraph.rs build_break_opportunities + predicates.

function firstCp(t: string) -> int { t.codePointAt(0) ?? -1 }
function singleScalar(t: string) -> bool { t.scalars().length == 1 }

// ── char-class predicates over a single code point ──
function isKoreanBreakChar(c: int) -> bool {
  (c >= 4352 && c <= 4607)        // U+1100..U+11FF  Hangul Jamo
  || (c >= 12592 && c <= 12687)   // U+3130..U+318F  Hangul Compatibility Jamo
  || (c >= 44032 && c <= 55215)   // U+AC00..U+D7AF  Hangul Syllables
  || (c >= 13312 && c <= 19903)   // U+3400..U+4DBF  CJK Ext A
  || (c >= 19968 && c <= 40959)   // U+4E00..U+9FFF  CJK Unified
  || (c >= 63744 && c <= 64255)   // U+F900..U+FAFF  CJK Compat
  || c == 65292 || c == 12289 || c == 12290 || c == 65307 || c == 65306  // ， 、 。 ； ：
}
function isLineStartForbidden(c: int) -> bool {
  c == 41 || c == 93 || c == 125          // ) ] }
  || c == 12301 || c == 12303 || c == 12299 || c == 12297  // 」 』 》 〉
  || c == 44 || c == 46 || c == 59 || c == 58 || c == 33 || c == 63  // , . ; : ! ?
  || c == 12289 || c == 12290            // 、 。
}
function isLineEndForbidden(c: int) -> bool {
  c == 40 || c == 91 || c == 123          // ( [ {
  || c == 12300 || c == 12302 || c == 12298 || c == 12296  // 「 『 《 〈
}

// ── all/any over a cluster's scalars (empty -> all=true, any=false, matching Rust) ──
function allKoreanBreak(t: string) -> bool {
  let mut ok = true
  for s in t.scalars() { if !isKoreanBreakChar(firstCp(s)) { ok = false } }
  ok
}
function allLineStartForbidden(t: string) -> bool {
  let mut ok = true
  for s in t.scalars() { if !isLineStartForbidden(firstCp(s)) { ok = false } }
  ok
}
function anyLineStartForbidden(t: string) -> bool {
  let mut found = false
  for s in t.scalars() { if isLineStartForbidden(firstCp(s)) { found = true } }
  found
}
function anyLineEndForbidden(t: string) -> bool {
  let mut found = false
  for s in t.scalars() { if isLineEndForbidden(firstCp(s)) { found = true } }
  found
}

// ── whole-string predicates (single-scalar equality, mirroring `matches!`) ──
function isBreakableLatinSpace(t: string) -> bool { singleScalar(t) && firstCp(t) == 32 }
function isLatinSpace(t: string) -> bool { singleScalar(t) && (firstCp(t) == 32 || firstCp(t) == 160) }
function isNoBreakWhitespace(t: string) -> bool { singleScalar(t) && (firstCp(t) == 160 || firstCp(t) == 8239) }
function isLatinHyphen(t: string) -> bool {
  singleScalar(t) && (firstCp(t) == 45 || firstCp(t) == 8208 || firstCp(t) == 8209 || firstCp(t) == 8211)
}
function isCommaDotColon(t: string) -> bool { singleScalar(t) && (firstCp(t) == 44 || firstCp(t) == 46 || firstCp(t) == 58) }
function isAsciiDigit(t: string) -> bool { t.byteLength() == 1 && firstCp(t) >= 48 && firstCp(t) <= 57 }

// ── Option<&str> neighbor guards (map_or(true,..) / is_some_and(..)) ──
function nextNotLatinSpace(next: Option<string>) -> bool {
  match next {
    case Some(t) => !isLatinSpace(t)
    case None => true
  }
}
function nextNoLineStartForbidden(next: Option<string>) -> bool {
  match next {
    case Some(t) => !anyLineStartForbidden(t)
    case None => true
  }
}
function optIsLatinSpace(next: Option<string>) -> bool {
  match next {
    case Some(t) => isLatinSpace(t)
    case None => false
  }
}
function optAnyLineStartForbidden(next: Option<string>) -> bool {
  match next {
    case Some(t) => anyLineStartForbidden(t)
    case None => false
  }
}
function optIsAsciiDigit(o: Option<string>) -> bool {
  match o {
    case Some(t) => isAsciiDigit(t)
    case None => false
  }
}

function isNumericSep(current: string, prev: Option<string>, next: Option<string>) -> bool {
  isCommaDotColon(current) && optIsAsciiDigit(prev) && optIsAsciiDigit(next)
}
function isClosingPunctAllowed(current: string, prev: Option<string>, next: Option<string>) -> bool {
  allLineStartForbidden(current) && nextNotLatinSpace(next) && !isNumericSep(current, prev, next)
}
function isKoreanBreakAllowed(current: string, next: Option<string>) -> bool {
  allKoreanBreak(current) && nextNotLatinSpace(next) && nextNoLineStartForbidden(next) && !anyLineEndForbidden(current)
}

function classify(clusters: Array<string>) -> string {
  let n = clusters.length
  let mut out = ""
  let mut i = 0
  while i < n {
    let unit = clusters[i]
    let unitEnd = i + 1
    let prev: Option<string> = if i > 0 { clusters.get(i - 1) } else { None }
    let next = clusters.get(unitEnd)
    let mut kind = ""
    let mut emit = true
    if unitEnd == n { kind = "forced_end" }
    else if isBreakableLatinSpace(unit) { kind = "latin_space" }
    else if isLatinHyphen(unit) { kind = "latin_hyphen" }
    else if isClosingPunctAllowed(unit, prev, next) { kind = "closing_punctuation" }
    else if isKoreanBreakAllowed(unit, next) { kind = "korean_cluster" }
    else if optIsLatinSpace(next) || isNoBreakWhitespace(unit) || optAnyLineStartForbidden(next) { emit = false }
    else { kind = "hard_fallback" }
    if emit { out = if out == "" { "{unitEnd} {kind}" } else { "{out}\n{unitEnd} {kind}" } }
    i = i + 1
  }
  out
}

print(classify(input().split("\n")))
