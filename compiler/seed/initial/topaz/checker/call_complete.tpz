}

function unsolvedCallExpectation(
  value: TypeValue,
  parameters: Array<TypeValue>,
) -> Option<TypeValue> {
  for parameter in parameters {
    if typeEqual(value, parameter) {
    // A generic parameter is a pass-through inference context. An unannotated
    // callable parameter is an actual unknown expectation and cannot solve a
    // polymorphic constructor's missing type argument.
      return Some(TypeValue {
        ...emptyType("unknown"),
        origin: "generic-call-expectation",
        value: typeBindingKey(parameter),
      })
    }
  }
  None
}

export function callArgumentInferenceContext(
  expected: TypeValue,
  parameters: Array<TypeValue>,
) -> TypeValue {
  transformTypeComponents(
    expected,
    (value: TypeValue) => unsolvedCallExpectation(value, parameters),
  )
}

function restoreCallArgumentSchemeVariables(
  actual: TypeValue,
  parameters: Array<TypeValue>,
) -> TypeValue {
  // check_expr(Array) can return its partial expectation. Such a component
  // is the original scheme variable, not new Unknown evidence for that slot.
  transformTypeComponents(actual, (component: TypeValue) => {
    if component.kind == "unknown" && component.origin == "generic-call-expectation" {
      for parameter in parameters {
        if component.value == typeBindingKey(parameter) { return Some(parameter) }
      }
    }
    None
  })
}

export function inferContextualCallArgument(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  expected: Option<TypeValue>,
  checkResult: bool = true,
) -> TypeValue {
  if node.kind == "expression/parenthesized" {
    match child(node, "operand") {
      case Some(operand) => {
        let inferred = inferContextualCallArgument(service, state, moduleIndex, source, operand, expected, checkResult)
        addNode(state, moduleIndex, "expression", node, inferred)
        return inferred
      }
      case None => ()
    }
  }
  match expected {
    case Some(context) => {
      if node.kind == "expression/lambda" && context.kind == "function" {
        let inferred = inferLambda(service, state, moduleIndex, source, node, Some(context))
        addNode(state, moduleIndex, "expression", node, inferred)
        return inferred
      }
      if context.kind == "function" {
        match calleeReference(state, moduleIndex, node) {
          case Some(reference) => match functionDefinitionForReference(state, reference) {
            case Some(definition) => if definition.typeParameters.length > 0 {
              let declared = serviceInferExpression(service, state, moduleIndex, source, node)
              return specializeGenericFunctionValue(state, moduleIndex, node, declared, context)
            }
            case None => ()
          }
          case None => ()
        }
      }
      inferExpressionWithResultContext(service, state, moduleIndex, source, node, context, true, checkResult)
    }
    case None => serviceInferExpression(service, state, moduleIndex, source, node)
  }
}

// Temporarily transport, then restore, every diagnostic in the call's owner order.
function takeCallDiagnostics(state: CheckerState, start: int) -> Array<PreviewCheckDiagnostic> {
  let mut result: Array<PreviewCheckDiagnostic> = []
  let mut index = start
  let mut diagnostics = state.diagnostics
  while index < diagnostics.length { result.push(diagnostics[index]); index += 1 }
  while diagnostics.length > start { diagnostics.pop() }
  result
}

export function inferCallArguments(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  preparation: CallPreparation,
) -> InferredCallArguments {
  let callee = preparation.callee
  let calleeType = preparation.declaredType
  let argumentSlots = preparation.argumentPlan.slots
  let mut inferredTypes: Array<TypeValue> = []
  let mut inferredNodes: Array<SyntaxNode> = []
  let mut contextualActuals: Array<TypeValue> = []
  let mut argumentBindings = preparation.bindings
  while contextualActuals.length < preparation.contextualType.parameters.length {
    contextualActuals.push(emptyType("unknown"))
  }
  let arguments = children(node, "arguments")
  let mut argumentDiagnostics: Array<Array<PreviewCheckDiagnostic>> = []
  let mut deferred: Array<bool> = []
  let mut order: Array<int> = []
  let mut index = 0
  for argument in arguments {
    order.push(index)
    argumentDiagnostics.push([])
    deferred.push(needsInwardCallContext(state, moduleIndex, source, argumentValue(argument), None))
    inferredTypes.push(emptyType("unknown"))
    inferredNodes.push(argumentValue(argument))
    index += 1
  }
  let protocol = match preparation.userProtocolTarget {
    case Some(_) => true
    case None => false
  }
  let mut conformance = if protocol { "pending" } else { "not-protocol" }
  if protocol && preparation.argumentPlan.resultUnknown {
    conformance = "invalid"
  } else if protocol && (arguments.length == 0 || preparation.argumentPlan.leadingSlot == 0) {
    let observed = InferredCallArguments {
      types: inferredTypes, nodes: inferredNodes, protocolConformance: conformance,
    }
    conformance = userProtocolCallConformance(state, moduleIndex, preparation, observed)
    gateUserProtocolCall(state, moduleIndex, preparation, observed, conformance)
  }
  // Type dependencies follow parameter slots. The call's evaluation plan
  // continues to preserve the source order of argument effects.
  order.sortBy((position: int) => match argumentSlots.get(position) {
    case Some(slot) => if slot >= 0 { slot } else { calleeType.parameters.length }
    case None => calleeType.parameters.length
  })
  // Each preparation pass consumes fixed slots, then spread evidence, then
  // scalar tail evidence (stage0 apply_scheme_result). A later source spread
  // must solve its scheme variables before an earlier scalar is checked.
  // Keep this separate from diagnostic replay and saved-placeholder selection.
  let mut evidenceOrder = order.map((position: int) => position)
  evidenceOrder.sortBy((position: int) => match argumentSlots.get(position) {
    case Some(slot) => if slot >= 0 { slot } else if slot == -1 &&
      arguments[position].kind == "call-argument/spread" {
      calleeType.parameters.length
    } else { calleeType.parameters.length + 1 }
    case None => calleeType.parameters.length + 1
  })
  let frame = match state.pipeValues.get(state.pipeValues.length - 1) {
    case Some(found) => if found.moduleIndex == moduleIndex && found.stage.lo == node.lo && found.stage.hi == node.hi { Some(found) } else { None }
    case None => None
  }
  // A placeholder can receive the saved input after an earlier fixed seed.
  // Admit independent evidence from those earlier slots before inferring the
  // saved callback. Do not reschedule later slots or variadic tails: each
  // argument still owns the substitution available at its original check.
  let mut placeholderSlot = calleeType.parameters.length
  if match frame { case Some(_) => true; case None => false } &&
    match preparation.leading { case Some(_) => false; case None => true } {
    for position in order {
      let slot = argumentSlots[position]
      if slot >= 0 && containsPlaceholder(argumentValue(arguments[position])) &&
        slot < placeholderSlot { placeholderSlot = slot }
    }
    for position in order {
      let slot = argumentSlots[position]
      if slot >= 0 && slot < placeholderSlot {
        let argument = arguments[position]
        let expected = callArgumentExpectedType(
          applyBindings(preparation.contextualType, argumentBindings), argument, slot)
        deferred[position] = needsInwardCallContext(state, moduleIndex, source,
          argumentValue(argument), expected)
      }
    }
  }
  let deferLeading = match frame {
    case Some(saved) => needsInwardCallContext(state, moduleIndex, source, saved.node, None)
    case None => false
  }
  let mut leadingDiagnostics: Array<PreviewCheckDiagnostic> = []
  let mut leadingCheckDiagnostics: Array<PreviewCheckDiagnostic> = []
  for dependent in [false, true] {
    match frame {
      case Some(saved) => if deferLeading == dependent {
        let diagnosticStart = state.diagnostics.length
        let mut expected: Option<TypeValue> = None
        match preparation.leading {
          case Some(_) => { expected = callSlotExpectedType(applyBindings(preparation.contextualType, argumentBindings), preparation.argumentPlan.leadingSlot, false) }
          case None => {
            for position in order {
              let argument = arguments[position]
              if match expected { case Some(_) => false; case None => true } && containsPlaceholder(argumentValue(argument)) {
                expected = pipePlaceholderContext(argumentValue(argument), callArgumentExpectedType(applyBindings(preparation.contextualType, argumentBindings), argument, argumentSlots[position]))
              }
            }
          }
        }
        let actual = match saved.values.get(0) {
          case Some(found) => found
          case None => {
            // Saved pipe inputs share the direct argument's inference holes;
            // an unsolved call parameter must not constrain a callback result.
            let context = match expected {
              case Some(found) => Some(callArgumentInferenceContext(found, preparation.schemeParameters))
              case None => None
            }
            let mut pipeValues = state.pipeValues
            pipeValues.pop()
            let inferred = inferContextualCallArgument(service, state, moduleIndex, source, saved.node, context, false)
            let mut savedValues = saved.values
            savedValues.push(inferred)
            pipeValues.push(saved)
            inferred
          }
        }
        if protocol && conformance != "invalid" && preparation.argumentPlan.leadingSlot == 0 {
          let observed = InferredCallArguments { types: inferredTypes, nodes: inferredNodes, protocolConformance: conformance }
          conformance = userProtocolCallConformance(state, moduleIndex, preparation, observed)
          gateUserProtocolCall(state, moduleIndex, preparation, observed, conformance)
        }
        leadingDiagnostics = takeCallDiagnostics(state, diagnosticStart)
        match preparation.leading {
          case Some(_) => match callSlotExpectedType(calleeType, preparation.argumentPlan.leadingSlot, false) {
            case Some(want) => collectTypeBindings(want, actual, argumentBindings, true, preparation.schemeParameters)
            case None => ()
          }
          case None => ()
        }
        if !protocol && preparation.projectedMember == "" && calleeType.kind != "newtype" {
          refineLeadingCallArgument(state, moduleIndex,
            callArgumentInferenceContext(applyBindings(preparation.contextualType,
              argumentBindings), preparation.schemeParameters),
            preparation.argumentPlan, preparation.leading, preparation.diagnosticNode)
        }
        leadingCheckDiagnostics = takeCallDiagnostics(state, diagnosticStart)
      }
      case None => ()
    }
    for position in evidenceOrder {
    if deferred[position] == dependent {
    let diagnosticStart = state.diagnostics.length
    let argument = arguments[position]
    let valueNode = argumentValue(argument)
    let slot = match argumentSlots.get(position) {
      case Some(found) => found
      case None => -2
    }
    let declaredExpected = contextualBuiltinArgumentType(
      state,
      moduleIndex,
      source,
      callee,
      slot,
      contextualActuals,
      callArgumentExpectedType(if protocol {
        protocolRefinementType(preparation, conformance, argumentBindings)
      } else { preparation.contextualType }, argument, slot),
    )
    // Earlier actuals specialize a later callback before its body is checked.
    // A still-unsolved builtin scheme variable is an inference hole, not a
    // rigid requirement imposed on the callback's result.
    let expected = match declaredExpected {
      case Some(found) => Some(callArgumentInferenceContext(
        applyBindings(found, argumentBindings),
        preparation.schemeParameters))
      case None => None
    }
    // Ordinary unsolved tails supply outward evidence. Contextual tails
    // check against the partial expectation. Both spread and scalar tails
    // use this infer/check_expr split in stage0's preparation passes.
    let inferenceExpected = if slot == -1 && !dependent &&
      match expected {
        case Some(context) => typeContains(context, (part: TypeValue) =>
          part.kind == "unknown" && part.origin == "generic-call-expectation")
        case None => false
      } { None } else { expected }
    let inferred = restoreCallArgumentSchemeVariables(if protocol && conformance != "invalid" && slot == 0 {
      serviceInferExpression(service, state, moduleIndex, source, valueNode)
    } else {
      inferContextualCallArgument(service, state, moduleIndex, source, valueNode, inferenceExpected)
    }, preparation.schemeParameters)
    inferredTypes[position] = inferred
    // Bind the receiver against its original scheme, never a caller rigid
    // substituted into the contextual signature by an explicit type argument.
    let bindingExpected = callArgumentExpectedType(if calleeType.kind == "newtype" { newtypeCallType(state, moduleIndex, node, calleeType) } else { calleeType }, argument, slot)
    match bindingExpected {
      case Some(found) => collectTypeBindings(found, inferred, argumentBindings, true,
        preparation.schemeParameters)
      case None => ()
    }
    // The argument owns the substitution available immediately after its own
    // inference. A later callback may solve more variables, but must not cause
    // this argument to be compared again (stage0 check_call_argument).
    if !protocol && preparation.projectedMember == "" && calleeType.kind != "newtype" {
      match declaredExpected {
        case Some(want) => refineCallArgument(state, moduleIndex, valueNode,
          inferred, callArgumentInferenceContext(applyBindings(want, argumentBindings),
            preparation.schemeParameters), argumentBindings,
          slot == -1 && argument.kind == "call-argument/spread" && !dependent &&
            match inferenceExpected { case Some(_) => false; case None => true })
        case None => ()
      }
    }
    if slot >= 0 && slot < contextualActuals.length {
      contextualActuals[slot] = inferred
    }
    if protocol && conformance != "invalid" {
      if slot == 0 {
        let observed = InferredCallArguments {
          types: inferredTypes, nodes: inferredNodes, protocolConformance: conformance,
        }
        conformance = userProtocolCallConformance(state, moduleIndex, preparation, observed)
        gateUserProtocolCall(state, moduleIndex, preparation, observed, conformance)
      } else {
        match callArgumentExpectedType(
          protocolRefinementType(preparation, conformance, argumentBindings), argument, slot) {
          case Some(want) => {
            let refined = refineExpressionToExpected(state, moduleIndex, valueNode,
              applyBindings(inferred, argumentBindings), want)
            reportExpectedType(state, moduleIndex, valueNode, want, refined)
          }
          case None => ()
        }
      }
    }
    argumentDiagnostics[position] = takeCallDiagnostics(state, diagnosticStart)
    }
    }
  }
  let mut diagnostics = state.diagnostics
  // Recovered duplicate/overflow arguments have no parameter owner. Rust checks
  // their inner errors after planning, before replaying owned slot diagnostics.
  // Move only diagnostics: each expression above was inferred exactly once.
  for position in order {
    if argumentSlots[position] == -2 {
      for diagnostic in argumentDiagnostics[position] { diagnostics.push(diagnostic) }
    }
  }
  for diagnostic in leadingDiagnostics { diagnostics.push(diagnostic) }
  match frame { case Some(saved) => for diagnostic in saved.diagnostics { diagnostics.push(diagnostic) }; case None => () }
  // Input inference precedes callee diagnostics; the argument comparison
  // follows them even though it was computed with the earlier substitution.
  for diagnostic in leadingCheckDiagnostics { diagnostics.push(diagnostic) }
  // Replay spread diagnostics before variadic scalars, as apply_scheme_result
  // does in stage0. Buffer diagnostics only: keep argument inference and its
  // shared substitution in the existing order above.
  let mut hasSpreadTail = false
  for position in order {
    if argumentSlots[position] == -1 &&
      arguments[position].kind == "call-argument/spread" { hasSpreadTail = true }
  }
  let mut variadicDiagnostics: Array<PreviewCheckDiagnostic> = []
  for position in order {
    if argumentSlots[position] == -2 { continue }
    let scalarTail = hasSpreadTail && argumentSlots[position] == -1 &&
      arguments[position].kind != "call-argument/spread"
    for diagnostic in argumentDiagnostics[position] {
      if scalarTail { variadicDiagnostics.push(diagnostic) }
      else { diagnostics.push(diagnostic) }
    }
  }
  for diagnostic in variadicDiagnostics { diagnostics.push(diagnostic) }
  if conformance == "invalid" {
    match preparation.userProtocolTarget {
      case Some(target) => addDiagnostic(state, moduleIndex, "TPZ5004",
        "a protocol call `{target.protocolName}.{target.method.name}(…)` takes positional arguments only",
        "", preparation.diagnosticNode)
      case None => ()
    }
  }
  InferredCallArguments {
    types: inferredTypes,
    nodes: inferredNodes,
    protocolConformance: conformance,
  }
}

function protocolRefinementType(
  preparation: CallPreparation,
  conformance: string,
  bindings: Array<TypeBinding>,
) -> TypeValue {
  if conformance != "reject" && conformance != "defer" {
    return applyBindings(preparation.declaredType, bindings)
  }
  let mut unknowns: Array<TypeBinding> = []
  for parameter in preparation.schemeParameters {
    unknowns.push(TypeBinding { name: typeBindingKey(parameter), typeValue: emptyType("unknown") })
  }
  applyBindings(preparation.declaredType, unknowns)
}

export function leadingCallActuals(
  leading: Option<LeadingCallArgument>,
) -> Array<TypeValue> {
  match leading {
    case Some(argument) => match argument.values.get(0) { case Some(found) => [found]; case None => [] }
    case None => []
  }
}

function completeCallActuals(
  leading: Option<LeadingCallArgument>,
  explicit: Array<TypeValue>,
) -> Array<TypeValue> {
  let mut actuals = leadingCallActuals(leading)
  for actual in explicit {
    actuals.push(actual)
  }
  actuals
}

function collectCallResultBindings(
  state: CheckerState,
  node: SyntaxNode,
  calleeType: TypeValue,
  bindings: Array<TypeBinding>,
  parameters: Array<TypeValue>,
) -> () {
  let mut inferredBindings = bindings
  match currentExpectedExpression(state, node) {
    case Some(expectedResult) => match calleeType.result.get(0) {
      case Some(declaredResult) => collectTypeBindings(
        declaredResult,
        expectedResult,
        inferredBindings,
        false,
        parameters,
      )
      case None => ()
    }
    case None => ()
  }
  ()
}

function collectCallInputTypeBindings(
  node: SyntaxNode,
  calleeType: TypeValue,
  argumentPlan: CallArgumentPlan,
  actuals: Array<TypeValue>,
  leading: Option<LeadingCallArgument>,
  bindings: Array<TypeBinding>,
  parameters: Array<TypeValue>,
) -> () {
  let mut inferredBindings = bindings
  match leading {
    case Some(argument) => match callSlotExpectedType(
      calleeType,
      argumentPlan.leadingSlot,
      false,
    ) {
      case Some(expected) => collectTypeBindings(
        expected,
        match argument.values.get(0) { case Some(found) => found; case None => emptyType("unknown") },
        inferredBindings,
        true,
        parameters,
      )
      case None => ()
    }
    case None => ()
  }
  let mut index = 0
  for argument in children(node, "arguments") {
    let slot = match argumentPlan.slots.get(index) {
      case Some(found) => found
      case None => -2
    }
    match callArgumentExpectedType(calleeType, argument, slot) {
      case Some(expected) => match actuals.get(index) {
        case Some(actual) => collectTypeBindings(
          expected,
          actual,
          inferredBindings,
          true,
          parameters,
        )
        case None => ()
      }
      case None => ()
    }
    index += 1
  }
  ()
}

function projectedCallMember(
  source: Bytes,
  callee: SyntaxNode,
  receiverType: TypeValue,
) -> string {
  if !rigidOrUnionRigid(receiverType) ||
    (callee.kind != "expression/member" &&
      callee.kind != "expression/optional-access") {
    return ""
  }
  match child(callee, "field") {
    case Some(field) => text(source, field)
    case None => ""
  }
}

function specializeCallCallee(
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  callee: SyntaxNode,
  calleeType: TypeValue,
  actuals: Array<TypeValue>,
  bindings: Array<TypeBinding>,
) -> TypeValue {
  match contextualStandardWrapperCall(
    state,
    moduleIndex,
    node,
    callee,
    calleeType,
    actuals,
  ) {
    case Some(found) => found
    case None => match contextualGeneratedLispexCall(
      state,
      moduleIndex,
      source,
      node,
      callee,
      actuals,
    ) {
      case Some(found) => found
      case None => match contextualBuiltinCall(
        state,
        moduleIndex,
        source,
        node,
        callee,
        calleeType,
      ) {
        case Some(found) => found
        case None => applyBindings(calleeType, bindings)
      }
    }
  }
}

function unboundBuiltinCallTypeParameter(
  value: TypeValue,
  parameters: Array<TypeValue>,
  bindings: Array<TypeBinding>,
) -> Option<TypeValue> {
  for parameter in parameters {
    if typeEqual(value, parameter) && bindingIndex(bindings, typeBindingKey(parameter)) < 0 {
      // Keep the invocation's variable identity for cross-branch solving.
      // An actual Unknown input already has a binding and stays Unknown.
      return Some(TypeValue {
        ...emptyType("unknown"),
        origin: "generic-call-result",
        value: typeBindingKey(parameter),
      })
    }
  }
  None
}

function preserveUnboundBuiltinCallTypeParameters(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
  receiverType: TypeValue,
  schemeParameters: Array<TypeValue>,
  bindings: Array<TypeBinding>,
  specialized: TypeValue,
) -> TypeValue {
  let parameters = builtinCallTypeParameters(
    service,
    state,
    moduleIndex,
    source,
    callee,
    receiverType,
  )
  if parameters.length == 0 {
    return specialized
  }
  transformTypeComponents(
    specialized,
    (component: TypeValue) => unboundBuiltinCallTypeParameter(
      component,
      schemeParameters,
      bindings,
    ),
  )
}

function refineCallArgument(
  state: CheckerState,
  moduleIndex: int,
  actualNode: SyntaxNode,
  actualType: TypeValue,
  expectedType: TypeValue,
  bindings: Array<TypeBinding>,
  preserveIndependentShape: bool = false,
) -> () {
  let specializedActual = applyBindings(actualType, bindings)
  if !typeEqual(specializedActual, actualType) {
    replaceNodeType(state, moduleIndex, "expression", actualNode, specializedActual)
  }
  let refined = if preserveIndependentShape && hasPartialHole(specializedActual) &&
    !hasHole(expectedType) {
    let completed = solvePartialTypeAgainst(state, specializedActual, expectedType)
    replaceNodeType(state, moduleIndex, "expression", actualNode, completed)
    completed
  } else {
    refineExpressionToExpected(state, moduleIndex, actualNode, specializedActual, expectedType)
  }
  if !expressionResultIsDelegated(actualNode) {
    reportExpectedType(state, moduleIndex, expressionResultNode(actualNode), expectedType, refined)
  }
}

function refineCallArguments(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  calleeType: TypeValue,
  argumentSlots: Array<int>,
  skipFirstSlot: bool,
  actuals: Array<TypeValue>,
  actualNodes: Array<SyntaxNode>,
  bindings: Array<TypeBinding>,
) -> () {
  let arguments = children(node, "arguments")
  let mut index = 0
  while index < actuals.length {
    let expected = match arguments.get(index) {
      case Some(argument) => match argumentSlots.get(index) {
        case Some(slot) => if skipFirstSlot && slot == 0 {
          None
        } else {
          callArgumentExpectedType(calleeType, argument, slot)
        }
        case None => None
      }
      case None => None
    }
    match expected {
      case Some(expectedType) => match actualNodes.get(index) {
        case Some(actualNode) => match actuals.get(index) {
          case Some(actualType) => refineCallArgument(
            state, moduleIndex, actualNode, actualType, expectedType, bindings)
          case None => ()
        }
        case None => ()
      }
      case None => ()
    }
    index += 1
  }
  ()
}

function refineLeadingCallArgument(
  state: CheckerState,
  moduleIndex: int,
  calleeType: TypeValue,
  argumentPlan: CallArgumentPlan,
  leading: Option<LeadingCallArgument>,
  diagnosticNode: SyntaxNode,
) -> () {
  match leading {
    case Some(argument) => match callSlotExpectedType(
      calleeType,
      argumentPlan.leadingSlot,
      false,
    ) {
      case Some(expected) => {
        let refined = refineExpressionToExpected(
          state,
          moduleIndex,
          argument.node,
          match argument.values.get(0) { case Some(found) => found; case None => emptyType("unknown") },
          expected,
        )
        reportExpectedType(
          state,
          moduleIndex,
          diagnosticNode,
          expected,
          refined,
        )
      }
      case None => ()
    }
    case None => ()
  }
}

function callResultType(
  specializedCallee: TypeValue,
  calleeType: TypeValue,
  constructorResult: Option<TypeValue>,
  protocolResult: Option<TypeValue>,
  bindings: Array<TypeBinding>,
) -> TypeValue {
  match specializedCallee.result.get(0) {
    case Some(found) => found
    case None => match constructorResult {
      case Some(found) => found
      case None => match protocolResult {
        case Some(found) => found
        case None => match calleeType.result.get(0) {
          case Some(found) => applyBindings(found, bindings)
          case None => if calleeType.kind == "nominal-record" {
            calleeType
          } else {
            emptyType("unknown")
          }
        }
      }
    }
  }
}

record BuiltinCallTarget {
  namespace: string,
  member: string,
}

function builtinCallTarget(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
) -> BuiltinCallTarget {
  match boundBuiltinForCallee(state, moduleIndex, callee) {
    case Some(bound) => {
      if bound.target == "builtin::JsonDecode" { return BuiltinCallTarget { namespace: "JSON", member: "decode" } }
      if bound.boundary.length == 2 { return BuiltinCallTarget { namespace: bound.boundary[0], member: bound.boundary[1] } }
      return BuiltinCallTarget { namespace: "", member: bound.member }
    }
    case None => ()
  }
  let boundary = canonicalBoundaryTarget(state, moduleIndex, source, callee)
  if boundary.length == 2 { return BuiltinCallTarget { namespace: boundary[0], member: boundary[1] } }
  if callee.kind != "expression/member" &&
    callee.kind != "expression/optional-access" {
    return BuiltinCallTarget { namespace: "", member: "" }
  }
  let object = match child(callee, "object") {
    case Some(found) => found
    case None => return BuiltinCallTarget { namespace: "", member: "" }
  }
  if state.languageMode == "topaz-5.21" {
    match child(callee, "field") {
      case Some(field) => if text(source, field) == "decode" && serviceInferExpression(service, state, moduleIndex, source, object).kind == "json-value" { return BuiltinCallTarget { namespace: "JSON", member: "decode" } }
      case None => ()
    }
  }
  BuiltinCallTarget {
    namespace: if builtinNamespaceObject(
      service,
      state,
      moduleIndex,
      source,
      object,
    ) {
      text(source, object)
    } else {
      ""
    },
    member: match child(callee, "field") {
      case Some(found) => text(source, found)
      case None => ""
    },
  }
}

function preparedCallActual(
  preparation: CallPreparation,
  inferred: InferredCallArguments,
  slot: int,
) -> Option<TypeValue> {
  match preparation.leading {
    case Some(argument) => if preparation.argumentPlan.leadingSlot == slot {
      return Some(match argument.values.get(0) { case Some(found) => found; case None => emptyType("unknown") })
    }
    case None => ()
  }
  let mut index = 0
  for actual in inferred.types {
    match preparation.argumentPlan.slots.get(index) {
      case Some(actualSlot) => if actualSlot == slot {
        return Some(actual)
      }
      case None => ()
    }
    index += 1
  }
  None
}

function preparedCallActualNode(
  preparation: CallPreparation,
  inferred: InferredCallArguments,
  slot: int,
) -> Option<SyntaxNode> {
  match preparation.leading {
    case Some(argument) => if preparation.argumentPlan.leadingSlot == slot {
      return Some(preparation.diagnosticNode)
    }
    case None => ()
  }
  let mut index = 0
  for actualNode in inferred.nodes {
    match preparation.argumentPlan.slots.get(index) {
      case Some(actualSlot) => if actualSlot == slot {
        return Some(actualNode)
      }
      case None => ()
    }
    index += 1
  }
  None
}

function userProtocolCallConformance(
  state: CheckerState,
  moduleIndex: int,
  preparation: CallPreparation,
  inferred: InferredCallArguments,
) -> string {
  let target = match preparation.userProtocolTarget {
    case Some(found) => found
    case None => return "not-protocol"
  }
  match preparedCallActual(preparation, inferred, 0) {
    case Some(actual) => {
      let value = widen(actual)
      if hasHole(value) {
        "defer"
      } else if typeConforms(
        state,
        moduleIndex,
        value,
        target.protocolName,
      ) {
        "accept"
      } else {
        "reject"
      }
    }
    case None => "defer"
  }
}

function gateUserProtocolCall(
  state: CheckerState,
  moduleIndex: int,
  preparation: CallPreparation,
  inferred: InferredCallArguments,
  conformance: string,
) -> () {
  let target = match preparation.userProtocolTarget {
    case Some(found) => found
    case None => return ()
  }
  let actualCount = inferred.types.length + match preparation.leading {
    case Some(_) => 1
    case None => 0
  }
  if conformance == "accept" ||
    (conformance == "defer" && actualCount == 0) {
    let expectedCount = target.method.typeValue.parameters.length
    if actualCount != expectedCount {
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5004",
        "`{target.protocolName}.{target.method.name}` takes {expectedCount} argument" +
          if expectedCount == 1 { "" } else { "s" } +
          ", found {actualCount}",
        "",
        preparation.diagnosticNode,
      )
    }
  }
  if conformance != "reject" {
    return ()
  }
  match preparedCallActual(preparation, inferred, 0) {
    case Some(actual) => {
      let value = widen(actual)
      let nominal = value.kind == "nominal-record" ||
        value.kind == "enum" || value.kind == "newtype" ||
        value.kind == "foreign" || value.kind == "rigid"
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5522",
        if nominal {
          "`{conformanceTypeText(state, moduleIndex, actual)}` does not conform to `{target.protocolName}`"
        } else {
          "`{typeText(actual)}` does not conform to `{target.protocolName}`: a protocol receiver must be a record/enum/newtype"
        },
        "",
        match preparedCallActualNode(preparation, inferred, 0) {
          case Some(found) => found
          case None => preparation.diagnosticNode
        },
      )
    }
    case None => ()
  }
  ()
}

function gatePreparedCallCapabilities(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  preparation: CallPreparation,
  inferred: InferredCallArguments,
  bindings: Array<TypeBinding>,
  rawResult: TypeValue,
) -> () {
  let target = builtinCallTarget(
    service,
    state,
    moduleIndex,
    source,
    preparation.callee,
  )
  let bareCallContext = match currentExpectedExpression(state, node) {
    case Some(_) => false
    case None => true
  }
  let bareBindingCall = isBareBindingExpression(state, node)
  let unknownExpectation = match currentExpectedExpression(state, node) {
    case Some(expected) => expected.kind == "unknown" && expected.origin == "" ||
      expected.kind == "inference-variable"
    case None => false
  }
  let constructorName = if unshadowedIdentifier(state, moduleIndex, preparation.callee) {
    text(source, preparation.callee)
  } else { "" }
  if (constructorName == "Ok" || constructorName == "Err" || constructorName == "Some") &&
    (bareBindingCall || unknownExpectation) && hasHole(rawResult) {
    let mut unknownInput = false
    for actual in inferred.types { if hasHole(actual) { unknownInput = true } }
    if !unknownInput {
      addDiagnostic(state, moduleIndex, "TPZ5020",
        "this expression needs a contextual type (§22.1): annotate the binding or surrounding expectation",
        "", preparation.diagnosticNode)
    }
  }
  if bareCallContext && bareBindingCall &&
    target.namespace == "Map" && target.member == "new" &&
    hasHole(rawResult) {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5020",
      "this expression needs a contextual type (§22.1): annotate the binding or surrounding expectation",
      "",
      preparation.diagnosticNode,
    )
  }
  if preparation.callee.kind == "expression/identifier" &&
    unshadowedIdentifier(state, moduleIndex, preparation.callee) &&
    (text(source, preparation.callee) == "map" ||
      text(source, preparation.callee) == "filter" ||
      text(source, preparation.callee) == "reduce") {
    match preparedCallActual(preparation, inferred, 0) {
      case Some(iterable) => if iterableElement(iterable).kind == "unknown" &&
        !hasHole(iterable) {
        addDiagnostic(
          state,
          moduleIndex,
          "TPZ5001",
          "`{typeText(iterable)}` is not iterable (§10)",
          "",
          match preparedCallActualNode(preparation, inferred, 0) {
            case Some(actualNode) => actualNode
            case None => preparation.diagnosticNode
          },
        )
      }
      case None => ()
    }
    if bareCallContext && hasHole(rawResult) {
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5020",
        "this expression needs a contextual type (§22.1): annotate the binding or surrounding expectation",
        "",
        preparation.diagnosticNode,
      )
    }
  }
  if bareCallContext &&
    ((target.namespace == "Set" && target.member == "of") ||
      (target.namespace == "Map" &&
        (target.member == "new" || target.member == "ofEntries"))) &&
    rawResult.kind == "constructor" {
    match rawResult.arguments.get(0) {
      case Some(key) => if !hasHole(key) { gateCollectionKey(
        service,
        state,
        moduleIndex,
        preparation.diagnosticNode,
        key,
      ) }
      case None => ()
    }
  }
  if target.namespace == "" &&
    (target.member == "sorted" || target.member == "sort") &&
    preparation.receiverType.kind == "constructor" &&
    preparation.receiverType.name == "Array" {
    match preparation.receiverType.arguments.get(0) {
      case Some(element) => {
        let specialized = applyBindings(element, bindings)
        if orderCapability(
          state,
          moduleIndex,
          specialized,
          [],
        ) == "reject" {
          addDiagnostic(
            state,
            moduleIndex,
            "TPZ5007",
            "`{typeText(specialized)}` is not ordered comparable, so `.{target.member}()` cannot sort it",
            "",
            preparation.diagnosticNode,
          )
        }
      }
      case None => ()
    }
  }
  if target.namespace == "" &&
    (target.member == "sortedBy" || target.member == "sortBy") {
    match preparedCallActual(preparation, inferred, 0) {
      case Some(callback) => if callback.kind == "function" {
        match callback.result.get(0) {
          case Some(result) => {
            let key = applyBindings(result, bindings)
            if orderCapability(state, moduleIndex, key, []) == "reject" {
              addDiagnostic(
                state,
                moduleIndex,
                "TPZ5007",
                "the `{target.member}` key type `{typeText(key)}` is not ordered comparable, so `.{target.member}()` cannot sort it",
                "",
                preparation.diagnosticNode,
              )
            }
          }
          case None => ()
        }
      }
      case None => ()
    }
  }
  if target.namespace == "JSON" && target.member == "stringify" {
    match preparedCallActual(preparation, inferred, 0) {
      case Some(actual) => {
        let value = applyBindings(actual, bindings)
        if jsonCapability(state, moduleIndex, value, [], false) == "reject" &&
          !rigidProtocolBound(state, value, "JSON") {
          addDiagnostic(
            state,
            moduleIndex,
            "TPZ5533",
            "`{typeText(value)}` is not JSON-encodable, so `json.stringify` cannot encode it",
            "",
            preparation.diagnosticNode,
          )
        }
      }
      case None => ()
    }
  }
  if target.namespace == "JSON" &&
    (target.member == "parseAs" || target.member == "decode") {
    let jsonName = if state.languageMode == "topaz-5.21" {
      if target.member == "decode" { "decode" } else { "json.{target.member}" }
    } else { "JSON.{target.member}" }
    let typeArguments = children(node, "typeArguments")
    if typeArguments.length == 0 {
      if bareCallContext {
        addDiagnostic(
          state,
          moduleIndex,
          "TPZ5020",
          "this expression needs a contextual type (§22.1): annotate the binding or surrounding expectation",
          "",
          preparation.diagnosticNode,
        )
      }
      addDiagnostic(
        state,
        moduleIndex,
        "TPZ5534",
        "`{jsonName}` requires an explicit type argument, e.g. `{jsonName}<User>(...)`",
        "",
        preparation.diagnosticNode,
      )
    } else if rawResult.kind == "constructor" && rawResult.name == "Result" {
      match rawResult.arguments.get(0) {
        case Some(value) => if jsonCapability(
          state,
          moduleIndex,
          value,
          [],
          true,
        ) == "reject" {
          addDiagnostic(
            state,
            moduleIndex,
            "TPZ5534",
            "`{typeText(value)}` is not JSON-decodable, so `{jsonName}` cannot decode into it",
            "",
            preparation.diagnosticNode,
          )
        }
        case None => ()
      }
    }
  }
  if target.namespace == "Test" &&
    (target.member == "assertEq" || target.member == "assertNe") {
    match preparedCallActual(preparation, inferred, 0) {
      case Some(value) => {
        let actual = applyBindings(value, bindings)
        if !comparableType(state, moduleIndex, actual, []) {
          addDiagnostic(
            state,
            moduleIndex,
            "TPZ5007",
            "`{typeText(actual)}` is not comparable, so `test.{target.member}` cannot compare it",
            "",
            preparation.diagnosticNode,
          )
        }
      }
      case None => ()
    }
  }
  ()
}

function checkedCallResultCandidates(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  callee: SyntaxNode,
  calleeType: TypeValue,
) -> CallResultCandidates {
  let nominal = nominalConstructorCallResult(
    state,
    moduleIndex,
    source,
    callee,
  )
  let protocol = protocolCallResult(service, state, moduleIndex, source, callee)
  let nominalKnown = match nominal {
    case Some(_) => true
    case None => false
  }
  let protocolKnown = match protocol {
    case Some(_) => true
    case None => false
  }
  if !hasHole(calleeType) &&
    calleeType.kind != "function" &&
    calleeType.kind != "nominal-record" &&
    calleeType.kind != "newtype" &&
    !nominalKnown &&
    !protocolKnown {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5005",
      "`{typeText(calleeType)}` is not callable",
      "",
      if callee.kind == "expression/member" ||
        callee.kind == "expression/optional-access" {
        match child(callee, "field") {
          case Some(field) => field
          case None => callee
        }
      } else {
        callee
      },
    )
  }
  CallResultCandidates { nominal: nominal, protocol: protocol }
}

function newtypeCallType(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  declared: TypeValue,
) -> TypeValue {
  match newtypeDefinitionForType(state, moduleIndex, declared) {
    case Some(definition) => {
      if definition.typeParameters.length == 0 {
        return functionType([definition.base], [], declared)
      }
      match currentExpectedExpression(state, node) {
        case Some(expected) => if expected.kind == declared.kind &&
          expected.identity == declared.identity && expected.origin == declared.origin &&
          expected.arguments.length == definition.typeParameters.length {
          let base = substitute(definition.base, definition.typeParameters, expected.arguments)
          return functionType([base], [], expected)
        }
        case None => ()
      }
    }
    case None => ()
  }
  declared
}

function planNewtypeArguments(
  state: CheckerState,
  moduleIndex: int,
  node: SyntaxNode,
  diagnosticNode: SyntaxNode,
  callee: TypeValue,
  callType: TypeValue,
  hasLeading: bool,
) -> CallArgumentPlan {
  let arguments = children(node, "arguments")
  let actualCount = arguments.length + if hasLeading { 1 } else { 0 }
  let mut valid = actualCount == 1
  for argument in arguments {
    if argument.kind == "call-argument/named" || argument.kind == "call-argument/spread" {
      valid = false
    }
  }
  if !valid {
    let base = match callType.parameters.get(0) {
      case Some(value) => typeText(value)
      case None => "?"
    }
    addDiagnostic(state, moduleIndex, "TPZ5004",
      "newtype `{callee.identity}` constructor takes 1 argument (the `{base}` to wrap), found {actualCount}",
      "", diagnosticNode)
  }
  let mut slots: Array<int> = []
  for argument in arguments { slots.push(if valid { 0 } else { -2 }) }
  CallArgumentPlan { slots: slots, leadingSlot: if hasLeading && valid { 0 } else { -2 },
    resultUnknown: false }
}

export function prepareCall(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  diagnosticNode: SyntaxNode,
  leading: Option<LeadingCallArgument>,
) -> CallPreparation {
  let callee = match child(node, "callee") {
    case Some(found) => found
    case None => node
  }
  let inferredCallee = inferCallCallee(
    service,
    state,
    moduleIndex,
    source,
    diagnosticNode,
    callee,
  )
  let referencedDefinition = match calleeReference(
    state,
    moduleIndex,
    callee,
  ) {
    case Some(reference) => functionDefinitionForReference(state, reference)
    case None => None
  }
  let userProtocolTarget = userProtocolCallTarget(
    service, state, moduleIndex, source, callee)
  let parameters = callTypeParameters(service, state, moduleIndex, source,
    callee, inferredCallee.receiverType, referencedDefinition,
    userProtocolTarget, inferredCallee.declaredType)
  let schemeParameters = scopeCallParameters(parameters, moduleIndex, node)
  let declaredType = instantiateCallType(inferredCallee.declaredType,
    parameters, schemeParameters)
  let bindings = explicitCallBindings(
    service,
    state,
    moduleIndex,
    source,
    node,
    diagnosticNode,
    callee,
    referencedDefinition,
    inferredCallee.optionalContainer == "",
    inferredCallee.receiverType,
    match userProtocolTarget {
      case Some(_) => []
      case None => schemeParameters
    },
  )
  match currentExpectedExpression(state, node) {
    case Some(expectedResult) => match declaredType.result.get(0) {
      case Some(declaredResult) => collectTypeBindings(
        declaredResult,
        expectedResult,
        bindings,
        false,
        schemeParameters,
      )
      case None => ()
    }
    case None => ()
  }
  let hasLeading = match leading {
    case Some(_) => true
    case None => false
  }
  let contextualType = applyBindings(
    newtypeCallType(state, moduleIndex, diagnosticNode, declaredType), bindings)
  let projectedMember = projectedCallMember(
    source,
    callee,
    inferredCallee.receiverType,
  )
  let callSignature = match referencedDefinition {
    case Some(definition) => Some(declaredCallSignature(definition))
    case None => match userProtocolTarget {
      case Some(target) => Some(userProtocolCallSignature(target))
      case None => match inferredCallee.builtinSignature {
        case Some(signature) => Some(signature)
        case None => if state.languageMode == "topaz-5.21" &&
          inferredCallee.receiverType.kind == "unknown" {
          // An unresolved receiver has no builtin parameter names. Its first
          // inference owns the diagnostic; do not infer it again for a call plan.
          None
        } else {
          builtinMemberCallSignature(
            service,
            state,
            moduleIndex,
            source,
            node,
            callee,
          )
        }
      }
    }
  }
  let deferProtocolArity = match userProtocolTarget {
    case Some(_) => true
    case None => false
  }
  let argumentPlan = if declaredType.kind == "newtype" &&
    contextualType.kind == "function" {
    planNewtypeArguments(state, moduleIndex, node, diagnosticNode,
      declaredType, contextualType, hasLeading)
  } else if projectedMember != "" {
    unknownCallArgumentPlan(node)
  } else { match callSignature {
    case Some(signature) => planSignatureArguments(
      state,
      moduleIndex,
      source,
      node,
      diagnosticNode,
      signature,
      hasLeading,
      deferProtocolArity,
    )
    case None => planTypedCallArguments(
      state,
      moduleIndex,
      node,
      diagnosticNode,
      contextualType,
      hasLeading,
    )
  } }
  CallPreparation {
    callee: callee,
    diagnosticNode: diagnosticNode,
    declaredType: declaredType,
    contextualType: contextualType,
    schemeParameters: schemeParameters,
    receiverType: inferredCallee.receiverType,
    optionalContainer: inferredCallee.optionalContainer,
    referencedDefinition: referencedDefinition,
    userProtocolTarget: userProtocolTarget,
    argumentPlan: argumentPlan,
    bindings: bindings,
    leading: leading,
    projectedMember: projectedMember,
  }
}

record ProjectedArmCallResult {
  status: string,
  resultType: TypeValue,
}

function projectedArmCalleeType(
  state: CheckerState,
  moduleIndex: int,
  receiverType: TypeValue,
  member: string,
) -> TypeValue {
  match receiverMethodType(state, moduleIndex, receiverType, member) {
    case Some(found) => found
    case None => memberType(state, moduleIndex, receiverType, member)
  }
}

function projectedArmCallSignature(
  state: CheckerState,
  moduleIndex: int,
  receiverType: TypeValue,
  member: string,
) -> Option<CallSignature> {
  match receiverMethodCallSignature(
    state,
    moduleIndex,
    receiverType,
    member,
  ) {
    case Some(found) => Some(found)
    case None => builtinReceiverCallSignature(receiverType, member, state.languageMode)
  }
}

function completeProjectedArmCall(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  preparation: CallPreparation,
  inferred: InferredCallArguments,
  receiverType: TypeValue,
) -> ProjectedArmCallResult {
  let declaredCallee = projectedArmCalleeType(
    state,
    moduleIndex,
    receiverType,
    preparation.projectedMember,
  )
  let parameters = callTypeParameters(service, state, moduleIndex, source,
    preparation.callee, receiverType, None, None, declaredCallee)
  let scheme = scopeCallParameters(parameters, moduleIndex, node)
  let calleeType = instantiateCallType(declaredCallee, parameters, scheme)
  if calleeType.kind == "unknown" {
    return ProjectedArmCallResult {
      status: "absent",
      resultType: emptyType("unknown"),
    }
  }
  if calleeType.kind != "function" {
    addDiagnostic(
      state,
      moduleIndex,
      "TPZ5005",
      "`{typeText(calleeType)}` is not callable",
      "",
      match child(preparation.callee, "field") {
        case Some(field) => field
        case None => preparation.callee
      },
    )
    return ProjectedArmCallResult {
      status: "not-callable",
      resultType: emptyType("unknown"),
    }
  }
  let diagnosticNode = match child(preparation.callee, "field") {
    case Some(field) => field
    case None => preparation.diagnosticNode
  }
  let hasLeading = match preparation.leading {
    case Some(_) => true
    case None => false
  }
  let argumentPlan = match projectedArmCallSignature(
    state,
    moduleIndex,
    receiverType,
    preparation.projectedMember,
  ) {
    case Some(signature) => planSignatureArguments(
      state,
      moduleIndex,
      source,
      node,
      diagnosticNode,
      signature,
      hasLeading,
      false,
    )
    case None => planTypedCallArguments(
      state,
      moduleIndex,
      node,
      diagnosticNode,
      calleeType,
      hasLeading,
    )
  }
  let mut bindings: Array<TypeBinding> = []
  collectCallInputTypeBindings(
    node,
    calleeType,
    argumentPlan,
    inferred.types,
    preparation.leading,
    bindings,
    scheme,
  )
  let specialized = applyBindings(calleeType, bindings)
  refineCallArguments(
    state,
    moduleIndex,
    node,
    specialized,
    argumentPlan.slots,
    false,
    inferred.types,
    inferred.nodes,
    bindings,
  )
  refineLeadingCallArgument(
    state,
    moduleIndex,
    specialized,
    argumentPlan,
    preparation.leading,
    diagnosticNode,
  )
  let rawResult = if argumentPlan.resultUnknown {
    emptyType("unknown")
  } else {
    match specialized.result.get(0) {
      case Some(found) => found
      case None => emptyType("unknown")
    }
  }
  gatePreparedCallCapabilities(
    service,
    state,
    moduleIndex,
    source,
    node,
    CallPreparation {
      ...preparation,
      diagnosticNode: diagnosticNode,
      declaredType: calleeType,
      contextualType: calleeType,
      schemeParameters: scheme,
      receiverType: receiverType,
      optionalContainer: "",
      referencedDefinition: None,
      userProtocolTarget: None,
      argumentPlan: argumentPlan,
      bindings: bindings,
      projectedMember: "",
    },
    inferred,
    bindings,
    rawResult,
  )
  ProjectedArmCallResult {
    status: "callable",
    resultType: rawResult,
  }
}

function projectedMemberCallResult(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  preparation: CallPreparation,
  inferred: InferredCallArguments,
) -> TypeValue {
  let receiverType = preparation.receiverType
  if receiverType.kind != "union" {
    let projection = "CallOf<{typeText(receiverType)}, {preparation.projectedMember}>"
    return rigid(
      projection,
      "projection:{projection}",
    )
  }
  let mut results: Array<TypeValue> = []
  for arm in receiverType.members {
    if arm.kind == "literal" && arm.name == "null" {
      continue
    }
    if rigidOrUnionRigid(arm) {
      let projection = "CallOf<{typeText(arm)}, {preparation.projectedMember}>"
      results.push(rigid(
        projection,
        "projection:{projection}",
      ))
      continue
    }
    let completed = completeProjectedArmCall(
      service,
      state,
      moduleIndex,
      source,
      node,
      preparation,
      inferred,
      arm,
    )
    if completed.status == "not-callable" {
      return emptyType("unknown")
    }
    if completed.status == "absent" {
      let projection = "CallOf<{typeText(receiverType)}, {preparation.projectedMember}>"
      return rigid(
        projection,
        "projection:{projection}",
      )
    }
    results.push(completed.resultType)
  }
  unionType(results)
}

function completeProjectedMemberCall(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  preparation: CallPreparation,
  inferred: InferredCallArguments,
) -> CompletedCall {
  let specialized = applyBindings(
    preparation.declaredType,
    preparation.bindings,
  )
  let observedCallee = wrapOptionalResult(
    specialized,
    preparation.optionalContainer,
  )
  replaceNodeType(
    state,
    moduleIndex,
    "expression",
    preparation.callee,
    observedCallee,
  )
  let rawResult = projectedMemberCallResult(
    service,
    state,
    moduleIndex,
    source,
    node,
    preparation,
    inferred,
  )
  CompletedCall {
    calleeType: observedCallee,
    resultType: wrapOptionalResult(rawResult, preparation.optionalContainer),
  }
}

export function completePreparedCall(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
  preparation: CallPreparation,
  inferred: InferredCallArguments,
) -> CompletedCall {
  if preparation.declaredType.kind == "newtype" &&
    preparation.contextualType.kind == "function" {
    refineCallArguments(state, moduleIndex, node, preparation.contextualType,
      preparation.argumentPlan.slots, false, inferred.types, inferred.nodes, [])
    refineLeadingCallArgument(state, moduleIndex, preparation.contextualType,
      preparation.argumentPlan, preparation.leading, preparation.diagnosticNode)
    return CompletedCall {
      calleeType: preparation.declaredType,
      resultType: match preparation.contextualType.result.get(0) {
        case Some(result) => result
        case None => preparation.declaredType
      },
    }
  }
  if preparation.projectedMember != "" {
    return completeProjectedMemberCall(
      service,
      state,
      moduleIndex,
      source,
      node,
      preparation,
      inferred,
    )
  }
  let mut bindings = preparation.bindings
  // Inputs were bound and checked in inference order. Completion may retry
  // the result context, but never feeds later evidence back into earlier args.
  collectCallResultBindings(
    state,
    node,
    preparation.declaredType,
    bindings,
    preparation.schemeParameters,
  )
  let actuals = completeCallActuals(preparation.leading, inferred.types)
  let boundSpecialized = specializeCallCallee(
    state,
    moduleIndex,
    source,
    node,
    preparation.callee,
    preparation.declaredType,
    actuals,
    bindings,
  )
  let specialized = preserveUnboundBuiltinCallTypeParameters(
    service,
    state,
    moduleIndex,
    source,
    preparation.callee,
    preparation.receiverType,
    preparation.schemeParameters,
    bindings,
    boundSpecialized,
  )
  let observedCallee = wrapOptionalResult(
    specialized,
    preparation.optionalContainer,
  )
  replaceNodeType(
    state,
    moduleIndex,
    "expression",
    preparation.callee,
    observedCallee,
  )
  let candidates = checkedCallResultCandidates(
    service,
    state,
    moduleIndex,
    source,
    preparation.callee,
    preparation.declaredType,
  )
  match candidates.nominal {
    case Some(value) => { let _ = checkNominalConstructionContext(state, moduleIndex, node, value) }
    case None => ()
  }
  let rawResult = if preparation.argumentPlan.resultUnknown {
    emptyType("unknown")
  } else {
    callResultType(
      specialized,
      preparation.declaredType,
      candidates.nominal,
      candidates.protocol,
      bindings,
    )
  }
  gatePreparedCallCapabilities(
    service,
    state,
    moduleIndex,
    source,
    node,
    preparation,
    inferred,
    bindings,
    rawResult,
  )
  let result = wrapOptionalResult(rawResult, preparation.optionalContainer)
  match preparation.referencedDefinition {
    case Some(definition) => checkFunctionBounds(
      state,
      moduleIndex,
      preparation.diagnosticNode,
      definition,
      preparation.schemeParameters,
      bindings,
    )
    case None => ()
  }
  CompletedCall {
    calleeType: observedCallee,
    resultType: result,
  }
}

export function inferCall(
  service: CheckerService,
  state: CheckerState,
  moduleIndex: int,
  source: Bytes,
  node: SyntaxNode,
) -> TypeValue {
  match child(node, "callee") {
    case Some(callee) => {
      if reportRemovedStaticMember(state, moduleIndex, source, callee) {
        return emptyType("unknown")
      }
      match nominalConstructorCallResult(state, moduleIndex, source, callee) {
        case Some(value) => if value.kind == "enum" &&
          children(node, "typeArguments").length == 0 &&
          checkNominalConstructionContext(state, moduleIndex, node, value) {
          // Stage 0 rejects the enum instantiation before checking payloads.
          // Infer arguments without a declared payload expectation and recover
          // with Unknown, rather than exposing the enum's rigid parameters.
          for argument in children(node, "arguments") {
            let _ = serviceInferExpression(
              service, state, moduleIndex, source, argumentValue(argument))
          }
          return emptyType("unknown")
        }
        case None => ()
      }
    }
    case None => ()
  }
  let preparation = prepareCall(
    service,
    state,
    moduleIndex,
    source,
    node,
    node,
    None,
  )
  let inferred = inferCallArguments(
    service,
    state,
    moduleIndex,
    source,
    node,
    preparation,
  )
  let completed = completePreparedCall(
    service,
    state,
    moduleIndex,
    source,
    node,
    preparation,
    inferred,
  )
  addCall(
    service,
    state,
    moduleIndex,
    source,
    node,
    preparation.callee,
    completed.calleeType,
    preparation.receiverType,
    completed.resultType,
  )
  completed.resultType
}
