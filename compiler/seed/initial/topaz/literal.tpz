// Source literal grammar and parser-close cooking. Coordinates are UTF-8 bytes.
import types { SyntaxNode, PreviewAstAttribute }

function byteAt(bytes: Bytes, at: int) -> int { bytes.get(at) ?? -1 }
function slice(bytes: Bytes, lo: int, hi: int) -> string {
  match bytes.slice(lo, hi).decodeUtf8() { case Ok(text) => text; case Err(_) => "" }
}
function digit(value: int) -> int {
  if value >= 48 && value <= 57 { value - 48 }
  else if value >= 65 && value <= 70 { value - 65 + 10 }
  else if value >= 97 && value <= 102 { value - 97 + 10 }
  else { -1 }
}
export function validDigitRun(bytes: Bytes, lo: int, hi: int, radix: int) -> bool {
  if lo == hi { return false }
  let mut at = lo
  while at < hi {
    let b = byteAt(bytes, at)
    let d = digit(b)
    if d < 0 || d >= radix {
      if b != 95 || at == lo || at + 1 == hi { return false }
      let before = digit(byteAt(bytes, at - 1))
      let after = digit(byteAt(bytes, at + 1))
      if before < 0 || before >= radix || after < 0 || after >= radix { return false }
    }
    at += 1
  }
  true
}
export function integerRadix(spelling: string) -> int {
  if spelling.startsWith("0x") || spelling.startsWith("0X") { 16 }
  else if spelling.startsWith("0b") || spelling.startsWith("0B") { 2 }
  else { 10 }
}
export function validIntegerLiteral(spelling: string) -> bool {
  let bytes = spelling.encodeUtf8()
  let radix = integerRadix(spelling)
  validDigitRun(bytes, if radix == 10 { 0 } else { 2 }, bytes.length(), radix)
}
export function validDecimalLiteral(spelling: string) -> bool {
  let parts = spelling.split(".")
  if parts.length == 0 || parts.length > 2 { return false }
  for part in parts {
    let bytes = part.encodeUtf8()
    if !validDigitRun(bytes, 0, bytes.length(), 10) { return false }
  }
  true
}
export function integerMagnitude(spelling: string) -> Option<BigInt> {
  if !validIntegerLiteral(spelling) { return None }
  let bytes = spelling.encodeUtf8()
  let radix = integerRadix(spelling)
  let mut at = if radix == 10 { 0 } else { 2 }
  let mut value = match BigInt.parse("0", 10) { case Some(value) => value; case None => return None }
  let base = match BigInt.parse("{radix}", 10) { case Some(value) => value; case None => return None }
  while at < bytes.length() {
    if byteAt(bytes, at) != 95 {
      let d = digit(byteAt(bytes, at))
      let next = match BigInt.parse("{d}", 10) { case Some(value) => value; case None => return None }
      value = value * base + next
    }
    at += 1
  }
  Some(value)
}
export function decodeIntegerLiteral(spelling: string, negative: bool) -> Option<int> {
  let value = match integerMagnitude(spelling) { case Some(value) => value; case None => return None }
  if negative { (-value).toInt() } else { value.toInt() }
}
export function decodeDurationMilliseconds(spelling: string) -> Option<string> {
  let bytes = spelling.encodeUtf8()
  let unitSize = if spelling.endsWith("ms") { 2 } else { 1 }
  if bytes.length() <= unitSize { return None }
  let unit = slice(bytes, bytes.length() - unitSize, bytes.length())
  let magnitude = slice(bytes, 0, bytes.length() - unitSize)
  if unit != "ms" && unit != "s" && unit != "m" { return None }
  if integerRadix(magnitude) != 10 || !validIntegerLiteral(magnitude) { return None }
  let value = match integerMagnitude(magnitude) { case Some(value) => value; case None => return None }
  let factor = match BigInt.parse(if unit == "ms" { "1" } else if unit == "s" { "1000" } else { "60000" }, 10) { case Some(value) => value; case None => return None }
  let maximum = match BigInt.parse("18446744073709551615", 10) { case Some(value) => value; case None => return None }
  let milliseconds = value * factor
  if milliseconds > maximum { None } else { Some(milliseconds.toString(10)) }
}
export function decodeDecimalFloatLiteral(spelling: string) -> Option<float> {
  if !validDecimalLiteral(spelling) || !spelling.contains(".") { return None }
  let canonical = spelling.replace("_", "")
  match canonical.parseFloat() { case Ok(value) => Some(value); case Err(_) => Some(1.0 / 0.0) }
}
function hexWord(value: int) -> string {
  let integer = match BigInt.parse("{value}", 10) { case Some(value) => value; case None => return "" }
  let mut text = integer.toString(16)
  while text.encodeUtf8().length() < 8 { text = "0{text}" }
  text
}
// Resolve a positive source float to IEEE bits before IR/backend boundaries.
export function floatLiteralBits(spelling: string) -> string {
  match decodeDecimalFloatLiteral(spelling) { case Some(value) => floatValueBits(value); case None => "" }
}
function floatValueBits(input: float) -> string {
  if input.isNaN() { return "7ff8000000000000" }
  let negative = input < 0.0 || 1.0 / input == -1.0 / 0.0
  let sign = if negative { 2147483648 } else { 0 }
  let mut value = if negative { -input } else { input }
  if value == 1.0 / 0.0 { return "{hexWord(sign + 2146435072)}00000000" }
  if value == 0.0 { return "{hexWord(sign)}00000000" }
  let mut exponent = 1023
  while value >= 2.0 { value /= 2.0; exponent += 1 }
  while value < 1.0 && exponent > 1 { value *= 2.0; exponent -= 1 }
  let significand = if value < 1.0 { value * 4503599627370496.0 }
    else { (value - 1.0) * 4503599627370496.0 }
  if value < 1.0 { exponent = 0 }
  // Binary64 scaling leaves an exact integer in [0, 2^52); trunc is in range.
  let mantissa = significand.trunc()
  let high = sign + exponent * 1048576 + mantissa / 4294967296
  let low = mantissa % 4294967296
  "{hexWord(high)}{hexWord(low)}"
}
function escapeValue(bytes: Bytes, at: int, width: int) -> string {
  match byteAt(bytes, at) {
    case 110 => "\n"; case 114 => "\r"; case 116 => "\t"
    case _ => slice(bytes, at, at + width)
  }
}
// Historical IR is decoded at its input boundary, before any backend consumes it.
export function normalizeLegacyIrDetail(kind: string, detail: string, languageMode: string) -> Result<string, string> {
  if kind == "expression/float" {
    if detail == "" { return Err("invalid legacy float literal") }
    for scalar in detail.scalars() {
      if !"0123456789._eE+-".contains(scalar) { return Err("invalid legacy float literal") }
    }
    let normalized = detail.replace("_", "")
    match normalized.parseFloat() {
      case Ok(value) => return Ok(floatValueBits(value))
      case Err(_) => ()
    }
    // Source literal overflow was IEEE infinity in the legacy compiler too.
    if languageMode == "topaz-5.21" && detail.contains(".") && validDecimalLiteral(detail) && validDecimalLiteral(normalized) { return Ok("7ff0000000000000") }
    return Err("invalid legacy float literal")
  }
  if kind == "expression/duration" {
    let bytes = detail.encodeUtf8()
    let end = bytes.length() - (if detail.endsWith("ms") { 2 } else { 1 })
    if end <= 0 { return Err("invalid legacy duration literal") }
    let mut at = 0
    while at < end {
      let b = byteAt(bytes, at)
      if b < 48 || b > 57 { return Err("invalid legacy duration literal") }
      at += 1
    }
    return match decodeDurationMilliseconds(detail) { case Some(value) => Ok(value); case None => Err("invalid legacy duration literal") }
  }
  if kind != "expression/string-text" { return Ok(detail) }
  let bytes = detail.encodeUtf8()
  let mut at = 0
  let mut out: Array<string> = []
  while at < bytes.length() {
    let b = byteAt(bytes, at)
    if b == 92 {
      at += 1
      let escaped = byteAt(bytes, at)
      if escaped != 110 && escaped != 114 && escaped != 116 && escaped != 92 && escaped != 34 && escaped != 123 && escaped != 125 { return Err("invalid legacy string escape") }
      out.push(escapeValue(bytes, at, 1))
      at += 1
    } else {
      let width = if b < 128 { 1 } else if b < 224 { 2 } else if b < 240 { 3 } else { 4 }
      out.push(slice(bytes, at, at + width))
      at += width
    }
  }
  Ok(out.join(""))
}
export record IntegerLiteralInput { spelling: string, negative: bool }
export function literalAttribute(node: SyntaxNode, name: string) -> string {
  for attr in node.attributes {
    if attr.name == name {
      return attr.value
    }
  }
  ""
}
function unparen(node: SyntaxNode) -> SyntaxNode {
  let mut current = node
  while current.kind == "expression/parenthesized" && current.children.length == 1 { current = current.children[0] }
  current
}
export function signedIntegerInput(node: SyntaxNode, source: Bytes) -> Option<IntegerLiteralInput> {
  let mut value = unparen(node)
  let mut negative = false
  if value.kind == "expression/unary" {
    let op = literalAttribute(value, "operator")
    if op != "minus" && op != "plus" { return None }
    negative = op == "minus"
    if value.children.length != 1 { return None }
    value = unparen(value.children[0])
  }
  if value.kind != "expression/integer" { return None }
  Some(IntegerLiteralInput { spelling: slice(source, value.lo, value.hi), negative: negative })
}

export record LiteralRange { lo: int, hi: int }
export record StringLayout { removed: Array<LiteralRange>, offending: Array<LiteralRange> }
export function stringLayout(bytes: Bytes, openingEnd: int, closing: int, lines: Array<int>) -> StringLayout {
  let mut removed: Array<LiteralRange> = []
  let mut offending: Array<LiteralRange> = []
  let openingBreak = if byteAt(bytes, openingEnd) == 13 && byteAt(bytes, openingEnd + 1) == 10 { 2 }
    else if byteAt(bytes, openingEnd) == 10 { 1 } else { 0 }
  if openingBreak > 0 { removed.push(LiteralRange { lo: openingEnd, hi: openingEnd + openingBreak }) }
  let mut closeLine = closing
  while closeLine > 0 && byteAt(bytes, closeLine - 1) != 10 { closeLine -= 1 }
  let indent = closing - closeLine
  let mut at = closeLine
  while at < closing {
    let b = byteAt(bytes, at)
    if b != 32 && b != 9 { return StringLayout { removed: removed, offending: offending } }
    at += 1
  }
  if indent > 0 { removed.push(LiteralRange { lo: closeLine, hi: closing }) }
  for line in lines {
    if line >= closeLine || line < openingEnd + openingBreak { continue }
    let mut end = line
    while end < closing && byteAt(bytes, end) != 10 { end += 1 }
    if end > line && byteAt(bytes, end - 1) == 13 { end -= 1 }
    let mut blank = true
    at = line
    while at < end {
      let b = byteAt(bytes, at)
      if b != 32 && b != 9 { blank = false }
      at += 1
    }
    if blank { continue }
    let mut matchesIndent = end - line >= indent
    at = 0
    while matchesIndent && at < indent {
      if byteAt(bytes, line + at) != byteAt(bytes, closeLine + at) { matchesIndent = false }
      at += 1
    }
    if matchesIndent {
      if indent > 0 { removed.push(LiteralRange { lo: line, hi: line + indent }) }
    } else { offending.push(LiteralRange { lo: line, hi: end }) }
  }
  StringLayout { removed: removed, offending: offending }
}
function removedEnd(layout: StringLayout, at: int) -> int {
  for run in layout.removed { if run.lo <= at && at < run.hi { return run.hi } }
  at
}
function textAttribute(name: string, value: string) -> PreviewAstAttribute {
  PreviewAstAttribute { name: name, kind: "string", value: value }
}
export function cookStringParts(bytes: Bytes, openingEnd: int, closing: int, multiline: bool, parts: Array<SyntaxNode>) -> Array<SyntaxNode> {
  let mut lines: Array<int> = []
  if multiline {
    if byteAt(bytes, openingEnd) != 10 && !(byteAt(bytes, openingEnd) == 13 && byteAt(bytes, openingEnd + 1) == 10) { lines.push(openingEnd) }
    for part in parts {
      if part.kind != "string-part/text" { continue }
      let mut at = part.lo
      while at < part.hi {
        if byteAt(bytes, at) == 10 { lines.push(at + 1) }
        at += 1
      }
    }
    ()
  }
  let layout = if multiline { stringLayout(bytes, openingEnd, closing, lines) } else { StringLayout { removed: [], offending: [] } }
  let mut result: Array<SyntaxNode> = []
  for part in parts {
    if part.kind != "string-part/text" { result.push(part); continue }
    let mut out: Array<string> = []
    let mut runs: Array<string> = []
    let mut offset = 0
    let mut at = part.lo
    while at < part.hi {
      let start = at
      let removed = removedEnd(layout, at).atMost(part.hi)
      if removed > at {
        runs.push("{offset}:{offset}:{at}:{removed}")
        at = removed
        continue
      }
      let b = byteAt(bytes, at)
      let mut value = ""
      if multiline && b == 13 && byteAt(bytes, at + 1) == 10 {
        value = "\n"; at += 2
      } else if b == 92 {
        at += 1
        if at < part.hi {
          let escaped = byteAt(bytes, at)
          let width = if escaped < 128 { 1 } else if escaped < 224 { 2 } else if escaped < 240 { 3 } else { 4 }
          value = escapeValue(bytes, at, width)
          at += width
        }
      } else {
        let width = if b < 128 { 1 } else if b < 224 { 2 } else if b < 240 { 3 } else { 4 }
        at += width
        value = slice(bytes, start, at)
      }
      out.push(value)
      let end = offset + value.encodeUtf8().length()
      runs.push("{offset}:{end}:{start}:{at}")
      offset = end
    }
    result.push(SyntaxNode {
      kind: part.kind, lo: part.lo, hi: part.hi, field: part.field, index: part.index,
      attributes: [textAttribute("cooked", out.join("")), textAttribute("sourceMap", runs.join(";"))], children: part.children,
    })
  }
  result
}
