      "comparison": [
        "operation-identity",
        "operand-order",
        "capture-identity"
      ]
    },
    {
      "id": "checker-rejection",
      "input": "focused current-language type mismatch",
      "disposition": "rejected",
      "comparison": [
        "status",
        "empty-lowered-ir",
        "provenance"
      ]
    },
    {
      "id": "exact-compiler-source",
      "input": "embedded compiler source manifest",
      "disposition": "admitted-generation-input",
