let 이름 = "김토파즈"

function 섀도잉예제() {
    let 이름 = "박개발자"        // 전역 이름을 가림 (섀도잉)
    print("함수 내: {이름}")     // "함수 내: 박개발자"
    
    {
        let 이름 = "이디자이너"   // 함수의 이름을 가림
        print("블록 내: {이름}")  // "블록 내: 이디자이너"
    }
    
    print("블록 후: {이름}")     // "블록 후: 박개발자"
}

print("전역: {이름}")           // "전역: 김토파즈"
섀도잉예제()
