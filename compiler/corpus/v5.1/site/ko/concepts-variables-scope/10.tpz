function 카운터생성기(초기값: int) -> () -> int {
    let mut 개수 = 초기값           // 클로저에 캡처됨
    
    return () => {
        개수 += 1               // 상위 스코프의 변수 접근
        개수
    }
}

let 카운터1 = 카운터생성기(0)
let 카운터2 = 카운터생성기(100)

print("{카운터1()}")  // 1
print("{카운터1()}")  // 2
print("{카운터2()}")  // 101
print("{카운터1()}")  // 3
