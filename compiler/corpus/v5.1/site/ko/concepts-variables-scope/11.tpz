let 사용자 = {
    이름: "김토파즈",
    나이: 28,
    직업: "개발자"
}

// 구조 분해로 새 변수 생성
let { 이름, 나이 } = 사용자
print("이름: {이름}, 나이: {나이}")

// match에서 변수 바인딩
match 사용자.나이 {
    case 나이 if 나이 < 20 => print("학생일 가능성이 높음")
    case 나이 if 나이 < 30 => print("청년층")
    case 나이 => print("경력자: {나이}세")
}

// 배열 패턴 매칭
let 점수들 = [95, 87, 92, 88]
match 점수들 {
    case [첫번째, 두번째, ..나머지] => {
        print("첫 번째: {첫번째}")
        print("두 번째: {두번째}")
        print("나머지: {나머지}")
    }
    case _ => print("점수가 두 개 이상 필요합니다")
}
