// 타입 추론 (권장)
let 자동추론숫자 = 42           // int
let 자동추론문자열 = "Hello"     // string
let 자동추론배열 = [1, 2, 3]    // Array<int>

// 명시적 타입 (필요할 때)
let 명시적숫자: int = 42
let 명시적문자열: string = "Hello"
let 명시적배열: Array<int> = [1, 2, 3]

// 복잡한 경우 타입 명시가 도움됨
let 사용자데이터: { 이름: string, 나이: int } = {
    이름: "김개발자",
    나이: 30
}
