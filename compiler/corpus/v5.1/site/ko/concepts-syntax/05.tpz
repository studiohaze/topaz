// 기본 매칭
let 결과 = match 값 {
    case 1 => "하나"
    case 2 => "둘"
    case 3 => "셋"
    case _ => "기타"
}

// 범위 매칭
let 등급 = match 점수 {
    case 90..100 => "A"
    case 80..<90 => "B"
    case 70..<80 => "C"
    case _ => "F"
}

// 구조 매칭
let 할인율 = match 고객 {
    case { 등급: "VIP", 구매액 } if 구매액 > 1000000 => 0.3
    case { 등급: "VIP" } => 0.2
    case { 가입연수 } if 가입연수 > 1 => 0.1
    case _ => 0.0
}
