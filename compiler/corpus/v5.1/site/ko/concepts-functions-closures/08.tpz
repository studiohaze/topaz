// 함수 팩토리
function 곱셈기만들기(배수: int) -> (int) -> int {
    return (x: int) => x * 배수
}

let 두배만들기 = 곱셈기만들기(2)
let 세배만들기 = 곱셈기만들기(3)

print("{두배만들기(5)}")  // 10
print("{세배만들기(4)}")  // 12

// 설정 가능한 검증 함수
function 범위검사기만들기(최소: int, 최대: int) -> (int) -> bool {
    return (값: int) => 값 >= 최소 && 값 <= 최대
}

let 성인나이검사 = 범위검사기만들기(18, 65)
let 학생나이검사 = 범위검사기만들기(5, 18)

print("{성인나이검사(25)}")  // true
print("{학생나이검사(16)}")  // true
print("{학생나이검사(25)}")  // false
