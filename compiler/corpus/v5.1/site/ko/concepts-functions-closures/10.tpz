function 카운터만들기(초기값: int) -> () -> int {
    let mut 카운트 = 초기값  // 클로저에 의해 캡처됨
    
    return () => {
        카운트 += 1      // 외부 변수에 접근
        카운트
    }
}

let 카운터1 = 카운터만들기(0)
let 카운터2 = 카운터만들기(100)

print("{카운터1()}")  // 1
print("{카운터1()}")  // 2
print("{카운터2()}")  // 101
print("{카운터1()}")  // 3
