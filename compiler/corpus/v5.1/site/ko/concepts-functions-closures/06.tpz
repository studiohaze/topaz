let 숫자들 = [1, 2, 3, 4, 5]

// map 변환
let 제곱들 = map(숫자들, x => x * x)
print("{제곱들}")  // [1, 4, 9, 16, 25]

// filter 필터링
let 짝수들 = filter(숫자들, x => x % 2 == 0)
print("{짝수들}")  // [2, 4]

// reduce 축약 (초기값이 reducer보다 앞에 옵니다)
let 합계 = reduce(숫자들, 0, (누적, 현재) => 누적 + 현재)
print("{합계}")   // 15

// 복잡한 체이닝
let 결과 = 숫자들
    |> filter(_, x => x > 2)
    |> map(_, x => x * 3)
    |> reduce(_, 0, (a, b) => a + b)
print("{결과}")   // (3 + 4 + 5) * 3 = 36
