// 조기 반환으로 깊은 중첩 방지
function 사용자등록(데이터: { 이름: string, 이메일: string, 나이: int }) -> Result<string, string> {
    // 조기 검증
    if 데이터.이름 == "" {
        return Err("이름이 필요합니다")
    }
    
    if !데이터.이메일.contains("@") {
        return Err("유효한 이메일이 필요합니다")
    }
    
    if 데이터.나이 < 0 {
        return Err("유효한 나이가 필요합니다")
    }
    
    // 모든 검증 통과 후 처리
    let 사용자 = 사용자생성(데이터)?
    let 아이디 = 데이터베이스저장(사용자)?
    
    return Ok("사용자 등록 완료: {아이디}")
}
