// match로 값 변환
let 결과 = match 사용자찾기(1) {
    case Some(사용자) => Some("안녕하세요, {사용자.이름}님!")
    case None => None
}

match 결과 {
    case Some(인사) => print(인사)
    case None => print("사용자를 찾을 수 없습니다")
}

// 중첩 match로 Option 연쇄 처리
function 성인확인(사용자: { 이름: string, 나이: int }) -> Option<string> {
    if 사용자.나이 >= 18 {
        return Some(사용자.이름)
    }
    return None
}

let 성인사용자 = match 사용자찾기(1) {
    case Some(사용자) => match 성인확인(사용자) {
        case Some(이름) => Some("{이름}님은 성인입니다")
        case None => None
    }
    case None => None
}

// match로 기본값 제공
let 사용자이름 = match 사용자찾기(999) {
    case Some(사용자) => 사용자.이름
    case None => "알 수 없는 사용자"
}

print("사용자 이름: {사용자이름}")  // "사용자 이름: 알 수 없는 사용자"

// match로 조건 필터링
let 젊은사용자 = match 사용자찾기(1) {
    case Some(사용자) => if 사용자.나이 < 30 { Some("{사용자.이름}님은 젊습니다") } else { None }
    case None => None
}
