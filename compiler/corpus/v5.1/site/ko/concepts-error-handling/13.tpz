// 컴파일러가 모든 케이스 처리를 강제함
type 네트워크에러종류 = "connection_failed" | "timeout" | "authentication_failed" | "server_error"
type 네트워크에러 = { 종류: 네트워크에러종류, 메시지: string, 코드: int | null }

function 네트워크요청처리(결과: Result<string, 네트워크에러>) -> string {
    match 결과 {
        case Ok(데이터) => "성공: {데이터}"
        case Err(에러) => match 에러.종류 {
            case "connection_failed" => "네트워크에 연결할 수 없습니다"
            case "timeout" => "요청이 시간 초과되었습니다"
            case "authentication_failed" => "인증이 필요합니다"
            case "server_error" => "서버 오류 (코드: {에러.코드})"
        }
    }
}
