// 기본 산술 연산자
let a = 10
let b = 3

let 더하기 = a + b        // 13
let 빼기 = a - b          // 7  
let 곱하기 = a * b        // 30
let 나누기 = a / b        // 3 — 정수 나눗셈은 0 방향으로 절단
let 나머지 = a % b        // 1
let 거듭제곱 = a ** b     // 1000

// float 산술은 float 도메인 안에서 (암묵적 혼합 없음)
let 비율 = 10.0 / 3.0     // 3.333...

print("더하기: {더하기}")
print("빼기: {빼기}")
print("곱하기: {곱하기}")
print("나누기: {나누기}")
print("나머지: {나머지}")
print("거듭제곱: {거듭제곱}")
