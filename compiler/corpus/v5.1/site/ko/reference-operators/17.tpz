// canonical 문서에서는 명시적 helper 함수로 연산 의미를 표현합니다
type 벡터 = { x: float, y: float }

function 벡터더하기(왼쪽: 벡터, 오른쪽: 벡터) -> 벡터 {
    return { x: 왼쪽.x + 오른쪽.x, y: 왼쪽.y + 오른쪽.y }
}

function 벡터스칼라곱(값: 벡터, 스칼라: float) -> 벡터 {
    return { x: 값.x * 스칼라, y: 값.y * 스칼라 }
}

function 벡터같은가(왼쪽: 벡터, 오른쪽: 벡터) -> bool {
    return 왼쪽.x == 오른쪽.x && 왼쪽.y == 오른쪽.y
}

function 벡터문자열(값: 벡터) -> string {
    return "벡터({값.x}, {값.y})"
}

// 사용 예제
let 벡터1: 벡터 = { x: 3.0, y: 4.0 }
let 벡터2: 벡터 = { x: 1.0, y: 2.0 }

let 합 = 벡터더하기(벡터1, 벡터2)      // 벡터(4.0, 6.0)
let 배수 = 벡터스칼라곱(벡터1, 2.0)    // 벡터(6.0, 8.0)
let 같은가 = 벡터같은가(벡터1, 벡터2)  // false

print("벡터 합: {벡터문자열(합)}")
print("벡터 배수: {벡터문자열(배수)}")
print("벡터 같음: {같은가}")
