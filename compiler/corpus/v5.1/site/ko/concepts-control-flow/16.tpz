let 작업목록 = [
    { 타입: "이메일", 우선순위: 1, 내용: "회의 일정 확인" },
    { 타입: "전화", 우선순위: 3, 내용: "고객 상담" },
    { 타입: "문서", 우선순위: 2, 내용: "보고서 작성" }
]

for 작업 in 작업목록 {
    match 작업 {
        case { 타입: "이메일", 우선순위: 1, 내용 } => {
            print("긴급 이메일 처리: {내용}")
        }
        case { 타입: 작업타입, 우선순위: 순위, 내용 } if 순위 <= 2 => {
            print("중요 {작업타입} 작업: {내용}")
        }
        case { 타입, 내용 } => {
            print("일반 {타입} 작업: {내용}")
        }
    }
}
