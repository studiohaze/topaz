let mut значение = 10

значение += 5     // значение = значение + 5 = 15
значение -= 3     // значение = значение - 3 = 12  
значение *= 2     // значение = значение * 2 = 24
значение /= 4     // значение = значение / 4 = 6
значение %= 4     // значение = значение % 4 = 2

print("Итоговое значение: {значение}")
