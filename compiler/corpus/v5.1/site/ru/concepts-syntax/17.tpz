// Базовые массивы
let числа = [1, 2, 3, 4, 5]
let фрукты = ["яблоко", "банан", "вишня"]

// Функциональные helper-имена
let большие = filter(числа, x => x > 2)                  // [3, 4, 5]
let квадраты = map(числа, x => x * x)                    // [1, 4, 9, 16, 25]
let сумма = reduce(числа, (acc, x) => acc + x, 0)        // 15
