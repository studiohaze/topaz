// Цикл for с диапазоном
for i in 0..5 {
    print("Итерация {i}")
}

// Включающий диапазон
for i in 1..10 {
    print("Число: {i}")
}

// Итерация по массиву
let фрукты = ["яблоко", "банан", "апельсин", "виноград"]
for фрукт in фрукты {
    print("Фрукт: {фрукт}")
}

// Итерация с шагом
for i in 0..20 by 2 {
    print("Четное: {i}")
}
