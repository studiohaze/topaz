// Использование if как выражения
let сообщение = if время < 12 {
    "Доброе утро!"
} else if время < 18 {
    "Добрый день!"
} else {
    "Добрый вечер!"
}

// Сложное условное вычисление
let стоимостьДоставки = if суммаЗаказа >= 50000 {
    0
} else if расстояние <= 10 {
    3000
} else {
    5000
}

print(сообщение)
print("Стоимость доставки: {стоимостьДоставки} рублей")
