// Record literal
let user = {
    name: "Alice",
    age: 25,
    email: "alice@example.com"
}

// Record type alias
type User = {
    name: string,
    age: int,
    email: string,
}

// Record value with an alias annotation
let newUser: User = {
    name: "Bob",
    age: 30,
    email: "bob@example.com",
}
