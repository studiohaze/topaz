// Arrays/Lists/Sets
let ok1 = 3 in [1, 2, 3]                  // true
let ok2 = "a" in Set.of("a", "b")        // true

// Map keys (via keys view)
let hasId = "id" in userMap.keys          // bool

// Ranges
let inside = 5 in 1..10                    // true
let outside = 10 in 1..<10                 // false
