let mut m: Map<string, int> = Map.new()
m.insert("a", 1)
m.insert("b", 2)
m.insert("a", 9)
print("{m.keys} {m.get("a") ?? 0}")
let mut s = Set.of(1, 2)
print("{s.add(2)} {s.remove(1)} {2 in s}")
print("{m.getOr("a", 0)} {m.getOr("zzz", 7)}")
print("{s.contains(2)} {s.contains(99)}")
print("{m.containsKey("a")} {m.containsKey("zzz")}")
print("{m.values} {m.length} {s.length}")
print("{m.entries}")
