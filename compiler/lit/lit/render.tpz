// Canonical guest-value, diagnostic, metrics, and protocol rendering.
// Machine and frontend records arrive fully decided; no evaluation or admission
// policy is introduced while producing the response text.

import lit.value_runtime {
  lowerHex,
  scalarText,
}
import lit.model {
  GuestInt,
  GuestRational,
  ErrorObjectRow,
  GuardClauseRow,
  GuestValue,
  RenderTask,
  ValuePacket,
  NodeOp,
  SpanRow,
  OriginRow,
  BinderRow,
  GlobalRow,
  NodeRow,
  Kernel,
  Request,
  FrontendRequest,
  SourceRequest,
  ScalarRow,
  FrontendToken,
  FrontendFault,
  TokenizedSource,
  ReaderOutput,
  NormalizeOutput,
  SourcePoint,
  NodeEncoding,
  MachineWarning,
  RunResult,
}
import lit.numeric {
  renderGuestInt,
  renderRational,
  renderReal,
}
import lit.normalize_core {
  h6CapabilityRowsJson,
  normalizeSource,
}
import lit.frontend_lex_read {
  tokenizeSource,
  readSourceIterative,
}

function renderGuestChar(scalar: int, display: bool) -> string {
  let text = scalarText(scalar)
  if display { return text }
  if scalar == 32 { return "#\\space" }
  if scalar == 10 { return "#\\newline" }
  if scalar == 9 { return "#\\tab" }
  if scalar == 13 { return "#\\return" }
  if scalar == 0 { return "#\\null" }
  if scalar < 32 || scalar == 127 { return "#\\x{lowerHex(scalar)}" }
  "#\\{text}"
}

function escapeGuestString(text: string) -> string {
  let mut output = ""
  for scalar in text.scalars() {
    if scalar == "\\" { output += "\\\\" }
    else if scalar == "\"" { output += "\\\"" }
    else if scalar == "\n" { output += "\\n" }
    else if scalar == "\r" { output += "\\r" }
    else if scalar == "\t" { output += "\\t" }
    else { output += scalar }
  }
  output
}

export function renderGuestMode(value: GuestValue, display: bool) -> string {
  let mut tasks: Array<RenderTask> = [RenderTask.RenderValueTask(value)]
  let mut activeVectors: Set<int> = Set.of<int>()
  let mut output = ""
  while tasks.length > 0 {
    let task = tasks[tasks.length - 1]
    tasks = tasks.slice(0, tasks.length - 1)
    match task {
      case RenderTextTask(text) => { output += text }
      case LeaveVectorTask(identity) => { activeVectors.remove(identity) }
      case RenderValueTask(current) => match current {
        case VBool(flag) => { output += if flag { "#t" } else { "#f" } }
        case VInt(number) => { output += renderGuestInt(number) }
        case VRational(number) => { output += renderRational(number) }
        case VReal(number) => { output += renderReal(number) }
        case VChar(scalar) => { output += renderGuestChar(scalar, display) }
        case VString(_, text) => {
          output += if display { text } else { "\"{escapeGuestString(text)}\"" }
        }
        case VSymbol(name) => { output += name }
        case VNil => { output += "()" }
        case VPair(_, _, _) => {
          let mut cars: Array<GuestValue> = []
          let mut cursor = current
          let mut terminal: Option<GuestValue> = None
          loop {
            match cursor {
              case VPair(_, car, cdr) => {
                cars.push(car)
                cursor = cdr
              }
              case VNil => { break }
              case _ => {
                terminal = Some(cursor)
                break
              }
            }
          }
          output += "("
          tasks.push(RenderTask.RenderTextTask(")"))
          match terminal {
            case Some(tail) => {
              tasks.push(RenderTask.RenderValueTask(tail))
              tasks.push(RenderTask.RenderTextTask(" . "))
            }
            case None => {}
          }
          let mut index = cars.length - 1
          while index >= 0 {
            tasks.push(RenderTask.RenderValueTask(cars[index]))
            if index > 0 { tasks.push(RenderTask.RenderTextTask(" ")) }
            index -= 1
          }
        }
        case VVector(identity, values, _) => {
          if identity in activeVectors {
            output += "#(...)"
          } else {
            activeVectors.add(identity)
            output += "#("
            tasks.push(RenderTask.RenderTextTask(")"))
            tasks.push(RenderTask.LeaveVectorTask(identity))
            let mut index = values.length - 1
            while index >= 0 {
              tasks.push(RenderTask.RenderValueTask(values[index]))
              if index > 0 { tasks.push(RenderTask.RenderTextTask(" ")) }
              index -= 1
            }
          }
        }
        case VBytevector(_, bytes) => {
          let mut parts: Array<string> = []
          for byte in bytes { parts.push("{byte}") }
          output += "#u8({parts.join(" ")})"
        }
        case VClosure(_) | VPrimitive(_) | VEscape(_) => { output += "#<procedure>" }
        case VError(_, _, _) => { output += "#<error-object>" }
        case VUninitialized => { output += "#<internal-uninitialized>" }
      }
    }
  }
  output
}

export function renderGuest(value: GuestValue) -> string {
  renderGuestMode(value, false)
}

export function escapeJson(text: string) -> string {
  let mut result = ""
  for scalar in text.scalars() {
    let codePoint = scalar.codePointAt(0) ?? -1
    if scalar == "\\" { result += "\\\\" }
    else if scalar == "\"" { result += "\\\"" }
    else if scalar == "\n" { result += "\\n" }
    else if scalar == "\r" { result += "\\r" }
    else if scalar == "\t" { result += "\\t" }
    else if codePoint >= 0 && codePoint < 32 {
      let hex = "0123456789abcdef".scalars()
      result += "\\u00{hex[codePoint / 16]}{hex[codePoint % 16]}"
    }
    else { result += scalar }
  }
  result
}

function renderEncodedGuest(value: GuestValue) -> string {
  let mut tasks: Array<RenderTask> = [RenderTask.RenderValueTask(value)]
  let mut activeVectors: Set<int> = Set.of<int>()
  let mut output = ""
  while tasks.length > 0 {
    let task = tasks[tasks.length - 1]
    tasks = tasks.slice(0, tasks.length - 1)
    match task {
      case RenderTextTask(text) => { output += text }
      case LeaveVectorTask(identity) => { activeVectors.remove(identity) }
      case RenderValueTask(current) => match current {
        case VBool(flag) => { output += "[\"bool\",{if flag { "true" } else { "false" }}]" }
        case VInt(number) => { output += "[\"int\",\"{renderGuestInt(number)}\"]" }
        case VRational(number) => { output += "[\"rational\",\"{renderRational(number)}\"]" }
        case VReal(number) => { output += "[\"real\",\"{renderReal(number)}\"]" }
        case VChar(scalar) => { output += "[\"char\",{scalar}]" }
        case VString(_, text) => { output += "[\"string\",\"{escapeJson(text)}\"]" }
        case VSymbol(name) => { output += "[\"symbol\",\"{escapeJson(name)}\"]" }
        case VNil => { output += "[\"nil\"]" }
        case VPair(_, car, cdr) => {
          output += "[\"pair\","
          tasks.push(RenderTask.RenderTextTask("]"))
          tasks.push(RenderTask.RenderValueTask(cdr))
          tasks.push(RenderTask.RenderTextTask(","))
          tasks.push(RenderTask.RenderValueTask(car))
        }
        case VVector(identity, values, _) => {
          if identity in activeVectors {
            output += "[\"cycle\",\"#(...)\"]"
          } else {
            activeVectors.add(identity)
            output += "[\"vector\",["
            tasks.push(RenderTask.RenderTextTask("]]"))
            tasks.push(RenderTask.LeaveVectorTask(identity))
            let mut index = values.length - 1
            while index >= 0 {
              tasks.push(RenderTask.RenderValueTask(values[index]))
              if index > 0 { tasks.push(RenderTask.RenderTextTask(",")) }
              index -= 1
            }
          }
        }
        case VBytevector(_, bytes) => {
          let mut encoded: Array<string> = []
          for byte in bytes { encoded.push("{byte}") }
          output += "[\"bytevector\",[{encoded.join(",")}]]"
        }
        case VClosure(_) | VPrimitive(_) | VEscape(_) => { output += "[\"procedure\"]" }
        case VError(_, error, _) => {
          output += "[\"error-object\",\"{escapeJson(error.code)}\",\"{escapeJson(error.message)}\"]"
        }
        case VUninitialized => { output += "[\"internal\",\"uninitialized\"]" }
      }
    }
  }
  output
}

function renderPacket(packet: ValuePacket) -> string {
  match packet {
    case One(value) => "[\"one\",{renderEncodedGuest(value)}]"
    case Many(values) => {
      let mut rendered: Array<string> = []
      for value in values { rendered.push(renderEncodedGuest(value)) }
      "[\"many\",[{rendered.join(",")}]]"
    }
  }
}

export function appendValuePacket(packets: Array<ValuePacket>, packet: ValuePacket) -> Array<ValuePacket> {
  let mut result: Array<ValuePacket> = []
  for prior in packets { result.push(prior) }
  result.push(packet)
  result
}

export function machineOriginStartByte(kernel: Kernel, origin: int) -> int {
  if origin < 0 || origin >= kernel.origins.length { return 0 }
  let mut cursor = origin
  let mut remaining = kernel.origins.length + 1
  while cursor >= 0 && cursor < kernel.origins.length && remaining > 0 {
    let row = kernel.origins[cursor]
    if row.span >= 0 && row.span < kernel.spans.length {
      return kernel.spans[row.span].startByte
    }
    cursor = row.parent
    remaining -= 1
  }
  0
}

export function machineNodeOrigin(kernel: Kernel, node: int) -> int {
  if node < 0 || node >= kernel.nodes.length { -1 } else { kernel.nodes[node].origin }
}

export function renderRunResult(invocationId: string, result: RunResult) -> string {
  let packet = match result.packet {
    case Some(value) => renderPacket(value)
    case None => "false"
  }
  let diagnostic = match result.diagnostic {
    case Some(value) => "\"{escapeJson(value)}\""
    case None => "false"
  }
  let exhausted = if result.exhausted { "true" } else { "false" }
  "[\"lispex.hosted-kernel-result/v0\",\"{escapeJson(invocationId)}\",\"{result.status}\",{packet},{diagnostic},{result.exitStatus},[],[[\"transition-limit\",{result.transitionLimit}],[\"transitions\",{result.transitions}],[\"exhausted\",{exhausted}],[\"max-continuation-depth\",{result.maxContinuationDepth}],[\"allocations\",{result.allocations}],[\"transfers\",{result.transfers}]]]"
}

export function renderDecodeError(error: string) -> string {
  "[\"lispex.lit-runner-result/v0\",\"\",\"\",\"invalid\",false,\"{escapeJson(error)}\",2,[],[],[]]"
}

function renderRunnerResources(request: Request) -> string {
  "[[\"transition-limit\",{request.transitionLimit}],[\"input-byte-limit\",{request.inputLimit}],[\"output-byte-limit\",{request.outputLimit}],[\"token-limit\",{request.tokenLimit}]]"
}

function renderRunnerIdentities(request: Request) -> string {
  "[[\"profile\",\"lispex-r7rs-small-pinned/v1.4\"],[\"logical-source-id\",\"{escapeJson(request.sourceId)}\"],[\"source-sha256\",\"{request.sourceSha}\"],[\"workload-sha256\",\"{request.workloadSha}\"],[\"lit-source-sha256\",\"{request.litSourceSha}\"],[\"capability-sha256\",\"{request.capabilitySha}\"],[\"isolation-profile\",\"fresh-process-per-request/v0\"]]"
}

export function renderRunnerResult(request: Request, nested: string) -> string {
  let resources = renderRunnerResources(request)
  let identities = renderRunnerIdentities(request)
  let normal = "[\"lispex.lit-runner-result/v0\",\"{escapeJson(request.invocationId)}\",\"{request.mode}\",\"executed\",{nested},false,0,[],{resources},{identities}]"
  if normal.byteLength() + 1 <= request.outputLimit { return normal }
  "[\"lispex.lit-runner-result/v0\",\"{escapeJson(request.invocationId)}\",\"{request.mode}\",\"resource\",false,\"LIT901 output byte limit exceeded\",2,[],{resources},{identities}]"
}

function renderFrontendRunnerResources(request: FrontendRequest) -> string {
  "[[\"transition-limit\",{request.transitionLimit}],[\"input-byte-limit\",{request.inputLimit}],[\"output-byte-limit\",{request.outputLimit}],[\"token-limit\",{request.tokenLimit}]]"
}

function renderFrontendRunnerIdentities(request: FrontendRequest) -> string {
  "[[\"profile\",\"lispex-r7rs-small-pinned/v1.4\"],[\"logical-source-id\",\"{escapeJson(request.sourceId)}\"],[\"source-sha256\",\"{request.sourceSha}\"],[\"workload-sha256\",\"{request.workloadSha}\"],[\"lit-source-sha256\",\"{request.litSourceSha}\"],[\"capability-sha256\",\"{request.capabilitySha}\"],[\"isolation-profile\",\"fresh-process-per-request/v0\"]]"
}

function renderIntVector(values: Array<int>) -> string {
  let mut rendered: Array<string> = []
  for value in values { rendered.push("{value}") }
  "[{rendered.join(",")}]"
}

function renderFrontendDiagnostic(request: FrontendRequest, fault: FrontendFault) -> string {
  "[\"lispex.hosted-diagnostic/v0\",\"{fault.code}\",\"{escapeJson(fault.templateId)}\",\"{escapeJson(fault.phase)}\",\"{escapeJson(request.sourceId)}\",[{fault.startByte},{fault.endByte}],[],[[\"message\",\"{escapeJson(fault.message)}\"]],false]"
}

function renderProjectionDiagnostic(request: FrontendRequest, fault: FrontendFault) -> string {
  "[\"lispex.lit-frontend-diagnostic/v0\",\"{fault.code}\",\"{escapeJson(fault.templateId)}\",\"{escapeJson(fault.phase)}\",\"{escapeJson(request.sourceId)}\",[{fault.startByte},{fault.endByte}],[],[[\"message\",\"{escapeJson(fault.message)}\"]],false]"
}

function renderFrontendTables(tokens: Array<FrontendToken>) -> Array<string> {
  let mut spans: Array<string> = []
  let mut origins: Array<string> = []
  let mut tokenRows: Array<string> = []
  let mut index = 0
  while index < tokens.length {
    let token = tokens[index]
    spans.push("[{index},{token.startByte},{token.endByte}]")
    origins.push("[{index},\"source\",{index},\"\",-1]")
    tokenRows.push("[{index},\"{token.kind}\",{index},{index},{renderIntVector(token.raw)}]")
    index += 1
  }
  ["[{spans.join(",")}]", "[{origins.join(",")}]", "[{tokenRows.join(",")}]"]
}

function renderHostedFrontendSuccess(request: FrontendRequest, tokenized: TokenizedSource) -> string {
  let tables = renderFrontendTables(tokenized.tokens)
  let metrics = "[[\"transition-limit\",{request.transitionLimit}],[\"transitions\",{tokenized.transitions}],[\"scalar-count\",{tokenized.scalars.length}],[\"token-count\",{tokenized.tokens.length}]]"
  "[\"lispex.hosted-frontend-result/v0\",\"{escapeJson(request.invocationId)}\",\"ok\",\"{escapeJson(request.sourceId)}\",\"{request.sourceSha}\",{request.sourceBytes.length},{renderIntVector(tokenized.newlineIndex)},{tables[0]},{tables[1]},{tables[2]},false,0,[],{metrics}]"
}

function renderHostedFrontendFault(request: FrontendRequest, fault: FrontendFault) -> string {
  let status = if fault.resource { "resource" } else { "error" }
  let exitStatus = if fault.resource { 2 } else { 1 }
  let diagnostic = renderFrontendDiagnostic(request, fault)
  let metrics = "[[\"transition-limit\",{request.transitionLimit}],[\"transitions\",0],[\"scalar-count\",0],[\"token-count\",0]]"
  "[\"lispex.hosted-frontend-result/v0\",\"{escapeJson(request.invocationId)}\",\"{status}\",\"{escapeJson(request.sourceId)}\",\"{request.sourceSha}\",{request.sourceBytes.length},[0],[],[],[],{diagnostic},{exitStatus},[],{metrics}]"
}

function renderGuardClauseRows(clauses: Array<GuardClauseRow>) -> string {
  let mut rows: Array<string> = []
  for clause in clauses { rows.push("[{clause.test},{clause.body}]") }
  "[{rows.join(",")}]"
}

function encodeNodeOp(op: NodeOp) -> NodeEncoding {
  match op {
    case Literal(quote) => NodeEncoding { opcode: "literal", a: "{quote}", b: "-1", c: "-1", d: "-1" }
    case LocalRef(binder, depth, slot) => NodeEncoding { opcode: "local-ref", a: "{binder}", b: "{depth}", c: "{slot}", d: "-1" }
    case GlobalRef(global, slot) => NodeEncoding { opcode: "global-ref", a: "{global}", b: "{slot}", c: "-1", d: "-1" }
    case Capability(capability) => NodeEncoding { opcode: "capability", a: "{capability}", b: "-1", c: "-1", d: "-1" }
    case IfNode(test, consequent, alternate) => NodeEncoding { opcode: "if", a: "{test}", b: "{consequent}", c: "{alternate}", d: "-1" }
    case Begin(children) => NodeEncoding { opcode: "begin", a: renderIntVector(children), b: "-1", c: "-1", d: "-1" }
    case Lambda(binders, body, rest) => NodeEncoding { opcode: "lambda", a: renderIntVector(binders), b: "{body}", c: "{rest}", d: "-1" }
    case Apply(operator, operands) => NodeEncoding { opcode: "app", a: "{operator}", b: renderIntVector(operands), c: "-1", d: "-1" }
    case SetLocal(binder, depth, slot, rhs) => NodeEncoding { opcode: "set-local", a: "{binder}", b: "{depth}", c: "{slot}", d: "{rhs}" }
    case SetGlobal(global, slot, rhs) => NodeEncoding { opcode: "set-global", a: "{global}", b: "{slot}", c: "{rhs}", d: "-1" }
    case Letrec(binders, initializers, body) => NodeEncoding { opcode: "letrec", a: renderIntVector(binders), b: renderIntVector(initializers), c: "{body}", d: "-1" }
    case GuardNode(binders, clauses, elseNode, body) => NodeEncoding { opcode: "guard", a: renderIntVector(binders), b: renderGuardClauseRows(clauses), c: "{elseNode}", d: "{body}" }
  }
}

function renderProjectedKernel(kernel: Kernel) -> string {
  let mut spans: Array<string> = []
  let mut index = 0
  while index < kernel.spans.length {
    let span = kernel.spans[index]
    spans.push("[{index},{span.startByte},{span.endByte}]")
    index += 1
  }
  let mut origins: Array<string> = []
  index = 0
  while index < kernel.origins.length {
    let origin = kernel.origins[index]
    origins.push("[{index},\"{origin.kind}\",{origin.span},\"{escapeJson(origin.rule)}\",{origin.parent}]")
    index += 1
  }
  let mut binders: Array<string> = []
  index = 0
  while index < kernel.binders.length {
    let binder = kernel.binders[index]
    binders.push("[{index},\"{escapeJson(binder.name)}\",{binder.owner},{binder.slot},{binder.origin}]")
    index += 1
  }
  let mut globals: Array<string> = []
  index = 0
  while index < kernel.globals.length {
    let global = kernel.globals[index]
    globals.push("[{index},\"{escapeJson(global.name)}\",{global.slot},{global.origin},{global.capability}]")
    index += 1
  }
  let mut nodes: Array<string> = []
  index = 0
  while index < kernel.nodes.length {
    let node = kernel.nodes[index]
    let encoded = encodeNodeOp(node.op)
    nodes.push("[{index},\"{encoded.opcode}\",{node.span},{node.origin},{encoded.a},{encoded.b},{encoded.c},{encoded.d}]")
    index += 1
  }
  let mut quotes: Array<string> = []
  index = 0
  while index < kernel.quotes.length {
    quotes.push("[{index},{renderEncodedGuest(kernel.quotes[index])}]")
    index += 1
  }
  let capabilityRows = if kernel.feature == "hosted-kernel-h6/v0" { h6CapabilityRowsJson() } else { h4CapabilityRowsJson() }
  "[\"lispex.hosted-kernel/v0\",\"lispex-r7rs-small-pinned/v1.4\",\"{kernel.feature}\",\"{escapeJson(kernel.sourceId)}\",\"{kernel.sourceSha}\",[{spans.join(",")}],[{origins.join(",")}],[{binders.join(",")}],[{globals.join(",")}],{renderIntVector(kernel.roots)},[{nodes.join(",")}],[{quotes.join(",")}],{capabilityRows}]"
}

function h4CapabilityRowsJson() -> string {
