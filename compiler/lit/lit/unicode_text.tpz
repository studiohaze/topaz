// END GENERATED LIT UNICODE CASE DATA

function unicodeCaseMappingV16(
  scalar: int,
  keys: Array<int>,
  offsets: Array<int>,
  values: Array<int>,
) -> Array<int> {
  let mut low = 0
  let mut high = keys.length
  while low < high {
    let middle = (low + high) / 2
    if keys[middle] < scalar { low = middle + 1 } else { high = middle }
  }
  if low >= keys.length || keys[low] != scalar { return [scalar] }
  values.slice(offsets[low], offsets[low + 1])
}

function unicodeUpperMappingV16(scalar: int) -> Array<int> {
  unicodeCaseMappingV16(scalar, unicodeUpperKeysV16(), unicodeUpperOffsetsV16(), unicodeUpperValuesV16())
}

function unicodeLowerMappingV16(scalar: int) -> Array<int> {
  unicodeCaseMappingV16(scalar, unicodeLowerKeysV16(), unicodeLowerOffsetsV16(), unicodeLowerValuesV16())
}

export function unicodeUppercaseV16(scalar: int) -> bool {
  scalarInRanges(scalar, unicodeUppercaseRangesV16())
}

export function unicodeLowercaseV16(scalar: int) -> bool {
  scalarInRanges(scalar, unicodeLowercaseRangesV16())
}

function unicodeCasedV16(scalar: int) -> bool {
  scalarInRanges(scalar, unicodeCasedRangesV16())
}

function unicodeCaseIgnorableV16(scalar: int) -> bool {
  scalarInRanges(scalar, unicodeCaseIgnorableRangesV16())
}

export function unicodeSimpleUpperV16(scalar: int) -> int {
  let mapped = unicodeUpperMappingV16(scalar)
  if mapped.length == 1 { mapped[0] } else { scalar }
}

export function unicodeSimpleLowerV16(scalar: int) -> int {
  if scalar == 304 { return 105 }
  let mapped = unicodeLowerMappingV16(scalar)
  if mapped.length == 1 { mapped[0] } else { scalar }
}

function appendMappedScalars(output: string, mapped: Array<int>) -> string {
  let mut result = output
  for scalar in mapped { result += scalarText(scalar) }
  result
}

export function unicodeUpperTextV16(text: string) -> string {
  let mut output = ""
  for scalarTextValue in text.scalars() {
    let scalar = scalarTextValue.codePointAt(0) ?? 0
    output = appendMappedScalars(output, unicodeUpperMappingV16(scalar))
  }
  output
}

export function unicodeLowerTextV16(text: string) -> string {
  let scalars = text.scalars()
  let mut codes: Array<int> = []
  for scalarTextValue in scalars { codes.push(scalarTextValue.codePointAt(0) ?? 0) }
  let mut output = ""
  let mut index = 0
  while index < codes.length {
    let scalar = codes[index]
    if scalar == 931 {
      let mut before = false
      let mut prior = index - 1
      while prior >= 0 {
        if unicodeCaseIgnorableV16(codes[prior]) { prior -= 1 }
        else {
          before = unicodeCasedV16(codes[prior])
          break
        }
      }
      let mut after = false
      let mut next = index + 1
      while next < codes.length {
        if unicodeCaseIgnorableV16(codes[next]) { next += 1 }
        else {
          after = unicodeCasedV16(codes[next])
          break
        }
      }
      output += scalarText(if before && !after { 962 } else { 963 })
    } else {
      output = appendMappedScalars(output, unicodeLowerMappingV16(scalar))
    }
    index += 1
  }
  output
}

function scalarLexCompare(left: string, right: string) -> int {
  let leftScalars = left.scalars()
  let rightScalars = right.scalars()
  let mut index = 0
  while index < leftScalars.length && index < rightScalars.length {
    let leftCode = leftScalars[index].codePointAt(0) ?? 0
    let rightCode = rightScalars[index].codePointAt(0) ?? 0
    if leftCode < rightCode { return -1 }
    if leftCode > rightCode { return 1 }
    index += 1
  }
  if leftScalars.length < rightScalars.length { -1 }
  else if leftScalars.length > rightScalars.length { 1 }
  else { 0 }
}

function comparisonRelation(name: string, comparison: int) -> bool {
  if name.contains("<=?") { return comparison <= 0 }
  if name.contains(">=?") { return comparison >= 0 }
  if name.contains("<?") { return comparison < 0 }
  if name.contains(">?") { return comparison > 0 }
  comparison == 0
}

export function guestCharacterComparison(name: string, arguments: Array<GuestValue>) -> Result<GuestValue, string> {
  requireArity(name, arguments.length, 2, -1)?
  let mut values: Array<int> = []
  for argument in arguments {
    match argument {
      case VChar(scalar) => {
        values.push(if name.startsWith("char-ci") { unicodeSimpleLowerV16(scalar) } else { scalar })
      }
      case _ => return Err("E312 {name}: expected a character, got {renderGuest(argument)}")
    }
  }
  let mut answer = true
  let mut index = 1
  while index < values.length {
    let comparison = if values[index - 1] < values[index] { -1 }
      else if values[index - 1] > values[index] { 1 }
      else { 0 }
    if !comparisonRelation(name, comparison) { answer = false }
    index += 1
  }
  Ok(GuestValue.VBool(answer))
}

export function guestStringComparison(name: string, arguments: Array<GuestValue>) -> Result<GuestValue, string> {
  requireArity(name, arguments.length, 2, -1)?
  let mut values: Array<string> = []
  for argument in arguments {
    match argument {
      case VString(_, text) => {
        values.push(if name.startsWith("string-ci") { unicodeLowerTextV16(text) } else { text })
      }
      case _ => return Err("E312 {name}: expected a string, got {renderGuest(argument)}")
    }
  }
  let mut answer = true
  let mut index = 1
  while index < values.length {
    if !comparisonRelation(name, scalarLexCompare(values[index - 1], values[index])) { answer = false }
    index += 1
  }
  Ok(GuestValue.VBool(answer))
}

export function guestHomogeneousEquality(name: string, arguments: Array<GuestValue>) -> Result<GuestValue, string> {
  requireArity(name, arguments.length, 2, -1)?
  let mut answer = true
  let mut index = 0
  while index < arguments.length {
    if name == "boolean=?" {
      match arguments[index] {
        case VBool(value) => if index > 0 { match arguments[index - 1] {
          case VBool(prior) => if value != prior { answer = false }
          case _ => {}
        }}
        case _ => return Err("E312 boolean=?: expected a boolean, got {renderGuest(arguments[index])}")
      }
    } else {
      match arguments[index] {
        case VSymbol(value) => if index > 0 { match arguments[index - 1] {
          case VSymbol(prior) => if value != prior { answer = false }
          case _ => {}
        }}
        case _ => return Err("E312 symbol=?: expected a symbol, got {renderGuest(arguments[index])}")
      }
    }
    index += 1
  }
  Ok(GuestValue.VBool(answer))
}

export function guestStringRange(
  name: string,
  arguments: Array<GuestValue>,
  length: int,
) -> Result<Array<int>, string> {
  let start = if arguments.length >= 2 { primitiveIndex(arguments[1], name, "E311")? } else { 0 }
  let end = if arguments.length >= 3 { primitiveIndex(arguments[2], name, "E311")? } else { length }
  if start > length { return Err("E311 {name}: start {start} out of range (length {length})") }
  if end > length { return Err("E311 {name}: end {end} out of range (length {length})") }
  if start > end { return Err("E311 {name}: start {start} is past end {end}") }
  Ok([start, end])
}

export function guestStringSlice(text: string, start: int, end: int, name: string, code: string) -> Result<string, string> {
  let scalars = text.scalars()
  if start < 0 || end < start || end > scalars.length {
    return Err("{code} {name}: invalid character range")
  }
  Ok(scalars.slice(start, end).join(""))
}

export function primitiveIndex(value: GuestValue, name: string, code: string) -> Result<int, string> {
  match value {
    case VInt(number) => match toInt(renderGuestInt(number)) {
      case Some(index) => if index >= 0 { Ok(index) } else { Err("{code} {name}: index must be nonnegative") }
      case None => Err("{code} {name}: index out of range")
    }
    case _ => Err("{code} {name}: exact nonnegative integer required")
  }
}

export function stringFromGuestChars(value: GuestValue, identities: Array<int>) -> Result<GuestValue, string> {
  let elements = guestListElements(value, "list->string", "HK284")?
  let mut text = ""
  for element in elements {
    match element {
      case VChar(scalar) => { text += scalarText(scalar) }
      case _ => return Err("HK284 list->string: list of characters required")
    }
  }
  Ok(GuestValue.VString(allocateGuestIdentity(identities), text))
}

export function guestCharsFromString(text: string, identities: Array<int>) -> GuestValue {
  let mut values: Array<GuestValue> = []
  for scalar in text.scalars() {
    values.push(GuestValue.VChar(scalar.codePointAt(0) ?? 0))
  }
  guestList(values, identities)
}
