function scalarInRanges(scalar: int, ranges: Array<int>) -> bool {
  let mut low = 0
  let mut high = ranges.length / 2
  while low < high {
    let middle = (low + high) / 2
    let start = ranges[middle * 2]
    let end = ranges[middle * 2 + 1]
    if scalar < start {
      high = middle
    } else if scalar > end {
      low = middle + 1
    } else {
      return true
    }
  }
  false
}

export function unicodeAlphabeticV16(scalar: int) -> bool {
  scalarInRanges(scalar, unicodeAlphabeticRangesV16())
}

export function asciiDecimalScalar(scalar: int) -> bool {
  scalar >= 48 && scalar <= 57
}

function asciiFoldScalar(scalar: int) -> int {
  if scalar >= 65 && scalar <= 90 { scalar + 32 } else { scalar }
}

function foldedAsciiText(text: string) -> string {
  let mut output = ""
  for scalar in text.scalars() {
    let code = scalar.codePointAt(0) ?? 0
    output += scalarText(asciiFoldScalar(code))
  }
  output
}

