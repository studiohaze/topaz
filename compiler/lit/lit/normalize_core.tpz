// Iterative normalization from reader datums to executable kernel tables.
// Capability accounting and lexical addressing are settled here; the machine
// receives a closed Kernel rather than source or reader state.

import lit.model {
  GuestInt,
  GuestRational,
  ErrorObjectRow,
  GuardClauseRow,
  GuestValue,
  NodeOp,
  SpanRow,
  OriginRow,
  BinderRow,
  GlobalRow,
  NodeRow,
  Kernel,
  CapabilityTable,
  FrontendRequest,
  FrontendFault,
  ReaderDatumKind,
  ReaderDatum,
  ReaderOutput,
  LexicalFrame,
  LexicalAddress,
  ParsedFormals,
  ParsedBinding,
  NormalizeArena,
  NormalizeOutput,
  QuasiquotePart,
  NodeLocation,
  DefinitionShape,
}
import lit.frontend_lex_read {
  frontendFault,
  projectFrontendFault,
  chargeFrontend,
  addReaderDatum,
  listDatumIds,
  datumSymbol,
}
import lit.kernel_decode {
  expectArray,
  expectString,
  expectInt,
  expectBool,
  requireLength,
  copyInts,
  validateReferences,
}
import lit.value_runtime {
  allocateGuestIdentity,
}

function normalizeFault(arena: NormalizeArena, datum: int, code: string, templateId: string, message: string) -> FrontendFault {
  let start = if datum >= 0 && datum < arena.datums.length { arena.datums[datum].startByte } else { 0 }
  let end = if datum >= 0 && datum < arena.datums.length { arena.datums[datum].endByte } else { start }
  frontendFault(code, templateId, "normalize", start, end, message, false)
}

function projectedNormalizeFault(
  arena: NormalizeArena,
  datum: int,
  code: string,
  templateId: string,
  message: string,
  diagnosticCode: string,
  diagnosticPhase: string,
  diagnosticMessage: string,
) -> FrontendFault {
  let fault = normalizeFault(arena, datum, code, templateId, message)
  projectFrontendFault(fault, diagnosticCode, diagnosticPhase, diagnosticMessage, fault.startByte)
}

function reservedBinderFault(arena: NormalizeArena, datum: int, name: string, message: string) -> FrontendFault {
  projectedNormalizeFault(
    arena,
    datum,
    "LIT443",
    "reserved-binder",
    message,
    "E110",
    "normalizer",
    "cannot bind reserved word `{name}`",
  )
}

function chargeNormalize(arena: NormalizeArena, datum: int, amount: int) -> Result<(), FrontendFault> {
  let start = if datum >= 0 && datum < arena.datums.length { arena.datums[datum].startByte } else { 0 }
  let end = if datum >= 0 && datum < arena.datums.length { arena.datums[datum].endByte } else { start }
  chargeFrontend(arena.transitions, amount, arena.transitionLimit, "normalize", start, end)
}

function h4CapabilityNames() -> Array<string> {
  [
    "+", "-", "=", "cons", "null?", "values", "call-with-values", "apply", "vector-ref", "vector-set!",
    "call/cc", "dynamic-wind", "with-exception-handler", "raise", "raise-continuable", "error",
    "error-object?", "error-object-message", "error-object-irritants", "*", "/", "<", ">", "<=", ">=",
    "pair?", "car", "cdr", "list", "list?", "length", "append", "reverse", "eqv?", "eq?", "equal?",
    "not", "number?", "integer?", "exact-integer?", "boolean?", "symbol?", "string?", "procedure?",
    "vector?", "bytevector?", "make-vector", "vector", "vector-length", "vector->list", "list->vector",
    "make-bytevector", "bytevector", "bytevector-length", "bytevector-u8-ref", "string-append", "string-length",
    "string-ref", "string->symbol", "symbol->string", "char?", "char->integer", "integer->char", "number->string",
    "string->number", "display", "write", "newline", "println", "map", "for-each", "vector-map",
    "vector-for-each", "string-map", "string-for-each", "filter", "fold-left", "fold-right", "member", "assoc",
  ]
}

function h4CapabilityDispositions() -> Array<string> {
  let mut dispositions: Array<string> = []
  let mut index = 0
  while index < 80 {
    dispositions.push(if index >= 65 { "unsupported-loud" } else { "supported" })
    index += 1
  }
  dispositions
}

