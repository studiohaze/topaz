-host\",\"hosted-h6-source-candidate-v0\",1,\"unsupported-loud\",\"truncate-quotient\"],[189,\"truncate-remainder\",\"runtime/truncate-remainder\",\"native-profile-pinned\",[\"native-profile-pinned\"],\"native-profile-pinned\",\"native-profile-pinned\",[\"H6-unsupported-loud\"],\"deterministic-pinned\",false,\"unsupported\",\"native-and-wasm-reference-host\",\"hosted-h6-source-candidate-v0\",1,\"unsupported-loud\",\"truncate-remainder\"],[190,\"truncate/\",\"runtime/truncate/\",\"native-profile-pinned\",[\"native-profile-pinned\"],\"native-profile-pinned\",\"native-profile-pinned\",[\"H6-unsupported-loud\"],\"deterministic-pinned\",false,\"unsupported\",\"native-and-wasm-reference-host\",\"hosted-h6-source-candidate-v0\",1,\"unsupported-loud\",\"truncate/\"],[191,\"values\",\"control/values\",\"0+\",[\"value...\"],\"value-packet\",\"any-values\",[],\"deterministic-pinned\",false,\"linear-arguments\",\"native-and-wasm-reference-host\",\"hosted-h6-source-candidate-v0\",1,\"hosted-implemented\",\"values\"],[192,\"vector\",\"aggregate/vector\",\"0+\",[\"value...\"],\"mutable-vector\",\"exactly-one\",[],\"deterministic-pinned\",false,\"linear-arguments\",\"native-and-wasm-reference-host\",\"hosted-h6-source-candidate-v0\",1,\"hosted-implemented\",\"vector\"],[193,\"vector->list\",\"aggregate/vector-to-list\",\"1\",[\"vector\"],\"list\",\"exactly-one\",[\"HK263\"],\"deterministic-pinned\",false,\"linear-size\",\"native-and-wasm-reference-host\",\"hosted-h6-source-candidate-v0\",1,\"hosted-implemented\",\"vector->list\"],[194,\"vector->string\",\"runtime/vector->string\",\"native-profile-pinned\",[\"native-profile-pinned\"],\"native-profile-pinned\",\"native-profile-pinned\",[\"H6-unsupported-loud\"],\"deterministic-pinned\",false,\"unsupported\",\"native-and-wasm-reference-host\",\"hosted-h6-source-candidate-v0\",1,\"unsupported-loud\",\"vector->string\"],[195,\"vector-copy\",\"aggregate/vector-copy\",\"1-3\",[\"vector\",\"optional-nonnegative-integer\",\"optional-nonnega