// 초성 추출기. 각 한글 음절에서 첫 자음(초성)을 뽑아낸다. Topaz로 작성.
// 한글 음절 U+AC00..U+D7A3 은 초성 = (코드포인트 - 0xAC00) / 588 로 표현된다. 한글이 아닌 스칼라
// (공백, 문장부호, 영어, 이모지, 낱자 자모)는 그대로 통과한다. 각 스칼라의 코드포인트가
// 필요하다. 이 앱이 Topaz에 도입시킨 기본 연산 `str.codePointAt(i)` 를 쓴다.
// 순수하며 결정적이다. 같은 텍스트는 인터프리터와 네이티브/wasm 빌드에서 같은 HTML을 낸다.

function 글자정리(글: string) -> string {
  if 글 == "&" { "&amp;" }
  else if 글 == "<" { "&lt;" }
  else if 글 == ">" { "&gt;" }
  else { 글 }
}

function 줄정리(줄: string) -> string {
  let mut 출력 = ""
  for 글 in 줄.scalars() {
    출력 = 출력 + 글자정리(글)
  }
  출력
}

function 초성변환(텍스트: string) -> string {
  let 초성표 = [
    "ㄱ", "ㄲ", "ㄴ", "ㄷ", "ㄸ", "ㄹ", "ㅁ", "ㅂ", "ㅃ", "ㅅ",
    "ㅆ", "ㅇ", "ㅈ", "ㅉ", "ㅊ", "ㅋ", "ㅌ", "ㅍ", "ㅎ",
  ]
  let 글자들 = 텍스트.scalars()
  let mut 결과 = ""
  let mut 색인 = 0
  while 색인 < 글자들.length {
    let 코드 = 텍스트.codePointAt(색인) ?? -1
    if 코드 >= 44032 && 코드 <= 55203 {
      // U+AC00..U+D7A3, 조합된 한글 음절
      결과 = 결과 + 초성표[(코드 - 44032) / 588]
    } else {
      결과 = 결과 + 글자들[색인]
    }
    색인 = 색인 + 1
  }
  결과
}

function 보기(텍스트: string) -> string {
  let 변환 = 초성변환(텍스트)
  // 입력 반향과 초성 줄 둘 다 사용자에게서 나온 값이다. 주입 전에 둘 다 HTML 이스케이프한다.
  let mut 결과 = "<div class=\"choseong\">"
  결과 = 결과 + "<div class=\"src\">" + 줄정리(텍스트) + "</div>"
  결과 = 결과 + "<div class=\"out\">" + 줄정리(변환) + "</div>"
  결과 + "</div>"
}

print(보기(input()))
