enum Form {
  Atom(string),
  List(Array<Form>),
}

function size(form: Form) -> int {
  match form {
    case Atom(_) => 1
    case List(items) => {
      let mut total = 1
      for item in items {
        total += size(item)
      }
      total
    }
  }
}

let form = Form.List([
  Form.Atom("define"),
  Form.List([Form.Atom("square"), Form.Atom("x")]),
  Form.List([Form.Atom("*"), Form.Atom("x"), Form.Atom("x")]),
])
print("recursive-size={size(form)}")
